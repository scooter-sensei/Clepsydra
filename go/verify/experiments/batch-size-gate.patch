+// batchGateBytes: on tables this small or smaller the batches skip warm
+// (lab E3: on the lab host warm's lookup pass cost 1.13-1.31x a plain loop
+// on tables of 256 KiB-2 MiB, and saved 0.92-0.40x from 4 MiB up).
+const batchGateBytes = 2 << 20
+
+// batchSmall reports whether the table is small enough that a batch runs
+// its keys one by one, without warm (ConstantTime keeps warm).
+func (f *Filter) batchSmall() bool { return !f.ct && len(f.words)*8 <= batchGateBytes }
+
 // batchChunk is how many keys warm overlaps (S48: 32 beat 64 on tables
 // near the last-level cache's size and matched it past them).
 const batchChunk = 32
