+// CheckAndTouchBatch on a 1 MiB table, one that fits the cache (lab E3).
+func BenchmarkCheckAndTouchBatchSmall(b *testing.B) {
+	const keys = 1 << 20 / 16 * 85 / 100
+	f, _ := New(Config{Capacity: keys, Horizon: time.Minute})
+	hs := make([]uint64, 32768)
+	for i := range hs {
+		hs[i] = mix64(uint64(i) + 77)
+		f.CheckAndTouchAt(hs[i], 0, 1000)
+	}
+	w := f.Ticks(30 * time.Second)
+	out := make([]bool, 64)
+	b.ResetTimer()
+	for i := 0; i < b.N; i += 64 {
+		lo := i & (len(hs) - 1)
+		f.CheckAndTouchBatch(hs[lo:lo+64], w, 2000+uint64(i>>10), out)
+	}
+}
