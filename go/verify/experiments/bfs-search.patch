+// bfsNode is a slot the BFS reached: its word index, the queue index of the
+// slot whose entry would move into its line (-1: a root), and its depth.
+type bfsNode struct {
+	i      int
+	parent int32
+	depth  int32
+}
+
+const bfsMax = wordsPerLine + wordsPerLine/2*relocBudget
+
+var bfsPool = sync.Pool{New: func() any { return new([bfsMax]bfsNode) }}
+
+// bfs searches for a cuckoo path breadth-first (lab E5): each entry's
+// alternate line is scanned once, one budget unit per line, up to depth
+// relocDepth below the roots (lines' slots). The first line with a free or
+// expired slot ends the search, and the path is executed back to front by
+// relocate along it; if a slot on it changed meanwhile the search goes on.
+// It returns the root slot the new entry took, or -1.
+func (f *Filter) bfs(lines, mine [2]uint64, w1, now uint64, budget *int, put putFunc) int {
+	qp := bfsPool.Get().(*[bfsMax]bfsNode)
+	defer bfsPool.Put(qp)
+	q := qp[:0]
+	for _, line := range lines {
+		base := int(line * wordsPerLine)
+		for s := 0; s < wordsPerLine; s += 2 {
+			q = append(q, bfsNode{i: base + s, parent: -1})
+		}
+	}
+	var path [relocDepth + 1]int
+	for h := 0; h < len(q) && *budget > 0; h++ {
+		n := q[h]
+		w0 := atomic.LoadUint64(&f.words[n.i])
+		if w0 == 0 {
+			continue
+		}
+		*budget--
+		a := f.alt(uint64(n.i/wordsPerLine), w0>>48)
+		base := int(a * wordsPerLine)
+		free := false
+		for s := 0; s < wordsPerLine; s += 2 {
+			if d0 := atomic.LoadUint64(&f.words[base+s]); d0 == 0 || age(now, d0&tsMask) > f.horizon {
+				free = true
+				break
+			}
+		}
+		if free {
+			k, x := int(n.depth), h
+			for j := k; j >= 0; j-- {
+				path[j] = q[x].i
+				if j > 0 {
+					x = int(q[x].parent)
+				}
+			}
+			root, li, big := path[0], x/(wordsPerLine/2), relocBudget
+			if f.relocate(root, uint64(root/wordsPerLine), mine[li], w1, now, k, &big, nil, put, path[1:k+1]) {
+				return root
+			}
+			continue
+		}
+		if int(n.depth) < relocDepth && len(q)+wordsPerLine/2 <= bfsMax {
+			for s := 0; s < wordsPerLine; s += 2 {
+				q = append(q, bfsNode{i: base + s, parent: int32(h), depth: n.depth + 1})
+			}
+		}
+	}
+	return -1
+}
