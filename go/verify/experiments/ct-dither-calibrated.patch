diff -ruN a/spin.go b/spin.go
--- a/spin.go	1970-01-01 00:00:00.000000000 +0000
+++ b/spin.go	2026-10-29 00:33:40.775759894 +0000
@@ -0,0 +1,56 @@
+package temporalfilter
+
+import (
+	"math/bits"
+	"sync"
+	"time"
+)
+
+// padDither is the span over which a ConstantTime pad's end is drawn where
+// the clock is fast: a mean cost of 64 ns per call.
+const padDither = 128 * time.Nanosecond
+
+// ditherMask draws a ConstantTime pad's random end (ctEnd): the end falls
+// uniformly over ditherMask+1 ns, padDither, or where an iteration of the
+// pad's spin takes more than a third of that, the power of two at or above
+// three iterations. A dither under one iteration ends the pad at the phase of
+// the reads again: a clock read costs ~566 ns under qemu-user and 0.5-1.5 µs
+// on VMs whose clock source is HPET or acpi_pm (an iteration, 37 ns on the
+// Ryzen host). The clock is the host's, so the first ConstantTime New
+// measures it for every filter (calibrateDither).
+var (
+	ditherMask = uint64(padDither - 1)
+	ditherOnce sync.Once
+)
+
+// initPads starts each kind of call's own-work estimate at autoStart and,
+// for the first ConstantTime filter, calibrates the dither. Out of New, so
+// New's code doesn't grow: the hot paths after it in the binary would move,
+// and their speed moves with their placement (claims S52).
+//
+//go:noinline
+func (f *Filter) initPads() {
+	for i := range f.padQ {
+		f.padQ[i].q.Store(int64(autoStart) * 1000)
+	}
+	if f.ct {
+		ditherOnce.Do(calibrateDither)
+	}
+}
+
+// calibrateDither sets ditherMask from the fastest of 8 timed runs of 32
+// iterations of the spin, so a preemption doesn't widen it.
+func calibrateDither() {
+	it := time.Duration(1<<63 - 1)
+	for range 8 {
+		t0 := time.Now()
+		n := 0
+		for n < 32 && time.Since(t0) >= 0 {
+			n++
+		}
+		it = min(it, time.Since(t0)/32)
+	}
+	if span := 3 * it; span > padDither {
+		ditherMask = 1<<bits.Len64(uint64(span-1)) - 1
+	}
+}
