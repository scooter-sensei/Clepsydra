new file mode 100755
index 0000000..6606295
--- /dev/null
+++ b/spin_test.go
@@ -0,0 +1,26 @@
+package temporalfilter
+
+import (
+	"math/rand/v2"
+	"testing"
+	"time"
+)
+
+// TestSpinPeriod (experiment): how long one iteration of ctEnd's spin takes
+// (a time.Since call and a compare), and a dither draw.
+func TestSpinPeriod(t *testing.T) {
+	for range 3 {
+		t0 := time.Now()
+		n := 0
+		for time.Since(t0) < 10*time.Millisecond {
+			n++
+		}
+		t.Logf("spin: %d iterations in 10 ms: %.1f ns each", n, 1e7/float64(n))
+	}
+	t0 := time.Now()
+	var s uint64
+	for range 10_000_000 {
+		s += rand.Uint64N(64)
+	}
+	t.Logf("rand.Uint64N: %.1f ns (%d)", float64(time.Since(t0).Nanoseconds())/1e7, s%2)
+}
