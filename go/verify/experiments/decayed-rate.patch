+package temporalfilter
+
+import (
+	"math"
+	"math/rand/v2"
+	"os"
+	"testing"
+	"time"
+)
+
+// TestDecayedRate (TF_EXP=1; NEXT-RESULTS.md N19): DecayedRateAt against
+// the exact EWMA on tfbench's velocity workload.
+func TestDecayedRate(t *testing.T) {
+	if os.Getenv("TF_EXP") == "" {
+		t.Skip("set TF_EXP=1")
+	}
+	taus := []float64{1_000, 5_000, 15_000, 60_000}
+	f, _ := New(Config{Capacity: 200_000, Horizon: time.Minute, Resolution: time.Millisecond})
+	hs := make([]uint64, 2000)
+	for k := range hs {
+		hs[k] = mix64(uint64(k) + 1<<50)
+	}
+	r := rand.New(rand.NewPCG(19, 19))
+	var errAll, exAll, errH, exH [4]float64
+	velWorkload(func(k int, tk uint64) { f.TouchAt(hs[k], 0, tk) }, func(k int, ts []uint64, _ int, now uint64) {
+		ti := r.IntN(len(taus))
+		tau := taus[ti]
+		all, hor := 0.0, 0.0
+		for i := len(ts) - 1; i >= 0; i-- {
+			d := math.Exp(-float64(now-ts[i]) / tau)
+			if d < 1e-12 {
+				break
+			}
+			all += d
+			if now-ts[i] <= 60_000 {
+				hor += d
+			}
+		}
+		est := f.DecayedRateAt(hs[k], tau, now)
+		errAll[ti] += math.Abs(est - all)
+		exAll[ti] += all
+		errH[ti] += math.Abs(est - hor)
+		exH[ti] += hor
+	})
+	for i, tau := range taus {
+		t.Logf("tau %2.0fs: normalized MAE vs the true EWMA %.4f; vs the EWMA of the last horizon %.4f", tau/1000, errAll[i]/exAll[i], errH[i]/exH[i])
+	}
+}
