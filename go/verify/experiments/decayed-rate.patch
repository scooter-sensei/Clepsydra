+package temporalfilter
+
+import "math"
+
+// DecayedRateAt is h's exponentially decayed event count at now,
+// sum over its events of exp(-(now-t)/tau), tau in ticks, read from its
+// register's buckets: each bucket's events spread uniformly over its span,
+// the newest bucket ending at the last touch, whose event counts whole.
+// Events older than the register's oldest bucket are not seen; nor is the
+// overflow table. (NEXT-RESULTS.md N19.)
+func (f *Filter) DecayedRateAt(h uint64, tau float64, now uint64) float64 {
+	w0, w1, src := f.read(h, now, -1)
+	if src == 0 {
+		return 0
+	}
+	last := w0 & tsMask
+	if age(now, last) > f.horizon {
+		return 0
+	}
+	v, ok := f.viewOf(f.stashID(h, fingerprint(h), tag(h)), w1, last)
+	if !ok {
+		return 0
+	}
+	decay := func(t float64) float64 { return math.Exp(-(float64(now) - t) / tau) }
+	sum, newest := 0.0, true
+	hi := float64(int64(v.e+1) * int64(f.unit))
+	for j := range nBuckets {
+		lo := float64(bucketStart(v.e, j) * int64(f.unit))
+		c := float64(v.c[j])
+		if c > 0 {
+			top := hi
+			if newest {
+				newest = false
+				top = math.Max(lo, math.Min(float64(last), hi))
+				sum += decay(float64(last)) // the event at last, whole
+				c--
+			}
+			if c > 0 {
+				if top > lo {
+					sum += c * tau / (top - lo) * (decay(top) - decay(lo))
+				} else {
+					sum += c * decay(lo)
+				}
+			}
+		}
+		hi = lo
+	}
+	return sum
+}
