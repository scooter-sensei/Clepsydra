index 0000000..828049c
--- /dev/null
+++ b/lab_despot_test.go
@@ -0,0 +1,128 @@
+package temporalfilter
+
+import (
+	"hash/fnv"
+	"math/rand/v2"
+	"os"
+	"sort"
+	"testing"
+	"time"
+
+	"github.com/scooter-sensei/clepsydra/go/internal/workload"
+)
+
+// lab/bio3-2026-11, arm B8: despotic placement (the real filter, counted).
+
+// churn8020 is workload.Churn with a fifth of the keys popular at birth and
+// a repeat one of those with probability 0.8.
+func churn8020(load float64, seed uint64, capacity int, hTicks uint64, hash func(uint64) uint64, op func(h, window, now uint64)) {
+	r := rand.New(rand.NewPCG(seed, 1))
+	const newFrac = 0.6
+	ratePerMs := load * float64(capacity) / (newFrac * float64(hTicks)) / 1.375
+	type born struct{ h, t uint64 }
+	var keys, pop []born
+	var next uint64
+	pick := func(l []born, now uint64) uint64 {
+		lo := sort.Search(len(l), func(i int) bool { return l[i].t+hTicks*3/2 > now })
+		return l[lo+r.IntN(len(l)-lo)].h
+	}
+	for now := uint64(1); now < 4*hTicks; now++ {
+		n := int(ratePerMs)
+		if r.Float64() < ratePerMs-float64(n) {
+			n++
+		}
+		for range n {
+			var h uint64
+			if len(keys) == 0 || r.Float64() < newFrac {
+				next++
+				h = hash(next)
+				keys = append(keys, born{h, now})
+				if r.Float64() < 0.2 {
+					pop = append(pop, born{h, now})
+				}
+			} else if len(pop) > 0 && r.Float64() < 0.8 {
+				h = pick(pop, now)
+			} else {
+				h = pick(keys, now)
+			}
+			op(h, workload.Windows[r.IntN(len(workload.Windows))], now)
+		}
+	}
+}
+
+func TestLabDespot(t *testing.T) {
+	if os.Getenv("TF_LAB") == "" {
+		t.Skip("set TF_LAB=1")
+	}
+	const capN, hTicks = 200_000, 60_000
+	type stream func(load float64, seed uint64, capacity int, hTicks uint64, hash func(uint64) uint64, op func(h, window, now uint64))
+	defer func(d int) { labDespot = d }(labDespot)
+	for _, st := range []struct {
+		name string
+		run  stream
+	}{{"churn", workload.Churn}, {"80/20", churn8020}} {
+		for _, c := range []struct {
+			load float64
+			seed uint64
+		}{{1.0, 2}, {1.15, 4}} {
+			for _, despot := range []int{0, 1, 2, 6, 7} {
+				labDespot = despot
+				f, err := New(Config{Capacity: capN, Horizon: time.Minute, Resolution: time.Millisecond})
+				if err != nil {
+					t.Fatal(err)
+				}
+				s0, n0 := labSearches.Load(), labScanned.Load()
+				t0, h0, c0 := labTries.Load(), labHomed.Load(), labChallenged.Load()
+				last := map[uint64]uint64{}
+				var ops, hits, altHits, first, missed, falseSeen int
+				dig := fnv.New64a()
+				var buf [9]byte
+				st.run(c.load, c.seed, capN, hTicks, mix64, func(h, w, now uint64) {
+					ops++
+					fp, tg := fingerprint(h), tag(h)
+					if i, fpd := f.locateAt(h, fp, tg); i >= 0 && age(now, f.words[i]&tsMask) <= f.horizon {
+						hits++
+						if fpd&1 == 1 {
+							altHits++
+						}
+					} else {
+						first++
+					}
+					r := f.TouchAt(h, w, now)
+					lt, ok := last[h]
+					want := ok && now-lt <= w
+					last[h] = now
+					if want && !r.Seen {
+						missed++
+					}
+					if !want && r.Seen {
+						falseSeen++
+					}
+					buf[0] = 0
+					if r.Seen {
+						buf[0] = 1
+					}
+					for k := 0; k < 8; k++ {
+						buf[1+k] = byte(uint64(r.Count) >> (8 * k))
+					}
+					dig.Write(buf[:])
+				})
+				end := uint64(4*hTicks - 1)
+				var live, disp int
+				for i := 0; i < len(f.words); i += 2 {
+					if w0 := f.words[i]; w0 != 0 && age(end, w0&tsMask) <= f.horizon {
+						live++
+						if w0&dispBit != 0 {
+							disp++
+						}
+					}
+				}
+				se, sc := labSearches.Load()-s0, labScanned.Load()-n0
+				t.Logf("%-5s load %.2f arm %d ops %d hits %d in-alt %d (%.4f) | live %d displaced %.4f | first %d searches %d (%.4f) scanned/search %.2f reloc %d evict %d | missed %d falseSeen %d digest %016x | tries %d homed %d challenged %d (moves/hit %.4f)",
+					st.name, c.load, despot, ops, hits, altHits, float64(altHits)/float64(hits), live, float64(disp)/float64(live),
+					first, se, float64(se)/float64(first), float64(sc)/float64(max(se, 1)), f.Relocations(), f.Evictions(), missed, falseSeen, dig.Sum64(),
+					labTries.Load()-t0, labHomed.Load()-h0, labChallenged.Load()-c0, float64(labHomed.Load()-h0+2*(labChallenged.Load()-c0))/float64(hits))
+			}
+		}
+	}
+}
