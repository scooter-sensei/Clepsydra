+
+// lab/bio3-2026-11, arms B8 and B8b: despotic placement. labDespot is
+// TF_DESPOT's bits: 1 the search's order (B8), 2 homing and 4 the challenge
+// (B8b).
+var (
+	labDespot, _  = strconv.Atoi(os.Getenv("TF_DESPOT"))
+	labSearches   atomic.Uint64 // searches begun
+	labScanned    atomic.Uint64 // entries a search tried to move (budget spent)
+	labTries      atomic.Uint64 // B8b: touches that tried to take their key home
+	labHomed      atomic.Uint64 // ... and did, into a free slot
+	labChallenged atomic.Uint64 // ... after moving a lighter entry out of the primary line
+)
+
+// earn is B8b: a touch found its key in slot i of its alternate line and
+// left it with register w1. At 2, 4, 8, ... events in the horizon the entry
+// tries to go home: into a free slot of its primary line, which the lookup
+// has just read, or (the challenge) into the slot of that line's lightest
+// entry, if that one has at most half its events and room in its own other
+// line.
+func (f *Filter) earn(i int, w1, now uint64) {
+	if isHot(w1) {
+		return
+	}
+	m := f.mass(0, w1, now, now)
+	if m < 2 || m&(m-1) != 0 {
+		return
+	}
+	labTries.Add(1)
+	a := uint64(i / wordsPerLine)
+	budget := 1
+	if f.relocate(i, a, 0, 0, now, 0, &budget, nil, nil) {
+		labHomed.Add(1)
+		return
+	}
+	if labDespot&4 == 0 {
+		return
+	}
+	w0 := atomic.LoadUint64(&f.words[i])
+	if w0 == 0 || w0&dispBit == 0 {
+		return
+	}
+	p := f.alt(a, w0>>48)
+	base := int(p * wordsPerLine)
+	loser, least := -1, m/2+1
+	for s := 0; s < wordsPerLine; s += 2 {
+		l0 := atomic.LoadUint64(&f.words[base+s])
+		l1 := atomic.LoadUint64(&f.words[base+s+1])
+		if l0 == 0 || l1>>tagShift == tagBusy || isHot(l1) {
+			continue
+		}
+		if lm := f.mass(0, l1, l0&tsMask, now); lm < least {
+			loser, least = base+s, lm
+		}
+	}
+	if loser < 0 {
+		return
+	}
+	budget = 1
+	if !f.relocate(loser, p, 0, 0, now, 0, &budget, nil, nil) {
+		return
+	}
+	budget = 1
+	if f.relocate(i, a, 0, 0, now, 0, &budget, nil, nil) {
+		labChallenged.Add(1)
+	}
+}
+
+// despotOrder sorts a search's eight first-step candidates by what moving
+// each does for reads: entries in their alternate line first (the move takes
+// them home), the heaviest first; then entries at home (the move sends them
+// to their alternate line), the lightest first, oldest on ties.
+func (f *Filter) despotOrder(lines [2]uint64, now uint64, order *[8]uint8) {
+	var key [8]uint64
+	for c := range order {
+		line := lines[c>>2]
+		i := int(line*wordsPerLine) + (c&3)*2
+		w0 := atomic.LoadUint64(&f.words[i])
+		v1 := atomic.LoadUint64(&f.words[i+1])
+		ts := w0 & tsMask
+		var m uint64
+		if w0 != 0 && v1>>tagShift != tagBusy {
+			m = min(f.mass(f.slotID(line, w0, v1), v1, ts, now), 1<<16-1)
+		}
+		if w0&dispBit != 0 {
+			key[c] = (1<<16-1-m)<<46 | ts
+		} else {
+			key[c] = 1<<63 | m<<46 | ts
+		}
+	}
+	for a := 1; a < 8; a++ { // insertion sort, stable
+		for b := a; b > 0 && key[order[b]] < key[order[b-1]]; b-- {
+			order[b], order[b-1] = order[b-1], order[b]
+		}
+	}
+}
diff --git a/lab_despot_test.go b/lab_despot_test.go
