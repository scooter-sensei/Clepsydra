+
+// dispStripes is how many stripes of lines dispClr counts clears in.
+const dispStripes = 16
+
+// dispClear: clears of the disp bits of a stripe's lines, begun and done.
+type dispClear struct {
+	begun, done atomic.Uint64
+	_           [48]byte
+}
+
+// mayDisp reports whether line may hold a displaced entry a lookup can
+// match: its disp bit is set, or a clear of its stripe overlapped the bit's
+// read. A writer sets the bit after a displaced word0 is in place and
+// before the entry is published (install), and a clear holds its stripe's
+// count from before it clears the bit until it has looked at the line again
+// and put the bit back if a displaced word0 is there (sweepDisp). So while a
+// published displaced entry is in line, the bit is set or such a clear is
+// under way: done read before the bit and begun read after it then differ.
+// A clear bit with no clear around its read means the line held no
+// published displaced entry at that read, as a scan of the line then would
+// have found.
+func (f *Filter) mayDisp(line uint64) bool {
+	c := &f.dispClr[line&(dispStripes-1)]
+	d := c.done.Load()
+	if atomic.LoadUint64(&f.disp[line>>6])&(1<<(line&63)) != 0 {
+		return true
+	}
+	return c.begun.Load() != d
+}
+
+// setDisp sets line's disp bit. The caller has put a displaced word0 in
+// line and not yet published its entry.
+func (f *Filter) setDisp(line uint64) {
+	p, b := &f.disp[line>>6], uint64(1)<<(line&63)
+	if atomic.LoadUint64(p)&b == 0 {
+		atomic.OrUint64(p, b)
+	}
+}
+
+// holdsDisp reports whether any slot of line has a displaced word0
+// (published or not).
+func (f *Filter) holdsDisp(line uint64) bool {
+	base := int(line * wordsPerLine)
+	w := f.words[base : base+wordsPerLine : base+wordsPerLine]
+	for s := 0; s < wordsPerLine; s += 2 {
+		if atomic.LoadUint64(&w[s])&dispBit != 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// sweepDisp clears line's disp bit if no slot of line holds a displaced
+// word0. The clear is counted (dispClr) from before the bit is cleared
+// until the line has been looked at again, after the clear, and the bit set
+// again if a displaced word0 is there: one put in after the second look
+// sets the bit itself (setDisp follows the word0).
+func (f *Filter) sweepDisp(line uint64) {
+	p, b := &f.disp[line>>6], uint64(1)<<(line&63)
+	if atomic.LoadUint64(p)&b == 0 || f.holdsDisp(line) {
+		return
+	}
+	c := &f.dispClr[line&(dispStripes-1)]
+	c.begun.Add(1)
+	atomic.AndUint64(p, ^b)
+	if testHookDispCleared != nil {
+		testHookDispCleared(line)
+	}
+	if f.holdsDisp(line) {
+		atomic.OrUint64(p, b)
+	}
+	c.done.Add(1)
 }
 
