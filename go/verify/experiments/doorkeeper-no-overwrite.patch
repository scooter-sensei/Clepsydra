new file mode 100644
index 0000000..afae1f0
--- /dev/null
+++ b/doorkeeper.go
@@ -0,0 +1,96 @@
+package temporalfilter
+
+import (
+	"math/bits"
+	"sync/atomic"
+)
+
+// Doorkeeper (lab E7c): while the table is saturated, a key's first touch is
+// kept out of it, as an entry here (24-bit fingerprint, 8-bit Horizon/2
+// slice), and its second goes in, counting the first. Buckets are 16
+// entries (one cache line). A full bucket overwrites nothing: the key takes
+// the normal path, so no entry is ever forgotten. Seen is never answered
+// from it; Upper is (+1 for a live entry of a key absent from the table).
+type doorkeeper struct {
+	w        []uint32
+	nb       uint64
+	sliceLen uint64
+	horizon  uint64
+}
+
+// dkSaturated: the search pressure at which first touches are kept out.
+const dkSaturated = pressureOne - pressureOne/16
+
+func (f *Filter) doorKeeper() *doorkeeper {
+	if d := f.dk.Load(); d != nil {
+		return d
+	}
+	f.skMu.Lock()
+	defer f.skMu.Unlock()
+	if d := f.dk.Load(); d != nil {
+		return d
+	}
+	nb := max(1, f.lines*slotsPerLine/32)
+	d := &doorkeeper{w: make([]uint32, nb*16), nb: nb, sliceLen: (f.horizon + 1) / 2, horizon: f.horizon}
+	f.dk.Store(d)
+	return d
+}
+
+func (d *doorkeeper) slot(h uint64) (base int, fp uint32) {
+	x := mix64(h ^ 0x6a09e667f3bcc909)
+	b, _ := bits.Mul64(x, d.nb)
+	if fp = uint32(x>>40) & 0xFFFFFF; fp == 0 {
+		fp = 1
+	}
+	return int(b * 16), fp
+}
+
+// live: an entry's slice (8-bit stamp, the latest such slice at or before
+// now's) can still hold an event within the horizon. A stamp 128 horizons
+// old aliases as live: an extra Upper, never a missing one.
+func (d *doorkeeper) live(e uint32, now uint64) bool {
+	cur := now / d.sliceLen
+	sl := cur - (cur-uint64(e&0xFF))&0xFF
+	return age(now, sl*d.sliceLen+d.sliceLen-1) <= d.horizon
+}
+
+// find is the word index of h's live entry, or -1.
+func (d *doorkeeper) find(h, now uint64) int {
+	base, fp := d.slot(h)
+	for k := range 16 {
+		if e := atomic.LoadUint32(&d.w[base+k]); e != 0 && e>>8 == fp && d.live(e, now) {
+			return base + k
+		}
+	}
+	return -1
+}
+
+// keep writes h's entry (h has none) into a free or dead way; false if the
+// bucket is full.
+func (d *doorkeeper) keep(h, now uint64) bool {
+	base, fp := d.slot(h)
+	e := fp<<8 | uint32(now/d.sliceLen&0xFF)
+	for {
+		free, old := -1, uint32(0)
+		for k := range 16 {
+			if o := atomic.LoadUint32(&d.w[base+k]); o == 0 || !d.live(o, now) {
+				free, old = base+k, o
+				break
+			}
+		}
+		if free < 0 {
+			return false
+		}
+		if atomic.CompareAndSwapUint32(&d.w[free], old, e) {
+			return true
+		}
+	}
+}
+
+// dkUpper is what the doorkeeper adds to Upper for h, absent from the table.
+func (f *Filter) dkUpper(h, now uint64) int {
+	if d := f.dk.Load(); d != nil && d.find(h, now) >= 0 {
+		return 1
+	}
+	return 0
+}
