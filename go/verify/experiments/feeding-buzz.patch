+	scen("B", 12_800, 400, 20, 0, buzzRules, mults)
+	scen("C", 200_000, 400, 20, 0.1, buzzRules, mults)
+	scen("E", 200_000, 400, 20, 0, []buzzRule{{2_500, 20}, {5_000, 40}}, mults)
+	if only == "X" { // one rule of A, to look at a reading
+		scen("X", 200_000, 400, 20, 0, []buzzRule{{60_000, 6}, {1_000, 5}}, []float64{2})
