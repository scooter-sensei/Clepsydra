+package temporalfilter
+
+import "os"
+
+// lab/bio4-2026-11's switches for arms B12 and B12b, the feeding buzz
+// (BIO4-RESULTS.md). Unset, the filter is the committed one. They are read
+// once; the lab's tests set them between filters.
+var (
+	// labBuzz (TF_BUZZ), arm B12: TouchIfUnder gives a key an exact log of
+	// its admitted events on an uncertain refusal (buzz.go).
+	labBuzz = os.Getenv("TF_BUZZ") != ""
+	// labBuzz2 (TF_BUZZ=2), arm B12b: an entry answers for any register
+	// that is not full (B12: none with a bucket at 31), an event a horizon
+	// old leaves the log, and a key has eight ways (B12: two).
+	labBuzz2 = func() int {
+		if os.Getenv("TF_BUZZ") == "2" {
+			return 1
+		}
+		return 0
+	}()
+)
diff --git a/lab_buzz_test.go b/lab_buzz_test.go
new file mode 100755
index 0000000..1a1089f
--- /dev/null
+++ b/lab_buzz_test.go
@@ -0,0 +1,310 @@
+package temporalfilter
+
+import (
+	"fmt"
+	"math/rand/v2"
+	"os"
+	"sort"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/scooter-sensei/clepsydra/go/internal/workload"
+)
+
+// lab/bio4-2026-11, arm B12: the feeding buzz (buzz.go), read on the filter
+// itself.
+
+type buzzRule struct{ w, limit uint64 }
+
+func (ru buzzRule) String() string { return fmt.Sprintf("%gs/%d", float64(ru.w)/1000, ru.limit) }
+
+// buzzRow is one reading: the same requests offered to an exact sliding
+// log, to the filter's TouchIfUnderAt (base) and to the same with the buzz.
+type buzzRow struct {
+	events                                  int
+	admitted                                [3]int // exact, base, buzz
+	falseDeny                               [2]int // base, buzz: refused while the key's own events in the window are under the limit
+	given, refused, dropped, decided, saved uint64
+	dropKind, dropWords, dropCheck          uint64
+	held                                    int
+	evictions, relocations                  uint64
+	bytesBase, bytesBuzz                    int
+}
+
+// labWithin counts the events of ts (sorted) inside [now-w, now].
+func labWithin(ts []uint64, w, now uint64) int {
+	return len(ts) - sort.Search(len(ts), func(j int) bool { return ts[j]+w >= now })
+}
+
+// buzzOffer offers nkeys keys' Poisson requests, at mult times the rule's
+// rate, to the three limiters for horizons horizons of 60 s (1 ms ticks) in
+// filters of Capacity capN. One request in 1/plainFrac is a plain TouchAt in
+// every arm (it counts, and no rule is asked). With churnLoad the two
+// filters also take tfbench's churn stream at that load (its 4 horizons). It
+// fails the test if an arm admits a request while the key's window already
+// holds the limit.
+func buzzOffer(t *testing.T, capN, nkeys int, ru buzzRule, mult float64, horizons int, plainFrac, churnLoad float64, churnSeed uint64) (row buzzRow) {
+	const hT = 60_000
+	defer func(b bool) { labBuzz = b }(labBuzz)
+	newF := func() *Filter {
+		f, err := New(Config{Capacity: capN, Horizon: time.Minute, Resolution: time.Millisecond})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return f
+	}
+	fb, fz := newF(), newF()
+	r := rand.New(rand.NewPCG(4, ru.w+ru.limit))
+	type ev struct {
+		t     uint64
+		k     int
+		plain bool
+	}
+	var evs []ev
+	rate := mult * float64(ru.limit) / float64(ru.w)
+	end := float64(horizons * hT)
+	for k := range nkeys {
+		for x := r.ExpFloat64() / rate; x < end; x += r.ExpFloat64() / rate {
+			evs = append(evs, ev{uint64(x) + 1, k, plainFrac > 0 && r.Float64() < plainFrac})
+		}
+	}
+	sort.SliceStable(evs, func(i, j int) bool { return evs[i].t < evs[j].t })
+	var own [3][][]uint64 // per arm, per key: the ticks of its events (admitted, or plain)
+	for a := range own {
+		own[a] = make([][]uint64, nkeys)
+	}
+	limit := int(ru.limit)
+	offer := func(e ev) {
+		h := mix64(uint64(e.k) + 1<<50)
+		if e.plain {
+			for a := range own {
+				own[a][e.k] = append(own[a][e.k], e.t)
+			}
+			labBuzz = false
+			fb.TouchAt(h, ru.w, e.t)
+			fz.TouchAt(h, ru.w, e.t)
+			return
+		}
+		row.events++
+		if labWithin(own[0][e.k], ru.w, e.t) < limit {
+			own[0][e.k] = append(own[0][e.k], e.t)
+			row.admitted[0]++
+		}
+		for a, f := range [2]*Filter{fb, fz} {
+			labBuzz = a == 1
+			in := labWithin(own[a+1][e.k], ru.w, e.t)
+			if _, ok := f.TouchIfUnderAt(h, ru.w, ru.limit, e.t); ok {
+				if in >= limit {
+					t.Fatalf("%v x%.1f arm %d: admitted with %d events in the window (key %d, tick %d)", ru, mult, a+1, in, e.k, e.t)
+				}
+				own[a+1][e.k] = append(own[a+1][e.k], e.t)
+				row.admitted[a+1]++
+			} else if in < limit {
+				row.falseDeny[a]++
+			}
+		}
+		labBuzz = false
+	}
+	if churnLoad > 0 {
+		i := 0
+		workload.Churn(churnLoad, churnSeed, capN, hT, mix64, func(h, w, now uint64) {
+			for ; i < len(evs) && evs[i].t <= now; i++ {
+				offer(evs[i])
+			}
+			fb.CheckAndTouchAt(h, w, now)
+			fz.CheckAndTouchAt(h, w, now)
+		})
+		for ; i < len(evs); i++ {
+			offer(evs[i])
+		}
+	} else {
+		for _, e := range evs {
+			offer(e)
+		}
+	}
+	if tb := fz.buzz.Load(); tb != nil {
+		row.given, row.refused, row.dropped = tb.given.Load(), tb.refused.Load(), tb.dropped.Load()
+		row.decided, row.saved = tb.decided.Load(), tb.saved.Load()
+		row.dropKind, row.dropWords, row.dropCheck = tb.dropKind.Load(), tb.dropWords.Load(), tb.dropCheck.Load()
+	}
+	if fb.buzz.Load() != nil {
+		t.Fatalf("the base arm's filter holds a buzz table")
+	}
+	row.held = fz.buzzInUse()
+	row.evictions, row.relocations = fz.Evictions(), fz.Relocations()
+	row.bytesBase, row.bytesBuzz = fb.Bytes(), fz.Bytes()
+	return row
+}
+
+func (row buzzRow) String() string {
+	ex := float64(row.admitted[0])
+	n := float64(row.events)
+	return fmt.Sprintf("requests %8d exact admits %8d | admitted/exact base %.3f buzz %.3f | false denials base %.4f buzz %.4f | entries given %6d refused %7d dropped %6d (kind %d, words %d, check %d) held %5d | decided by a log %8d, of which the register refused %7d",
+		row.events, row.admitted[0], float64(row.admitted[1])/ex, float64(row.admitted[2])/ex,
+		float64(row.falseDeny[0])/n, float64(row.falseDeny[1])/n,
+		row.given, row.refused, row.dropped, row.dropKind, row.dropWords, row.dropCheck, row.held, row.decided, row.saved)
+}
+
+var buzzRules = []buzzRule{{1_000, 5}, {5_000, 10}, {10_000, 3}, {10_000, 5}, {30_000, 10}, {60_000, 6}, {60_000, 16}}
+
+func TestLabBuzz(t *testing.T) {
+	if os.Getenv("TF_LAB") == "" {
+		t.Skip("set TF_LAB=1")
+	}
+	only := os.Getenv("TF_BUZZ_SCENARIO") // one of A B C D E M; empty: all
+
+	if only == "" || only == "M" {
+		// Memory: nothing until the first uncertain refusal.
+		defer func(b bool) { labBuzz = b }(labBuzz)
+		labBuzz = true
+		f, _ := New(Config{Capacity: 200_000, Horizon: time.Minute, Resolution: time.Millisecond})
+		b0 := f.Bytes()
+		for k := range 10_000 { // admitted, and refused with certainty (one tick: the register is exact)
+			for range 4 {
+				f.TouchIfUnderAt(mix64(uint64(k)+1<<51), 60_000, 3, 1000)
+			}
+		}
+		t.Logf("M: 10,000 keys, 4 requests each at one tick under a limit of 3: buzz table allocated %v, Bytes %d -> %d",
+			f.buzz.Load() != nil, b0, f.Bytes())
+		if f.buzz.Load() != nil || f.Bytes() != b0 {
+			t.Errorf("M: memory before any uncertain refusal")
+		}
+		labBuzz = false
+	}
+
