+++ b/buzz.go
@@ -0,0 +1,313 @@
+package temporalfilter
+
+import (
+	"math/bits"
+	"sync/atomic"
+	"unsafe"
+)
+
+// The feeding buzz (lab/bio4-2026-11, arm B12; TF_BUZZ=1).
+//
+// TouchIfUnder refuses while Upper is at the limit, and Upper counts the
+// bucket the window's edge cuts as whole. A refusal is uncertain when the
+// events certainly inside the window (certain) are under the limit. On an
+// uncertain refusal the key gets a buzz entry: the slot's two words as they
+// are, and from then on the tick of every event TouchIfUnder admits for it,
+// the newest buzzCap of them in 16-bit steps of Horizon/32768.
+//
+// An entry is trusted only while the key's slot holds, bit for bit, what the
+// entry's last admission left (the displaced bit aside, which a relocation
+// flips). Every event the filter counts for a key whose word1 is a register
+// with no bucket full changes one of the two words: the count of some
+// bucket, or the last touch. So while they match, the events since the
+// entry's start are the logged ones, and a window that starts after the
+// tick the log may miss events before is decided by the log: an event is
+// inside unless its step ends before the window starts. Anything else that
+// counts for the key (a plain touch, a promotion, an eviction whose history
+// is shed or spilled) changes a word, the entry is dropped, and the key is
+// decided by its register again, as without the arm.
+//
+// The table is allocated on the first uncertain refusal: one entry of 64 B
+// per 128 slots, in sets of two. Nothing but TouchIfUnder reads it.
+
+const (
+	buzzCap     = 16 // events a log holds; a limit up to it is decided by the log alone
+	buzzWays    = 2
+	buzzStripes = 64
+	buzzBlock   = 4  // B12b: sets a key may use (a power of two): 8 ways, two lines each
+	buzzNShift  = 46 // meta: before (46 bits) | n (5) | head (4) | units to release (5)
+	buzzHShift  = 51
+	buzzUShift  = 55
+)
+
+type buzzEntry struct {
+	id     uint64    // the key's identity (stashID); 0: free
+	w0, w1 uint64    // the key's slot as the entry's last admission, or its start, left it
+	meta   uint64    // the tick at or before which the log may miss events, the ring's fill and head, the release span
+	ev     [4]uint64 // a ring of buzzCap steps (tick / q, mod 2^16)
+}
+
+func (e *buzzEntry) before() uint64 { return e.meta & tsMask }
+func (e *buzzEntry) n() int         { return int(e.meta >> buzzNShift & 31) }
+func (e *buzzEntry) head() int      { return int(e.meta >> buzzHShift & 15) }
+func (e *buzzEntry) units() uint64  { return e.meta >> buzzUShift & 31 }
+
+func (e *buzzEntry) step(k int) uint64 { return e.ev[k/4] >> (16 * (k % 4)) & 0xFFFF }
+
+// tick returns the first tick of the step stored at ring position k, decoded
+// against ref, a tick no event of the log is after (steps cover two
+// horizons, and an entry whose newest event is a horizon old is not read).
+func (e *buzzEntry) tick(k int, ref, q uint64) uint64 {
+	rq := ref / q
+	d := (rq - e.step(k)) & 0xFFFF
+	if d > rq {
+		return 0
+	}
+	return (rq - d) * q
+}
+
+// count is the log's answer for [now-window, now]: upper counts an event
+// unless its step ends before the window starts, sure only those whose step
+// starts inside it.
+func (e *buzzEntry) count(now, window, q uint64) (upper, sure int) {
+	ref := max(now, e.w0&tsMask)
+	from := now - min(now, window)
+	for k := range e.n() {
+		lo := e.tick((e.head()-1-k)&15, ref, q)
+		if lo+q-1 >= from {
+			upper++
+		}
+		if lo >= from {
+			sure++
+		}
+	}
+	return upper, sure
+}
+
+// covers: every event the log may miss is outside [now-window, now].
+func (e *buzzEntry) covers(now, window uint64) bool {
+	return now >= window && e.before() < now-window
+}
+
+// log records an admitted event at tick t. A full ring drops its oldest
+// step, and the log may from then on miss events up to that step's end.
+func (e *buzzEntry) log(t, q, horizon uint64) {
+	before, n, head := e.before(), e.n(), e.head()
+	if labBuzz2 != 0 {
+		// B12b: events a horizon old leave the ring, so no step is read two
+		// horizons after its event (steps repeat every 65536).
+		for ; n > 0; n-- {
+			if e.tick((head-n)&15, max(t, e.w0&tsMask), q)+q-1+horizon >= t {
+				break
+			}
+		}
+	}
+	if n == buzzCap {
+		before = max(before, e.tick(head, max(t, e.w0&tsMask), q)+q-1) & tsMask
+	} else {
+		n++
+	}
+	sh := 16 * uint(head%4)
+	e.ev[head/4] = e.ev[head/4]&^(0xFFFF<<sh) | (t/q&0xFFFF)<<sh
+	e.meta = before | uint64(n)<<buzzNShift | uint64((head+1)&15)<<buzzHShift | e.units()<<buzzUShift
+}
+
+type buzzTable struct {
+	e  []buzzEntry
+	n  uint64 // sets
+	q  uint64 // ticks per step
+	mu [buzzStripes]paddedMutex
+	// given: entries handed out; refused: uncertain refusals that found no
+	// way free; dropped: entries whose slot no longer matched; decided:
+	// conditional touches the log decided; saved: of those, admitted where
+	// the register's Upper refused.
+	given, refused, dropped, decided, saved atomic.Uint64
+	// Why entries were dropped: the slot no longer a register the words
+	// answer for (or gone); its words changed; the admission's check failed.
+	dropKind, dropWords, dropCheck atomic.Uint64
+}
+
+func (t *buzzTable) set(id uint64) ([]buzzEntry, *paddedMutex) {
+	i, _ := bits.Mul64(mix64(id^0x9e3779b97f4a7c15), t.n)
+	if labBuzz2 != 0 {
+		// B12b: a block of buzzBlock sets (one lock stripe), so a key has
+		// 2*buzzBlock ways.
+		i &^= buzzBlock - 1
+		return t.e[i*buzzWays : (i+buzzBlock)*buzzWays : (i+buzzBlock)*buzzWays], &t.mu[i/buzzBlock%buzzStripes]
+	}
+	return t.e[i*buzzWays : (i+1)*buzzWays : (i+1)*buzzWays], &t.mu[i%buzzStripes]
+}
+
+// buzzTable returns the table, allocated on first use: one entry per 128
+// slots.
+func (f *Filter) buzzTable() *buzzTable {
+	if t := f.buzz.Load(); t != nil {
+		return t
+	}
+	f.skMu.Lock()
+	defer f.skMu.Unlock()
+	if t := f.buzz.Load(); t != nil {
+		return t
+	}
+	sets := max(8, f.lines*slotsPerLine/(128*buzzWays))
+	if labBuzz2 != 0 {
+		sets &^= buzzBlock - 1
+	}
+	w := alignedWords(int(sets * buzzWays * uint64(unsafe.Sizeof(buzzEntry{})/8)))
+	prefault(w)
+	t := &buzzTable{e: unsafe.Slice((*buzzEntry)(unsafe.Pointer(&w[0])), sets*buzzWays), n: sets, q: max(1, (f.horizon+1<<15-1)>>15)}
+	f.buzz.Store(t)
+	return t
+}
+
+// certain is the number of events of the register w1 (last touched at last)
+// that lie inside [now-window, now] wherever they fall in their buckets: the
+// buckets wholly inside it, and the last touch.
+func (f *Filter) certain(w1, last, now, window uint64) int {
+	if age(now, last) > window {
+		return 0
+	}
+	v, _ := f.viewOf(0, w1, last)
+	unit := float64(f.unit)
+	from := float64(now) - float64(window)
+	n := 0
+	for j := range nBuckets {
+		lo := float64(bucketStart(v.e, j)) * unit
+		if from > lo {
+			break
+		}
+		n += int(v.c[j])
+	}
+	return max(1, n)
+}
+
+// touchIfBuzz is TouchIfUnderAt with the buzz (the caller holds h's
+// conditional stripe). Its first half is CountAt and the strict recipe, as
+// without the arm; it keeps the slot's words and the overflow table's part
+// of Upper.
+func (f *Filter) touchIfBuzz(h, window, limit, now uint64) (Result, bool) {
+	fp, tg := fingerprint(h), tag(h)
+	w0, w1, src := f.read(h, now, -1)
+	last := w0 & tsMask
+	live := src != 0 && age(now, last) <= f.horizon
+	var r Result
+	if live {
+		r = f.estimateAt(h, w1, last, now, window, w0&satBit != 0)
+		r.Seen = r.Count > 0
+	} else {
+		r.Degraded = f.lostRecently(now)
+	}
+	over := r.Upper
+	if f.sketchLive(now) {
+		f.addSketch(&r, h, window, now)
+	}
+	over = r.Upper - over
+	refuse := r.Saturated || f.skW == 0 && r.Degraded && !r.Seen || uint64(max(r.Upper, 0)) >= limit
+
+	// A register the two words answer for: no hot entry, no bucket full.
+	plain := live && !isHot(w1) && w0&satBit == 0 && (labBuzz2 == 0 && !hot(w1) || labBuzz2 != 0 && ^w1&regMask != 0)
+	win := min(window, f.horizon)
+	uncertain := func() bool {
+		return plain && limit <= buzzCap && !r.Saturated && uint64(f.certain(w1, last, now, win)+over) < limit
+	}
+	t := f.buzz.Load()
+	if t == nil {
+		if !refuse {
+			return f.TouchAt(h, window, now), true
+		}
+		if !uncertain() {
+			return r, false
+		}
+		t = f.buzzTable()
+	}
+	id := f.stashID(h, fp, tg)
+	set, mu := t.set(id)
+	mu.Lock()
+	defer mu.Unlock()
+	var e *buzzEntry
+	for i := range set {
+		if set[i].id == id {
+			e = &set[i]
+		}
+	}
+	if e != nil && !(plain && (w0^e.w0)&^dispBit == 0 && w1 == e.w1) {
+		if !plain {
+			t.dropKind.Add(1)
+		} else {
+			t.dropWords.Add(1)
+		}
+		*e, e = buzzEntry{}, nil // something else counted for the key, or its slot is gone
+		t.dropped.Add(1)
+	}
+	if e != nil && e.covers(now, win) {
+		up, _ := e.count(now, win, t.q)
+		was := refuse
+		r.Upper = up + over
+		r.Count = min(r.Count, r.Upper)
+		refuse = r.Saturated || uint64(r.Upper) >= limit
+		t.decided.Add(1)
+		if was && !refuse {
+			t.saved.Add(1)
+		}
+	}
+	if refuse {
+		if e == nil && uncertain() {
+			way := -1
+			for i := range set {
+				if set[i].id == 0 || age(now, set[i].w0&tsMask) > set[i].units()*f.unit {
+					way = i
+					break
+				}
+			}
+			if way < 0 {
+				t.refused.Add(1)
+			} else {
+				units := min(31, (win+f.unit-1)/f.unit+8)
+				set[way] = buzzEntry{id: id, w0: w0, w1: w1, meta: max(now, last) | units<<buzzUShift}
+				t.given.Add(1)
+			}
+		}
+		return r, false
+	}
+	res := f.TouchAt(h, window, now)
+	if e != nil {
+		// The slot must now hold what one event at now makes of the words
+		// read above: a plain touch between the two reads leaves another
+		// count, and the log would miss it.
+		n0, n1, nsrc := f.read(h, now, -1)
+		want, ovf := f.nextReg(w1, tg, last, now, false)
+		stamp := max(now, last)
+		if nsrc != 0 && !ovf && n1 == want && n0&tsMask == stamp && n0>>48 == fp && n0&satBit == 0 && (labBuzz2 != 0 || !hot(n1)) {
+			e.log(stamp, t.q, f.horizon)
+			e.w0, e.w1 = n0, n1
+		} else {
+			*e = buzzEntry{}
+			t.dropped.Add(1)
+			t.dropCheck.Add(1)
+		}
+	}
+	return res, true
+}
+
+// buzzInUse counts the entries held now.
+func (f *Filter) buzzInUse() int {
+	t := f.buzz.Load()
+	if t == nil {
+		return 0
+	}
+	n := 0
+	for s := uint64(0); s < t.n; s++ {
+		mu := &t.mu[s%buzzStripes]
+		if labBuzz2 != 0 {
+			mu = &t.mu[s/buzzBlock%buzzStripes]
+		}
+		mu.Lock()
+		for i := range buzzWays {
+			if t.e[s*buzzWays+uint64(i)].id != 0 {
+				n++
+			}
+		}
+		mu.Unlock()
+	}
+	return n
+}
