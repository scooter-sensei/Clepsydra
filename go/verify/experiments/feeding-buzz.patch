+// TestLabBuzzConcurrent (TF_LAB=1): G goroutines on a shared clock, as
+// TestTouchIfSustained, with the buzz on and limits a log can decide: the
+// admitted events per key must stay within the limit at every window
+// position, and logs must have decided some of them.
+func TestLabBuzzConcurrent(t *testing.T) {
+	if os.Getenv("TF_LAB") == "" {
+		t.Skip("set TF_LAB=1")
+	}
+	defer func(b bool) { labBuzz = b }(labBuzz)
+	labBuzz = true
+	const G, hTicks = 8, 60_000
+	for _, c := range []buzzRule{{1_000, 5}, {5_000, 10}, {10_000, 5}} {
+		for _, nk := range []int{1, 200} {
+			f, _ := New(Config{Capacity: 200_000, Horizon: time.Minute, Resolution: time.Millisecond})
+			logs := make([][]uint64, G) // per goroutine: key<<32 | tick
+			var wg, done sync.WaitGroup
+			step := make([]chan uint64, G)
+			for g := range G {
+				step[g] = make(chan uint64, 1)
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					r := rand.New(rand.NewPCG(uint64(g), 3))
+					for now := range step[g] {
+						// each key is asked about twice its limit per window
+						for range 1 + r.IntN(2) {
+							k := r.IntN(nk)
+							if r.Float64() < 2*float64(c.limit)*float64(nk)/(float64(c.w)*1.5*G) {
+								if _, ok := f.TouchIfUnderAt(mix64(uint64(k)+1<<43), c.w, c.limit, now); ok {
+									logs[g] = append(logs[g], uint64(k)<<32|now)
+								}
+							}
+						}
+						done.Done()
+					}
+				}()
+			}
+			ticks := uint64(2 * hTicks)
+			if testing.Short() {
+				ticks = hTicks / 2
+			}
+			for now := uint64(1); now <= ticks; now++ {
+				done.Add(G)
+				for g := range G {
+					step[g] <- now
+				}
+				done.Wait()
+			}
+			for g := range G {
+				close(step[g])
+			}
+			wg.Wait()
+			per := make([][]uint64, nk)
+			total := 0
+			for g := range G {
+				for _, x := range logs[g] {
+					per[x>>32] = append(per[x>>32], x&(1<<32-1))
+					total++
+				}
+			}
+			over, positions := 0, 0
+			for k := range per {
+				ts := per[k]
+				sort.Slice(ts, func(a, b int) bool { return ts[a] < ts[b] })
+				lo := 0
+				for hi := range ts {
+					for ts[lo]+c.w < ts[hi] {
+						lo++
+					}
+					j := hi
+					for j+1 < len(ts) && ts[j+1] == ts[hi] {
+						j++
+					}
+					positions++
+					if j-lo+1 > int(c.limit) {
+						over++
+					}
+				}
+			}
+			tb := f.buzz.Load()
+			var decided, saved, given, dropped uint64
+			if tb != nil {
+				decided, saved, given, dropped = tb.decided.Load(), tb.saved.Load(), tb.given.Load(), tb.dropped.Load()
+			}
+			// the most an exact log could admit: the limit per window, per key
+			t.Logf("concurrent keys %3d %v: admitted %d (%.2f of limit x windows x keys), positions %d, over the limit %d; entries given %d dropped %d, decided by a log %d, of which the register refused %d",
+				nk, c, total, float64(total)/(float64(c.limit)*float64(ticks)/float64(c.w)*float64(nk)), positions, over, given, dropped, decided, saved)
+			if over != 0 {
+				t.Errorf("concurrent keys %d %v: over the limit at %d window positions", nk, c, over)
+			}
+			if decided == 0 {
+				t.Errorf("concurrent keys %d %v: no decision was made by a log", nk, c)
+			}
+		}
+	}
+}
