+// unlock reopens entry idx's cells and c0 with the next generation.
+func (t *hotTable) unlock(idx, ver uint64) {
+	if b := t.blk[idx].Load(); b != 0 {
+		cs := t.block(b)
+		for j := range cs {
+			cs[j].c.Store(cs[j].c.Load()&^hotClosed + hotGen)
+		}
+	}
+	t.e[idx].unlock(ver)
+}
+
+// load is the entry's load with its cells added to bucket 0.
+func (t *hotTable) load(idx uint64) view {
+	v := t.e[idx].load()
+	if b := t.blk[idx].Load(); b != 0 {
+		cs := t.block(b)
+		for j := range cs {
+			v.c[0] += cs[j].c.Load() & hotCount
+		}
+	}
+	return v
+}
+
+// store is the entry's store, its cells (folded into v by load) zeroed.
+func (t *hotTable) store(idx uint64, v *view) {
+	if b := t.blk[idx].Load(); b != 0 {
+		cs := t.block(b)
+		for j := range cs {
+			cs[j].c.Store(cs[j].c.Load() &^ hotCount)
+		}
+	}
+	t.e[idx].store(v)
+}
+
+// attach gives held entry idx a free block, zeroed and closed (unlock opens
+// it), if it has none and one is free.
+func (t *hotTable) attach(idx uint64) {
+	for t.blk[idx].Load() == 0 {
+		fr := t.cfree.Load()
+		if fr == 0 {
+			return
+		}
+		b := uint32(bits.TrailingZeros64(fr)) + 1
+		if t.cfree.CompareAndSwap(fr, fr&^(1<<(b-1))) {
+			cs := t.block(b)
+			for j := range cs {
+				cs[j].c.Store(cs[j].c.Load()&^hotCount | hotClosed)
+			}
+			t.blk[idx].Store(b)
+		}
+	}
+}
+
+// detach takes held entry idx's block back; its cells stay closed.
+func (t *hotTable) detach(idx uint64) {
+	if b := t.blk[idx].Load(); b != 0 {
+		t.blk[idx].Store(0)
+		t.cfree.Or(1 << (b - 1))
+	}
+}
