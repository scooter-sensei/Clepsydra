diff --git a/cells_test.go b/cells_test.go
new file mode 100755
index 0000000..f4a87e2
--- /dev/null
+++ b/cells_test.go
@@ -0,0 +1,59 @@
+package temporalfilter
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+// TestCellsExact (scratch, experiment E23): K hot; 12 goroutines touch it
+// 100,000 times each, their clocks crossing three unit boundaries at their
+// own pace (adds at the entry's unit go to c0 or a cell, older ones to the
+// lock path, a newer unit advances the entry and frees its block). K's
+// count over the horizon must be exact, and some block must have been used.
+// Run with -count to repeat.
+func TestCellsExact(t *testing.T) {
+	f := newMinuteFilter(t, 1000)
+	k := keyAt(f, 7, twoLineFPs(f, 7, 0x6600, 1)[0], 0x321)
+	for range 40 { // past the register's 31 events in a unit: promoted
+		f.TouchAt(k, 0, sweepT0)
+	}
+	if f.Promoted() != 1 {
+		t.Fatalf("K not promoted")
+	}
+	const workers, per = 12, 100_000
+	var used atomic.Bool
+	stop := make(chan struct{})
+	go func() { // did any entry take a block?
+		ht := f.hot.Load()
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			if ht.cfree.Load() != 1<<hotCellBlocks-1 {
+				used.Store(true)
+			}
+		}
+	}()
+	var wg sync.WaitGroup
+	for range workers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range per {
+				f.TouchAt(k, 0, sweepT0+uint64(i/(per/4))*f.unit)
+			}
+		}()
+	}
+	wg.Wait()
+	close(stop)
+	end := sweepT0 + 3*f.unit
+	if r := f.CountAt(k, f.horizon, end); r.Count != 40+workers*per || r.Saturated {
+		t.Fatalf("K reads %+v, want Count %d (blocks used: %v)", r, 40+workers*per, used.Load())
+	}
+	if !used.Load() {
+		t.Fatalf("no block was used")
+	}
+}
