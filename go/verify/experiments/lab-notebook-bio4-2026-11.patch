@@ -0,0 +1,27 @@
+#!/bin/bash
+# The remaining readings of B12b (clause 7) and B13 (clauses 1-7).
+O=$HOME/lab-bio4-out
+G=$HOME/bin/g4.sh
+RACE='CGO_ENABLED=1 CC=$HOME/bin/zcc GOFLAGS=-ldflags=-linkmode=external'
+run() { # run <label> <env> <cmd>
+	local t0=$SECONDS
+	$G "export $2; $3" >"$O/$1.txt" 2>&1
+	echo "$1: exit $? ($((SECONDS - t0)) s): $(grep -c '^--- FAIL' "$O/$1.txt") failed: $(tail -1 "$O/$1.txt" | cut -c1-90)"
+}
+run labear "TF_LAB=1" "go test -count=1 -timeout 30m -run '^TestLabEar\$' -v ."
+run buzz2-short "TF_BUZZ=2" "go test -short -count=1 ."
+run buzz2-bg "TF_BUZZ=2 TF_BG=1" "go test -short -count=1 ."
+run buzz2-race "TF_BUZZ=2 TF_LAB=1 $RACE" "go test -race -short -count=1 -run 'TouchIf|TestLabBuzzConcurrent' -v ."
+run ear1-nocas2 "TF_EAR=1 TF_NOCAS2=1" "go test -short -count=1 ."
+run ear1-race "TF_EAR=1 $RACE" "go test -race -short -count=1 -timeout 30m ."
+run ear2-short "TF_EAR=2" "go test -short -count=1 ."
+run ear2-bg "TF_EAR=2 TF_BG=1" "go test -short -count=1 ."
+run ear2-ct "TF_EAR=2 TF_CT=1" "go test -short -count=1 ."
+run ear2-exact "TF_EAR=2" "go run ./cmd/tfbench -exact"
+run ear2-attack "TF_EAR=2 TF_EXP=1" "go test -count=1 -run 'Attack|TestSpray|TestUpper|TestHeavy' -v ."
+run ear2-fuzz "TF_EAR=2 TF_FUZZ=1e8" "go test -count=1 -timeout 60m -run '^TestFuzzUpper\$' -v ."
+run ear1-soak "TF_EAR=1 TF_STRESS=60s" "go test -count=1 -timeout 30m -run '^TestStressSoak\$' -v ."
+run ear2-soak "TF_EAR=2 TF_STRESS=60s" "go test -count=1 -timeout 30m -run '^TestStressSoak\$' -v ."
+run ear1-cfuzz "TF_EAR=1 TF_CFUZZ=5m" "go test -count=1 -timeout 30m -run '^TestFuzzConcurrent\$' -v ."
+run ear2-cfuzz "TF_EAR=2 TF_CFUZZ=5m" "go test -count=1 -timeout 30m -run '^TestFuzzConcurrent\$' -v ."
+grep -n "^--- FAIL\|^    --- FAIL" "$O"/buzz2-*.txt "$O"/ear1-nocas2.txt "$O"/ear1-race.txt "$O"/ear2-*.txt "$O"/ear1-soak.txt "$O"/ear1-cfuzz.txt | cut -c1-200 | head -40
