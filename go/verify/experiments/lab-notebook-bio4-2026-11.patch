@@ -0,0 +1,22 @@
+#!/bin/bash
+# B13a's identity checks: the short suite in each mode, tfbench -exact, the vectors.
+O=$HOME/lab-bio4-out
+mkdir -p $O
+G=$HOME/bin/g4.sh
+run() { # run <label> <env> <cmd>
+	local t0=$SECONDS
+	$G "$2 $3" >"$O/$1.txt" 2>&1
+	echo "$1: exit $? ($((SECONDS - t0)) s): $(tail -1 "$O/$1.txt")"
+}
+run base-short "" "go test -short -count=1 ."
+run ear1-short "TF_EAR=1" "go test -short -count=1 ."
+run ear1-bg "TF_EAR=1 TF_BG=1" "go test -short -count=1 ."
+run ear1-ct "TF_EAR=1 TF_CT=1" "go test -short -count=1 ."
+run ear1-nocas2 "TF_EAR=1 TF_NOCAS2=1" "go test -short -count=1 ."
+run ear1-conformance "TF_EAR=1" "go test -count=1 -run '^TestConformance\$' ."
+run ear1-exact "TF_EAR=1" "go run ./cmd/tfbench -exact"
+cmp "$O/ear1-exact.txt" "$HOME/lab-bio4/go/verify/expected/exact.txt" && echo "ear1 exact: identical"
+run ear2-short "TF_EAR=2" "go test -short -count=1 ."
+run ear2-exact "TF_EAR=2" "go run ./cmd/tfbench -exact"
+diff "$O/ear2-exact.txt" "$HOME/lab-bio4/go/verify/expected/exact.txt"
+grep -n "^--- FAIL\|^FAIL\|panic" "$O"/ear*-*.txt "$O"/base-short.txt | head -60
