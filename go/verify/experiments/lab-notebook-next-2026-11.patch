diff --git a/lab/mawi/main.go b/lab/mawi/main.go
new file mode 100644
index 0000000..3d14a5b
--- /dev/null
+++ b/lab/mawi/main.go
@@ -0,0 +1,312 @@
+// Command mawi replays a MAWI pcap (gzipped) through Clepsydra and scores
+// VelocityCountAt against exact per-source counts (NEXT-RESULTS.md N13;
+// lab E10's method, rewritten). Usage: mawi <trace.pcap.gz>
+package main
+
+import (
+	"bufio"
+	"compress/gzip"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"math"
+	"math/rand/v2"
+	"os"
+	"sort"
+	"time"
+
+	tf "github.com/scooter-sensei/clepsydra/go"
+)
+
+const hTicks = 60_000
+
+var wins = []uint64{1_000, 5_000, 15_000, 30_000, 60_000}
+
+// mix64 is the package's (go/slots.go), as E10 keyed sources.
+func mix64(x uint64) uint64 {
+	x ^= x >> 30
+	x *= 0xbf58476d1ce4e5b9
+	x ^= x >> 27
+	x *= 0x94d049bb133111eb
+	return x ^ x>>31
+}
+
+// each calls fn(src, tick) for every IPv4 packet: tick = ms since the
+// first packet + 1.
+func each(path string, fn func(src uint32, tick uint64)) (pkts, v4 uint64) {
+	fh, err := os.Open(path)
+	if err != nil {
+		panic(err)
+	}
+	defer fh.Close()
+	gz, err := gzip.NewReader(bufio.NewReaderSize(fh, 1<<22))
+	if err != nil {
+		panic(err)
+	}
+	r := bufio.NewReaderSize(gz, 1<<22)
+	var gh [24]byte
+	if _, err := io.ReadFull(r, gh[:]); err != nil {
+		panic(err)
+	}
+	var bo binary.ByteOrder = binary.LittleEndian
+	nano := false
+	switch binary.LittleEndian.Uint32(gh[:]) {
+	case 0xa1b2c3d4:
+	case 0xa1b23c4d:
+		nano = true
+	case 0xd4c3b2a1:
+		bo = binary.BigEndian
+	case 0x4d3cb2a1:
+		bo, nano = binary.BigEndian, true
+	default:
+		panic("not a pcap")
+	}
+	if lt := bo.Uint32(gh[20:]); lt != 1 {
+		panic(fmt.Sprintf("link type %d, want Ethernet", lt))
+	}
+	var rh [16]byte
+	buf := make([]byte, 1<<16)
+	var limit uint64 // MAWI_MAX: stop after this many packets (smoke tests)
+	fmt.Sscan(os.Getenv("MAWI_MAX"), &limit)
+	var t0 uint64
+	for {
+		if _, err := io.ReadFull(r, rh[:]); err != nil {
+			if err == io.EOF {
+				return
+			}
+			panic(err)
+		}
+		sec, sub, incl := uint64(bo.Uint32(rh[0:])), uint64(bo.Uint32(rh[4:])), int(bo.Uint32(rh[8:]))
+		p := buf[:incl]
+		if _, err := io.ReadFull(r, p); err != nil {
+			panic(err)
+		}
+		pkts++
+		if limit > 0 && pkts > limit {
+			return
+		}
+		us := sec*1_000_000 + sub
+		if nano {
+			us = sec*1_000_000 + sub/1000
+		}
+		if pkts == 1 {
+			t0 = us
+		}
+		if len(p) < 14 {
+			continue
+		}
+		et, off := binary.BigEndian.Uint16(p[12:]), 14
+		if et == 0x8100 && len(p) >= 18 {
+			et, off = binary.BigEndian.Uint16(p[16:]), 18
+		}
+		if et != 0x0800 || len(p) < off+20 || p[off]>>4 != 4 {
+			continue
+		}
+		v4++
+		fn(binary.BigEndian.Uint32(p[off+12:]), (us-t0)/1000+1)
+	}
+}
+
+type src struct {
+	t    []uint32 // packet ticks within the last 60 s (from h)
+	h    int
+	inAc bool
+}
+
+func (s *src) count(q, w uint64) int { // packets at ticks in [q-w, q]
+	ts := s.t[s.h:]
+	lo := uint64(0)
+	if q > w {
+		lo = q - w
+	}
+	i := sort.Search(len(ts), func(j int) bool { return uint64(ts[j]) >= lo })
+	k := sort.Search(len(ts), func(j int) bool { return uint64(ts[j]) > q })
+	return k - i
+}
+
+type score struct {
+	err, ex [5]float64
+	n       [5]int
+}
+
+func (s *score) add(wi, est, exact int) {
+	s.err[wi] += math.Abs(float64(est - exact))
+	s.ex[wi] += float64(exact)
+	s.n[wi]++
+}
+
+func (s *score) line(name string) string {
+	l, m, q := fmt.Sprintf("%-28s", name), 0.0, ""
+	for wi := range 5 {
+		v := s.err[wi] / s.ex[wi]
+		l += fmt.Sprintf(" %8.4f", v)
+		m += v / 5
+		q += fmt.Sprintf(" %.3f", s.err[wi]/float64(max(s.n[wi], 1)))
+	}
+	return l + fmt.Sprintf(" %8.4f  | mean |err| per query:%s", m, q)
+}
+
+// N20: HEAD's register geometry (go/register.go), for model registers.
+var (
+	gUnit    = uint64(2500)
+	gLogStep = [7]uint{0, 0, 1, 2, 3, 3, 3}
+	gOff     = [7]int64{0, 1, 2, 4, 8, 16, 24}
+)
+
+// modelReg is the source's register at its last packet: the counts of its
+// packets in each bucket at the epoch of last's unit (uncapped; without
+// bump's reset after an idle horizon).
+func (s *src) modelReg() (last, e uint64, c [7]uint64) {
+	ts := s.t[s.h:]
+	last = uint64(ts[len(ts)-1])
+	e = last / gUnit
+	hi := len(ts)
+	for j := range 7 {
+		start := int64(e)&^(1<<gLogStep[j]-1) - gOff[j]
+		lo := 0
+		if start > 0 {
+			b := uint64(start) * gUnit
+			lo = sort.Search(hi, func(i int) bool { return uint64(ts[i]) >= b })
+		}
+		c[j] = uint64(hi - lo)
+		hi = lo
+	}
+	return
+}
+
+func main() {
+	var recW *bufio.Writer
+	if len(os.Args) > 3 && os.Args[1] == "-records" { // N20: model registers of the uniform queries
+		fh, err := os.Create(os.Args[2])
+		if err != nil {
+			panic(err)
+		}
+		defer fh.Close()
+		recW = bufio.NewWriterSize(fh, 1<<20)
+		defer recW.Flush()
+		os.Args = append(os.Args[:1], os.Args[3:]...)
+	}
+	keep := uint64(hTicks)
+	if recW != nil {
+		keep = 2 * hTicks
+	}
+	path := os.Args[1]
+	t0 := time.Now()
+	seen := map[uint32]struct{}{}
+	pkts, v4 := each(path, func(s uint32, _ uint64) { seen[s] = struct{}{} })
+	distinct := len(seen)
+	seen = nil
+	fmt.Printf("pass 1: %d packets, %d IPv4, %d distinct sources (%s)\n", pkts, v4, distinct, time.Since(t0).Round(time.Second))
+	capacity := int(float64(distinct) / 0.85)
+	f, err := tf.New(tf.Config{Capacity: capacity, Horizon: time.Minute, Resolution: time.Millisecond})
+	if err != nil {
+		panic(err)
+	}
+	rng := rand.New(rand.NewPCG(1, 1))
+	srcs := map[uint32]*src{}
+	var act []uint32
+	var latest uint32
+	var qa, qb score
+	type qrec struct {
+		rate       int32
+		wi         int8
+		est, exact int32
+	}
+	var recs []qrec
+	zero := 0
+	sat := 0
+	next := uint64(hTicks + 1)
+	query := func(q uint64) {
+		wa := rng.IntN(5)
+		s := srcs[latest]
+		r := f.VelocityCountAt(mix64(uint64(latest)), wins[wa], q)
+		qa.add(wa, r, s.count(q, wins[wa]))
+		// (b) a source drawn uniformly among those active in the last 60 s
+		var b uint32
+		for {
+			i := rng.IntN(len(act))
+			b = act[i]
+			sb := srcs[b]
+			if len(sb.t) > sb.h && uint64(sb.t[len(sb.t)-1])+hTicks >= q {
+				break
+			}
+			sb.inAc = false
+			act[i] = act[len(act)-1]
+			act = act[:len(act)-1]
+		}
+		wb := rng.IntN(5)
+		sb := srcs[b]
+		eb := sb.count(q, wins[wb])
+		rb := f.CountAt(mix64(uint64(b)), wins[wb], q)
+		if rb.Saturated {
+			sat++
+		}
+		est := f.VelocityCountAt(mix64(uint64(b)), wins[wb], q)
+		qb.add(wb, est, eb)
+		if eb == 0 {
+			zero++
+		}
+		recs = append(recs, qrec{int32(sb.count(q, hTicks)), int8(wb), int32(est), int32(eb)})
+		if recW != nil {
+			last, e, c := sb.modelReg()
+			var b [8 * 12]byte
+			for i, x := range []uint64{q, wins[wb], uint64(eb), last, e, c[0], c[1], c[2], c[3], c[4], c[5], c[6]} {
+				binary.LittleEndian.PutUint64(b[8*i:], x)
+			}
+			recW.Write(b[:])
+		}
+	}
+	each(path, func(ip uint32, tick uint64) {
+		for next < tick {
+			query(next)
+			next++
+		}
+		f.CheckAndTouchAt(mix64(uint64(ip)), 0, tick)
+		s := srcs[ip]
+		if s == nil {
+			s = &src{}
+			srcs[ip] = s
+		}
+		for s.h < len(s.t) && uint64(s.t[s.h])+keep < tick {
+			s.h++
+		}
+		if s.h > 64 && s.h > len(s.t)/2 {
+			s.t = append(s.t[:0], s.t[s.h:]...)
+			s.h = 0
+		}
+		s.t = append(s.t, uint32(tick))
+		if !s.inAc {
+			s.inAc = true
+			act = append(act, ip)
+		}
+		latest = ip
+	})
+	fmt.Printf("pass 2 done (%s): capacity %d, bytes %d, evictions %d, promoted %d, hot refused %d\n",
+		time.Since(t0).Round(time.Second), capacity, f.Bytes(), f.Evictions(), f.Promoted(), f.HotRefused())
+	fmt.Printf("%-28s %8s %8s %8s %8s %8s %8s\n", "query", "1s", "5s", "15s", "30s", "60s", "mean")
+	fmt.Println(qa.line("(a) traffic-weighted"))
+	fmt.Println(qb.line("(b) uniform over active"))
+	fmt.Printf("queries per window (a) %v (b) %v; (b) exact 0 in %.1f%%, Saturated %d\n", qa.n, qb.n, 100*float64(zero)/float64(len(recs)), sat)
+	sort.SliceStable(recs, func(i, j int) bool { return recs[i].rate < recs[j].rate })
+	// also by the source's 60 s count in classes (added after a smoke run on
+	// the first 15 M packets showed deciles 1-8 all one-packet sources)
+	for _, cl := range [][2]int32{{1, 1}, {2, 3}, {4, 15}, {16, 63}, {64, 255}, {256, 1 << 30}} {
+		var s score
+		k := 0
+		for _, r := range recs {
+			if r.rate >= cl[0] && r.rate <= cl[1] {
+				s.add(int(r.wi), int(r.est), int(r.exact))
+				k++
+			}
+		}
+		fmt.Println(s.line(fmt.Sprintf("(c') %d-%d /60s, %.1f%%", cl[0], min(cl[1], 99999), 100*float64(k)/float64(max(len(recs), 1)))))
+	}
+	for d := range 10 * min(1, len(recs)/10) {
+		part := recs[d*len(recs)/10 : (d+1)*len(recs)/10]
+		var s score
+		for _, r := range part {
+			s.add(int(r.wi), int(r.est), int(r.exact))
+		}
+		fmt.Println(s.line(fmt.Sprintf("(c) decile %d [%d-%d /60s]", d+1, part[0].rate, part[len(part)-1].rate)))
+	}
+}
diff --git a/lab/n2.sh b/lab/n2.sh
new file mode 100755
index 0000000..0dd4eba
--- /dev/null
+++ b/lab/n2.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+# N2: the six speed candidates of SPEED-RESULTS.md, alone and stacked, under
+# go1.27.3. Every arm also carries speed-b1-labbench and speed-s3-labbench
+# (benchmarks only: LabContainsAbsentBig, LabGhostAdd).
+#   lab/n2.sh arms            print the arms (name=spec)
+#   lab/n2.sh cg [Bench...]   the cachegrind matrix -> lab/readings/n2-cg.txt
+#   lab/n2.sh s7              S7's timing rounds (LabHashUint64s batch64 vs scalar64)
+#   lab/n2.sh table           libIr/op per arm and benchmark, deltas, additivity
+set -euo pipefail
+. "$(dirname "$0")/common.sh"
+X=verify/experiments
+L="+$X/speed-b1-labbench.patch+$X/speed-s3-labbench.patch"
+S5=+$X/speed-s5-bce-inline.patch B1C=+$X/speed-b1c-dispbitmap-reads.patch S2D=+$X/speed-s2c-ghost-swar-count.patch
+S4B=+$X/speed-s4-mass-noview.patch S3=+$X/speed-s3-ghost-add-words.patch S7=+$X/speed-s7-siphash-avx512.patch
+BASE=${N2_BASE:-cedeefd}
+ARMS=(
+	"main=$BASE$L" "s5=$BASE$S5$L" "b1c=$BASE$B1C$L" "s2d=$BASE$S2D$L" "s4b=$BASE$S4B$L" "s3=$BASE$S3$L" "s7=$BASE$S7$L"
+	"stack=$BASE$S5$B1C$S2D$S4B$S3$S7$L" "stack-s4b=$BASE$S5$B1C$S2D$S3$S7$L" "stack4=$BASE$S5$S4B$S3$S7$L"
+)
+BENCH=(CheckAndTouchHit CheckAndTouchHitCached TouchAndCount VelocityCount InsertSteady ContainsAbsent
+	CheckAndTouchMissInsert InsertSaturated CountOverflowLive TouchOverflowLive InsertNearFull LabGhostAdd LabContainsAbsentBig)
+OUT=$ROOT/lab/readings/n2-cg.txt
+case $1 in
+arms) printf '%s\n' "${ARMS[@]}" ;;
+cg) shift; [ $# -gt 0 ] || set -- "${BENCH[@]}"; mkdir -p "$(dirname "$OUT")"; "$ROOT/lab/cgm.sh" "$OUT" "${ARMS[@]}" -- "$@" ;;
+s7) # S7's timing branch: 6 alternated rounds of batch64 / scalar64, 1 s each
+	bin=$LAB/bin/s7lab.test
+	[ -x "$bin" ] || { arm_src "$BASE$S7+$X/speed-s7-labbench.patch" "$LAB/src-s7lab"; (cd "$LAB/src-s7lab" && go test -c -o "$bin" .); }
+	for r in 1 2 3 4 5 6; do
+		o="batch64 scalar64"; [ $((r % 2)) = 1 ] || o="scalar64 batch64"
+		for sub in $o; do "$bin" -test.run '^$' -test.bench "^BenchmarkLabHashUint64s/$sub\$" -test.benchtime 1s | awk -v r=$r '/^Benchmark/ { print "round", r, $1, $3, $4 }'; done
+	done ;;
+table)
+	awk -v arms="main s5 b1c s2d s4b s3 s7 stack stack-s4b stack4" -v singles="s5 b1c s2d s4b s3 s7" '
+	{ v[$1, $2] = $10; ll[$1, $2] = $14; bs[$2] = 1 }
+	END {
+		na = split(arms, A, " "); ns = split(singles, S, " ")
+		printf "%-24s", "libIr/op"; for (i = 1; i <= na; i++) printf " %10s", A[i]; printf " | sum singles  stack-main  additivity\n"
+		for (b in bs) {
+			printf "%-24s %10.2f", b, v["main", b]
+			for (i = 2; i <= na; i++) printf " %+9.2f%%", 100 * (v[A[i], b] / v["main", b] - 1)
+			s = 0; for (i = 1; i <= ns; i++) s += v[S[i], b] - v["main", b]
+			d = v["stack", b] - v["main", b]
+			printf " | %+9.2f %+11.2f  %s\n", s, d, s != 0 ? sprintf("%.2f", d / s) : "-"
+		}
+	}' "$OUT" | sort
+	;;
+esac
diff --git a/lab/pads.sh b/lab/pads.sh
