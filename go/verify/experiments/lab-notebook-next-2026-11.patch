new file mode 100755
index 0000000..aa4255b
--- /dev/null
+++ b/lab/cgm.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+# A cachegrind matrix: every arm x every benchmark through lab/cg.sh, CG_JOBS
+# at a time (default 4; cachegrind's counts don't depend on what else runs).
+#   lab/cgm.sh <out> <name=spec>... -- <Bench>...
+# Appends cg.sh's lines to <out> (an arm/bench pair already in <out> is skipped).
+set -euo pipefail
+. "$(dirname "$0")/common.sh"
+out=$1; shift
+arms=(); while [ "$1" != -- ]; do arms+=("$1"); shift; done; shift
+touch "$out"
+for a in "${arms[@]}"; do CG_NAME=${a%%=*} "$ROOT/lab/cg.sh" "${a#*=}" - ; done
+for a in "${arms[@]}"; do for b in "$@"; do
+	grep -q "^${a%%=*} $b " "$out" || printf '%s\t%s\t%s\n' "${a%%=*}" "${a#*=}" "$b"
+done; done | xargs -d '\n' -P "${CG_JOBS:-4}" -I{} bash -c 'IFS=$'"'"'\t'"'"' read -r n s b <<<"{}"; CG_NAME=$n "'"$ROOT"'/lab/cg.sh" "$s" "$b"' >>"$out"
diff --git a/lab/common.sh b/lab/common.sh
new file mode 100755
index 0000000..f62acbe
--- /dev/null
+++ b/lab/common.sh
@@ -0,0 +1,29 @@
+# Shared by lab/*.sh. LAB is the work directory (built binaries, traces,
+# raw readings); it does not survive the VM, everything worth keeping is
+# copied into the ledger.
+ROOT=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)
+GO=$ROOT/go
+LAB=${LAB:-$HOME/labwork}
+mkdir -p "$LAB"
+
+# arm_src <spec> <dir>: an arm's Go module in <dir>. A spec is a revision
+# (HEAD, main, a sha) or "." (the working tree), optionally followed by
+# +path/to.patch (relative to go/) one or more times, applied in order.
+arm_src() {
+	local spec=$1 d=$2 rev=${1%%+*} p patches
+	rm -rf "$d" && mkdir -p "$d"
+	if [ "$rev" = . ]; then
+		(cd "$GO" && git ls-files -co --exclude-standard -z . | xargs -0 tar -c) | tar -x -C "$d"
+	else
+		rm -rf "$d.x" && mkdir -p "$d.x" && git -C "$ROOT" archive "$rev" go | tar -x -C "$d.x"
+		rmdir "$d" && mv "$d.x/go" "$d" && rm -rf "$d.x"
+	fi
+	IFS=+ read -ra patches <<<"${spec#"$rev"}"
+	for p in "${patches[@]}"; do
+		[ -n "$p" ] || continue
+		(cd "$d" && git apply "$GO/$p") || { echo "arm_src: $p does not apply" >&2; return 1; }
+	done
+}
+
+# arm_name <spec>: a file-name-safe name for a spec.
+arm_name() { echo "$1" | sed 's#verify/experiments/##g; s#\.patch##g; s#[^A-Za-z0-9_.+-]#_#g'; }
diff --git a/lab/duet.sh b/lab/duet.sh
new file mode 100755
index 0000000..7d0f2a3
--- /dev/null
+++ b/lab/duet.sh
@@ -0,0 +1,86 @@
+#!/usr/bin/env bash
+# Duet benchmarking (Bulej et al., ICPE 2020): two arms run at the same time
+# on one VM, so interference hits both, and their ratio is read per round.
+#
+#   lab/duet.sh <specA> <specB|null> <layouts> <rounds> <Bench=N>...
+#
+# Specs as lab/common.sh's arm_src (HEAD, ., sha, +go-relative patches).
+# "null" as specB runs A's binaries against themselves. Each arm is built at
+# <layouts> code layouts (verify/lrab.sh's pads; SEED0=n uses layouts
+# n+1..n+<layouts>). Per round, layout and benchmark: both binaries start
+# together (a spin barrier), pinned with taskset to DUET_CPUS (default "1 2",
+# swapped on even rounds), GOMAXPROCS=1, -test.benchtime=<N>x; then, unless
+# SOLO=0, A alone on the first CPU of the pair (its solo ns/op). Prints per
+# benchmark: A's median duet and solo ns/op (duet/solo = how much two copies
+# slow each other), and B/A: geometric mean over rounds x layouts with a 95%
+# t-interval of the log ratios. Raw readings: $LAB/duet/<tag>.tsv.
+set -euo pipefail
+. "$(dirname "$0")/common.sh"
+. "$(dirname "$0")/pads.sh"
+[ $# -ge 5 ] || { sed -n '2,17p' "$0"; exit 2; }
+SA=$1 SB=$2 K=$3 R=$4
+shift 4
+read -ra CPUS <<<"${DUET_CPUS:-1 2}"
+S0=${SEED0:-0}
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$LAB/duet"
+tag=$(arm_name "$SA")-vs-$(arm_name "$SB")-$(date +%H%M%S)
+out=$LAB/duet/$tag.tsv
+build() { # build <spec> <name>
+	arm_src "$1" "$tmp/src"
+	for k in $(seq $((S0 + 1)) $((S0 + K))); do
+		cp -r "$tmp/src" "$tmp/t"
+		pad "$tmp/t" "$k"
+		(cd "$tmp/t" && go test -c -o "$tmp/$2-$k.test" .)
+		rm -rf "$tmp/t"
+	done
+	rm -rf "$tmp/src"
+}
+build "$SA" A
+if [ "$SB" = null ]; then
+	for k in $(seq $((S0 + 1)) $((S0 + K))); do cp "$tmp/A-$k.test" "$tmp/B-$k.test"; done
+else
+	build "$SB" B
+fi
+nsop() { awk '$1 ~ /^Benchmark/ { for (i = 3; i < NF; i++) if ($(i+1) == "ns/op") print $i }' "$1"; }
+run1() { # run1 <cpu> <bin> <bench> <n> <out>: waits for $tmp/go, then runs pinned
+	taskset -c "$1" env GOMAXPROCS=1 bash -c 'while [ ! -e "$0" ]; do :; done; exec "$@"' "$tmp/go" \
+		"$2" -test.run '^$' -test.bench "^Benchmark$3\$" -test.benchtime "${4}x" -test.count 1 >"$5" 2>&1
+}
+echo "# A=$SA B=$SB layouts $((S0 + 1))..$((S0 + K)) rounds $R cpus ${CPUS[*]} $*" | tee "$out"
+for r in $(seq "$R"); do
+	ca=${CPUS[0]} cb=${CPUS[1]}
+	[ $((r % 2)) = 1 ] || { ca=${CPUS[1]} cb=${CPUS[0]}; }
+	for k in $(seq $((S0 + 1)) $((S0 + K))); do
+		for bn in "$@"; do
+			b=${bn%%=*} n=${bn#*=}
+			rm -f "$tmp/go"
+			run1 "$ca" "$tmp/A-$k.test" "$b" "$n" "$tmp/oa" &
+			pa=$!
+			run1 "$cb" "$tmp/B-$k.test" "$b" "$n" "$tmp/ob" &
+			pb=$!
+			sleep 0.05
+			touch "$tmp/go"
+			wait "$pa" "$pb"
+			sa=- ; [ "${SOLO:-1}" = 0 ] || { touch "$tmp/go"; run1 "$ca" "$tmp/A-$k.test" "$b" "$n" "$tmp/os"; sa=$(nsop "$tmp/os"); }
+			printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$r" "$k" "$b" "$(nsop "$tmp/oa")" "$(nsop "$tmp/ob")" "$sa" >>"$out"
+		done
+	done
+done
+awk -F'\t' '
+function med(arr, n,   i, j, t) { for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) if (arr[j] < arr[i]) { t = arr[i]; arr[i] = arr[j]; arr[j] = t } return n % 2 ? arr[(n + 1) / 2] : (arr[n / 2] + arr[n / 2 + 1]) / 2 }
+function t95(df) { return df >= 30 ? 2.04 : T[df] }
+BEGIN { split("12.71 4.30 3.18 2.78 2.57 2.45 2.36 2.31 2.26 2.23 2.20 2.18 2.16 2.14 2.13 2.12 2.11 2.10 2.09 2.09 2.08 2.07 2.07 2.06 2.06 2.06 2.05 2.05 2.05", T, " ") }
+/^#/ { next }
+{ b = $3; c = ++n[b]; d[b, c] = $4; l = log($5 / $4); s[b] += l; ss[b] += l * l
+  if ($6 != "-") { m = ++ns[b]; so[b, m] = $6 } }
+END {
+	for (b in n) {
+		c = n[b]; for (i = 1; i <= c; i++) x[i] = d[b, i]; md = med(x, c)
+		mean = s[b] / c; v = c > 1 ? (ss[b] - c * mean * mean) / (c - 1) : 0; h = v > 0 ? t95(c - 1) * sqrt(v / c) : 0
+		sol = "-"; if (ns[b]) { for (i = 1; i <= ns[b]; i++) y[i] = so[b, i]; sm = med(y, ns[b]); sol = sprintf("%.1f (duet/solo %.3f)", sm, md / sm) }
+		printf "%-28s n=%d  A duet %.1f ns/op, solo %s | B/A %.4f [%.4f, %.4f]\n", b, c, md, sol, exp(mean), exp(mean - h), exp(mean + h)
+	}
+}' "$out" | sort
+echo "raw: $out"
diff --git a/lab/fd.sh b/lab/fd.sh
new file mode 100755
index 0000000..e77048f
--- /dev/null
+++ b/lab/fd.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+# Strict false denies, lab E6b's non-inferiority method.
+#   lab/fd.sh <specA> <specB> <flood> [rounds]     (default 10 rounds)
+# Per round: `h2h run -pass acc` of each arm (order reversed on even rounds),
+# then `h2h falsedeny` on its answers (false denies of the population).
+# Prints per round A, B, B-A; then mean(B-A) and its 95% paired t-interval.
+set -euo pipefail
+. "$(dirname "$0")/common.sh"
+A=$1 B=$2 F=$3 R=${4:-10}
+build() { local a; a=$(arm_name "$1")-$(git -C "$ROOT" rev-parse --short "${1%%+*}"); mkdir -p "$LAB/bin"
+	[ -x "$LAB/bin/h2h-$a" ] || { arm_src "$1" "$LAB/src-$a"; (cd "$LAB/src-$a" && go build -o "$LAB/bin/h2h-$a" ./cmd/h2h); }
+	echo "$LAB/bin/h2h-$a"; }
+ba=$(build "$A"); bb=$(build "$B")
+tr=$LAB/h2h/$F.trace
+fd() { "$1" run -trace "$tr" -pass acc -answers "$LAB/fd.ans" >/dev/null; "$1" falsedeny -trace "$tr" -answers "$LAB/fd.ans" | awk '{print $1}'; }
+for r in $(seq "$R"); do
+	if [ $((r % 2)) = 1 ]; then x=$(fd "$ba"); y=$(fd "$bb"); else y=$(fd "$bb"); x=$(fd "$ba"); fi
+	echo "round $r A $x B $y d $((y - x))"
+done | tee "$LAB/fd-$F.txt"
+awk '{ d = $NF; s += d; ss += d * d; n++ } END { m = s / n; sd = n > 1 ? sqrt((ss - n * m * m) / (n - 1)) : 0; t = (n == 10 ? 2.262 : 2.0); h = t * sd / sqrt(n); printf "mean(B-A) %+.2f [%+.2f, %+.2f] (n %d)\n", m, m - h, m + h, n }' "$LAB/fd-$F.txt"
diff --git a/lab/flood.sh b/lab/flood.sh
new file mode 100755
index 0000000..292c2fd
--- /dev/null
+++ b/lab/flood.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# Flood pairs at a quarter of the paper's scale (SPEED-RESULTS.md Batch 0).
+#   lab/flood.sh gen                       write the traces to $LAB/h2h (-n 65536)
+#   lab/flood.sh <specA> <specB> <flood> [pairs]   (default 6 pairs)
+# One h2h binary per arm; pairs of `h2h run -pass t1` on one trace, arms
+# alternating, order reversed on even pairs. Prints Mops/s per run and B/A per pair.
+set -euo pipefail
+. "$(dirname "$0")/common.sh"
+if [ "$1" = gen ]; then
+	mkdir -p "$LAB/h2h" && (cd "$GO" && go run ./cmd/h2h gen -dir "$LAB/h2h" -n 65536)
+	ls -la "$LAB/h2h"; exit 0
+fi
+A=$1 B=$2 F=$3 P=${4:-6}
+build() { local a; a=$(arm_name "$1")-$(git -C "$ROOT" rev-parse --short "${1%%+*}"); mkdir -p "$LAB/bin"
+	[ -x "$LAB/bin/h2h-$a" ] || { arm_src "$1" "$LAB/src-$a"; (cd "$LAB/src-$a" && go build -o "$LAB/bin/h2h-$a" ./cmd/h2h); }
+	echo "$LAB/bin/h2h-$a"; }
+ba=$(build "$A"); bb=$(build "$B")
+tr=$LAB/h2h/$F.trace
+mops() { "$1" run -trace "$tr" -pass t1 | sed -n 's/.*"mops":\([0-9.]*\).*/\1/p'; }
+for p in $(seq "$P"); do
+	if [ $((p % 2)) = 1 ]; then x=$(mops "$ba"); y=$(mops "$bb"); else y=$(mops "$bb"); x=$(mops "$ba"); fi
+	awk -v p="$p" -v x="$x" -v y="$y" 'BEGIN { printf "pair %d A %.3f B %.3f B/A %.3f\n", p, x, y, y / x }'
+done
