+#!/usr/bin/env bash
+# A6: re-run Batch 6's cheap deterministic readings on origin/main + each patch.
+#   lab/a6-repro.sh <rev>     (default origin/main); output in $LAB/a6/<item>.txt
+set -uo pipefail
+. "$(dirname "$0")/common.sh"
+rev=${1:-origin/main}
+out=$LAB/a6; mkdir -p "$out"
+run() { # item patch test-regex env...
+	local item=$1 p=$2 re=$3; shift 3
+	local d=$LAB/a6/src-$item
+	arm_src "$rev+verify/experiments/$p.patch" "$d" || { echo "$item: patch does not apply" >"$out/$item.txt"; return; }
+	(cd "$d" && env "$@" go test -count=1 -run "$re" -v . >"$out/$item.txt" 2>&1; echo "exit $?" >>"$out/$item.txt")
+}
+run n14 next-n14-resize '^TestResize$' TF_EXP=1 &
+run n15 next-n15-merge-all '^TestMergeAll$' TF_EXP=1 &
+run n17 next-n17-colocation '^TestColocation$' TF_EXP=1 &
+run n19 next-n19-decayed '^TestDecayedRate$' TF_EXP=1 &
+wait
+run n16 next-n16-snapshot '^(TestLabSnapshot|TestSnapshotCorrupt|TestSnapshotSize.*)$' TF_EXP=1 TF_LAB=1 &
+run n20 next-n20-fitted-cut '^TestFittedCut$' TF_EXP=1 &
+wait
diff --git a/lab/cg.sh b/lab/cg.sh
new file mode 100755
index 0000000..f33dd9f
--- /dev/null
+++ b/lab/cg.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Cachegrind per-op counts (SPEED-RESULTS.md Batch 0's method).
+#   lab/cg.sh <arm-spec> <Benchmark> [n1 n2]     (default 50000 150000)
+# Prints: arm bench Ir/op D1/op LL/op libIr/op libD1/op libLL/op, where X/op = (X(n2)-X(n1))/(n2-n1)
+# and libIr/libD1 count only this module's functions (package clepsydra and its
+# internal packages). The arm's test binary is built once and cached in
+# $LAB/bin/<arm>.test (CG_REBUILD=1 rebuilds; CG_NAME names the arm; Bench "-"
+# only builds).
+set -euo pipefail
+. "$(dirname "$0")/common.sh"
+spec=$1 B=$2 n1=${3:-50000} n2=${4:-150000}
+a=${CG_NAME:-$(arm_name "$spec")}
+mkdir -p "$LAB/bin" "$LAB/cg"
+bin=$LAB/bin/$a.test
+if [ ! -x "$bin" ] || [ "${CG_REBUILD:-0}" = 1 ]; then
+	arm_src "$spec" "$LAB/src-$a"
+	(cd "$LAB/src-$a" && go test -c -o "$bin" .)
+fi
+[ "$B" != - ] || exit 0
+one() { # one <n>: totals "Ir D1 LL libIr"
+	local out=$LAB/cg/$a.${B//\//_}.$1.out
+	GOGC=off GODEBUG=asyncpreemptoff=1 GOMAXPROCS=1 valgrind --tool=cachegrind --cache-sim=yes \
+		--LL=33554432,16,64 --cachegrind-out-file="$out" "$bin" -test.run '^$' \
+		-test.bench "^Benchmark$B\$" -test.benchtime "${1}x" -test.count 1 >/dev/null 2>&1
+	awk '
+	/^events:/ { for (i = 2; i <= NF; i++) col[$i] = i - 1 }
+	/^fn=/ { lib = ($0 ~ /clepsydra/) }
+	/^[0-9]/ { ir += $(col["Ir"]+1); d1 += $(col["D1mr"]+1) + $(col["D1mw"]+1); ll += $(col["DLmr"]+1) + $(col["DLmw"]+1); if (lib) { lir += $(col["Ir"]+1); ld1 += $(col["D1mr"]+1) + $(col["D1mw"]+1); lll += $(col["DLmr"]+1) + $(col["DLmw"]+1) } }
+	END { printf "%d %d %d %d %d %d\n", ir, d1, ll, lir, ld1, lll }' "$out"
+}
+read -r i1 d1 l1 b1 e1 f1 < <(one "$n1")
+read -r i2 d2 l2 b2 e2 f2 < <(one "$n2")
+awk -v a="$a" -v b="$B" -v n="$((n2 - n1))" -v i1="$i1" -v i2="$i2" -v d1="$d1" -v d2="$d2" -v l1="$l1" -v l2="$l2" -v b1="$b1" -v b2="$b2" -v e1="$e1" -v e2="$e2" -v f1="$f1" -v f2="$f2" \
+	'BEGIN { printf "%s %s Ir/op %.2f D1/op %.4f LL/op %.4f libIr/op %.2f libD1/op %.4f libLL/op %.4f\n", a, b, (i2-i1)/n, (d2-d1)/n, (l2-l1)/n, (b2-b1)/n, (e2-e1)/n, (f2-f1)/n }'
