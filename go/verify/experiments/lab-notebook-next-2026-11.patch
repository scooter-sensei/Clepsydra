+#!/usr/bin/env bash
+# The three gates (repository rules), from go/ of the working tree, timed.
+#   lab/gates.sh            all three; exit non-zero if any fails or differs
+#   lab/gates.sh <dir>      the same in another module directory (an arm's tree)
+set -uo pipefail
+. "$(dirname "$0")/common.sh"
+cd "${1:-$GO}"
+bad=0
+t=$(date +%s); ./test.sh sanity >"$LAB/gate-sanity.log" 2>&1 && r=pass || { r=FAIL; bad=1; }
+echo "sanity: $r ($(( $(date +%s) - t )) s)"
+t=$(date +%s)
+TF_EXP=1 go test -count=1 -run '^TestAnswerDigest$' -v . 2>&1 | grep '^cell ' >"$LAB/gate-digest.txt"
+if diff "$LAB/gate-digest.txt" "$GO/verify/expected/answer-digest.txt" >"$LAB/gate-digest.diff"; then r="no diff"; else r="DIFF ($(grep -c '^<' "$LAB/gate-digest.diff") cells)"; bad=1; fi
+echo "answer digest ($(wc -l <"$LAB/gate-digest.txt") cells): $r ($(( $(date +%s) - t )) s)"
+t=$(date +%s)
+go run ./cmd/tfbench -exact >"$LAB/gate-exact.txt" 2>&1
+if diff "$LAB/gate-exact.txt" "$GO/verify/expected/exact.txt" >"$LAB/gate-exact.diff"; then r="no diff"; else r="DIFF ($(grep -c '^<' "$LAB/gate-exact.diff") lines)"; bad=1; fi
+echo "tfbench -exact ($(wc -l <"$LAB/gate-exact.txt") lines): $r ($(( $(date +%s) - t )) s)"
+exit $bad
diff --git a/lab/ledger.py b/lab/ledger.py
new file mode 100644
index 0000000..b34da22
--- /dev/null
+++ b/lab/ledger.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Anchored edits of NEXT-RESULTS.md; every edit asserts its anchor is found
+exactly once (a silent miss left the status block and summary table stale
+from N2 to N20b).
+
+  ledger.py status <file>            replace the Status block's body
+  ledger.py row <id> <line>          replace the summary row starting "| <id> ",
+                                     or append it to the table if absent
+  ledger.py section <title> <file>   replace section "## <title>" (to the next
+                                     "## "), or append it at the end if absent
+  ledger.py replace <old> <new>      replace text (files) found exactly once
+"""
+import os, re, sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+PATH = os.path.join(ROOT, "NEXT-RESULTS.md")
+
+
+def read(p):
+    with open(p) as f:
+        return f.read()
+
+
+def once(text, needle, what):
+    n = text.count(needle)
+    if n != 1:
+        sys.exit(f"ledger: {what}: anchor found {n} times, want 1")
+
+
+def main(a):
+    t = read(PATH)
+    if a[0] == "status":
+        body = read(a[1]).rstrip("\n") + "\n\n"
+        once(t, "## Status\n\n", "status")
+        once(t, "\n## Summary\n", "summary")
+        i = t.index("## Status\n\n") + len("## Status\n\n")
+        j = t.index("## Summary\n")
+        t = t[:i] + body + t[j:]
+    elif a[0] == "row":
+        rid, line = a[1], a[2].rstrip("\n")
+        assert line.startswith("| ") and line.endswith(" |"), "row: not a table row"
+        rows = [m for m in re.finditer(r"^\| " + re.escape(rid) + r" .*$", t, re.M)]
+        if len(rows) > 1:
+            sys.exit(f"ledger: row {rid}: {len(rows)} rows match")
+        if rows:
+            m = rows[0]
+            t = t[: m.start()] + line + t[m.end():]
+        else:
+            once(t, "\n\n## Host\n", "table end")
+            t = t.replace("\n\n## Host\n", "\n" + line + "\n\n## Host\n")
+    elif a[0] == "section":
+        title, body = a[1], read(a[2]).rstrip("\n") + "\n"
+        head = "\n## " + title + "\n"
+        n = t.count(head)
+        if n > 1:
+            sys.exit(f"ledger: section {title}: {n} found")
+        if n == 1:
+            i = t.index(head) + 1
+            j = t.find("\n## ", i + 1)
+            j = len(t) if j < 0 else j + 1
+            t = t[:i] + body + ("\n" if j < len(t) else "") + t[j:]
+        else:
+            t = t.rstrip("\n") + "\n\n" + body
+    elif a[0] == "replace":
+        old, new = read(a[1]), read(a[2])
+        once(t, old, "replace")
+        t = t.replace(old, new)
+    else:
+        sys.exit(__doc__)
+    with open(PATH, "w") as f:
+        f.write(t)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:] or ["?"])
