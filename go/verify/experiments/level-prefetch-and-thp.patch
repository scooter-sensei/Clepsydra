+// warmAlts2 (experiment) loads the alternate line of every entry in the
+// alternate lines of lines' entries: the second level of the cuckoo search.
+func (f *Filter) warmAlts2(lines [2]uint64) {
+	var sink uint64
+	for _, line := range lines {
+		base := int(line * wordsPerLine)
+		for s := 0; s < wordsPerLine; s += 2 {
+			w0 := atomic.LoadUint64(&f.words[base+s])
+			if w0 == 0 {
+				continue
+			}
+			a := f.alt(line, w0>>48)
+			ab := int(a * wordsPerLine)
+			for t := 0; t < wordsPerLine; t += 2 {
+				if x := atomic.LoadUint64(&f.words[ab+t]); x != 0 {
+					sink += atomic.LoadUint64(&f.words[f.alt(a, x>>48)*wordsPerLine])
+				}
+			}
+		}
+	}
+	runtime.KeepAlive(sink)
+}
