+package temporalfilter
+
+import (
+	"os"
+	"sort"
+	"testing"
+	"time"
+
+	"github.com/scooter-sensei/clepsydra/go/internal/workload"
+)
+
+// TestAltChunkInvolution: every arm's alt is its own inverse and stays in
+// the table, on table sizes that are and aren't multiples of the chunk.
+func TestAltChunkInvolution(t *testing.T) {
+	for _, lines := range []uint64{2, 63, 64, 65, 127, 1000, 58824} {
+		for _, l := range [][4]uint64{{64, 64, 64, 64}, {32768, 32768, 32768, 32768}, {0, 128, 32, 16}, {lines, 7, 3, 2}} {
+			f := &Filter{lines: lines, altL: l}
+			for line := range lines {
+				for fp := uint64(1); fp < 200; fp++ {
+					a := f.alt(line, fp)
+					if a >= lines || f.alt(a, fp) != line {
+						t.Fatalf("lines %d L %v: alt(%d, %d) = %d, back %d", lines, l, line, fp, a, f.alt(a, fp))
+					}
+				}
+			}
+		}
+	}
+}
+
+// TestLocalAltPages (TF_EXP=1; N5): distinct 4 KiB groups of table lines
+// (line >> 6) per cuckoo search on tfbench's churn stream at the three
+// loads, under the arm TF_ALT selects.
+func TestLocalAltPages(t *testing.T) {
+	if os.Getenv("TF_EXP") == "" {
+		t.Skip("set TF_EXP=1")
+	}
+	const capacity, hTicks = 200_000, 60_000
+	defer func() { testHookSearch = nil }()
+	for _, c := range []struct {
+		load float64
+		seed uint64
+	}{{1.0, 2}, {1.1, 3}, {1.15, 4}} {
+		f, _ := New(Config{Capacity: capacity, Horizon: time.Minute, Resolution: time.Millisecond})
+		var per []int
+		pages := map[uint64]bool{}
+		flush := func() {
+			if len(pages) > 0 {
+				per = append(per, len(pages))
+				clear(pages)
+			}
+		}
+		testHookSearch = func(line uint64, start bool) {
+			if start {
+				flush()
+			}
+			pages[line>>6] = true
+		}
+		workload.Churn(c.load, c.seed, capacity, hTicks, mix64, func(h, w, now uint64) { f.CheckAndTouchAt(h, w, now) })
+		flush()
+		sort.Ints(per)
+		sum := 0
+		for _, v := range per {
+			sum += v
+		}
+		mean := float64(sum) / float64(max(1, len(per)))
+		q := func(p float64) int {
+			if len(per) == 0 {
+				return 0
+			}
+			return per[min(len(per)-1, int(p*float64(len(per))))]
+		}
+		t.Logf("TF_ALT=%q altL=%v load %.2f: searches %d, pages per search mean %.3f p50 %d p99 %d max %d; evictions %d relocations %d",
+			os.Getenv("TF_ALT"), f.altL, c.load, len(per), mean, q(0.5), q(0.99), q(1), f.Evictions(), f.Relocations())
+	}
+}
