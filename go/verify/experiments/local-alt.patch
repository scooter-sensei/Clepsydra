+package temporalfilter
+
+import (
+	"math"
+	"math/bits"
+	"os"
+	"strconv"
+)
+
+// NEXT-RESULTS.md N5: alternate lines restricted to a chunk of L lines.
+// TF_ALT (read at New) picks the arm: unset, HEAD's alt over the whole
+// table; a number L, chunks of L lines for every fingerprint; "vacuum",
+// four fingerprint groups (low two bits) with Vacuum filters' range
+// selection (Wang et al., PVLDB 2019, Algorithms 1-3: alpha 0.95, the
+// smallest range doubled). The last full chunk takes the table's remainder,
+// so every chunk has at least L lines and alt stays its own inverse.
+func altChunks(lines uint64) (l [4]uint64) {
+	v := os.Getenv("TF_ALT")
+	if v == "" {
+		return l
+	}
+	if v == "vacuum" {
+		for i := range 4 {
+			l[i] = rangeSelection(lines, 0.95, 1-float64(i)/4)
+		}
+		l[3] *= 2
+		return l
+	}
+	n, err := strconv.ParseUint(v, 10, 64)
+	if err != nil || n == 0 {
+		panic("TF_ALT: a line count or vacuum")
+	}
+	return [4]uint64{n, n, n, n}
+}
+
+// rangeSelection is Vacuum filters' Algorithm 2 over Algorithm 1 with
+// slotsPerLine slots per line: the smallest power of two L for which
+// N = slots*r*m*alpha items over m/L chunks have an estimated maximum load
+// below 0.97 of a chunk's slots (L >= m: the whole table).
+func rangeSelection(m uint64, alpha, r float64) uint64 {
+	for l := uint64(1); ; l *= 2 {
+		c := float64(m / l)
+		if c <= 1 {
+			return l
+		}
+		n := slotsPerLine * r * float64(m) * alpha / c
+		if n+1.5*math.Sqrt(2*n*math.Log(c)) < 0.97*slotsPerLine*float64(l) {
+			return l
+		}
+	}
+}
+
+// altChunk is alt within line's chunk of l lines (the last full chunk
+// holding the remainder): (x - i) mod size from the chunk's start.
+func (f *Filter) altChunk(line, fp, l uint64) uint64 {
+	nfull := f.lines / l
+	c := min(line/l, nfull-1)
+	base, size := c*l, l
+	if c == nfull-1 {
+		size = f.lines - base
+	}
+	i := line - base
+	x, _ := bits.Mul64(mix64(fp*0x9e3779b97f4a7c15), size)
+	if x >= i {
+		return base + x - i
+	}
+	return base + x + size - i
+}
+
+// testHookSearch, if set, sees each cuckoo search (start: the two candidate
+// lines) and every alternate line relocate computes.
+var testHookSearch func(line uint64, start bool)
