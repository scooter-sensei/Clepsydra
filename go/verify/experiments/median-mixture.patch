+// cutShare is how many of the cut bucket's n spread events count inside the
+// window, which holds a share p of the bucket: the median of an even mixture of Binomial(n, p) and all-or-none (a burst, in the window with probability p): the p-quantile of Binomial(n, p) (lab E8). n*p past
+// 1000 events (hot entries).
+func cutShare(n int, p float64) float64 {
+	if n <= 0 || p <= 0 {
+		return 0
+	}
+	if p >= 1 {
+		return float64(n)
+	}
+	if n > 1000 {
+		return float64(n) * p
+	}
+	q := p
+	lp, step := float64(n)*math.Log1p(-p), math.Log(p/(1-p))
+	cdf := 0.0
+	for k := 0; k < n; k++ {
+		if cdf += math.Exp(lp); cdf >= q {
+			return float64(k)
+		}
+		lp += math.Log(float64(n-k)/float64(k+1)) + step
+	}
+	return float64(n)
+}
+
