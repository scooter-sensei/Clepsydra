+// mergeFrom adds o's live entries and floors to g, at the same buckets (o
+// has g's geometry: Merge checks the Config). Quiescent tables only.
+// (NEXT-RESULTS.md N15.)
+func (g *ghost) mergeFrom(o *ghost, now uint64) {
+	oep := o.epoch.Load()
+	if oep == 0 {
+		return
+	}
+	if g.epoch.Load() < oep {
+		g.advance(oep - 1)
+	}
+	if o.sat.Load() {
+		g.sat.Store(true)
+	}
+	if u := o.until.Load(); g.until.Load() < u {
+		g.until.Store(u)
+	}
+	for b := uint64(0); b < o.nb; b++ {
+		base := int(b * ghWords)
+		for s := 0; s < o.sub; s++ {
+			e := o.words[base] >> (uint(s) * ghSubBits) & ghSubMask
+			if sl := o.real(e, oep); e != 0 && o.live(sl, o.horizon, now) {
+				g.raiseFloor(base, uint64(s), ghCnt(e), sl, now)
+			}
+		}
+	next:
+		for k := 1; k < ghEntries; k++ {
+			w, sh := o.at(base, k)
+			e := *w >> sh & ghEntryMask
+			if e == 0 {
+				continue
+			}
+			sl := o.real(e, oep)
+			if !o.live(sl, o.horizon, now) {
+				continue
+			}
+			ep := g.epoch.Load()
+			for kk := 1; kk < ghEntries; kk++ {
+				gw, gsh := g.at(base, kk)
+				if ge := *gw >> gsh & ghEntryMask; ge == 0 || !g.live(g.real(ge, ep), g.horizon, now) {
+					*gw = *gw&^(ghEntryMask<<gsh) | ghEntry(ghFP(e), ghCnt(e), sl)<<gsh
+					continue next
+				}
+			}
+			g.raiseFloor(base, ghFP(e), ghCnt(e), sl, now) // no room: the bucket's floor keeps it
+		}
+	}
+}
