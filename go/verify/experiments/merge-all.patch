new file mode 100644
index 0000000..da93065
--- /dev/null
+++ b/mergeall_test.go
@@ -0,0 +1,102 @@
+package temporalfilter
+
+import (
+	"math"
+	"math/rand/v2"
+	"os"
+	"sort"
+	"testing"
+	"time"
+)
+
+// TestMergeAll (TF_EXP=1; NEXT-RESULTS.md N15): lab E13's harness at
+// Capacity 512 with hot entries on, so the stash, the overflow table and
+// hot entries are all in use; M = Merge(A) then Merge(B) against S.
+func TestMergeAll(t *testing.T) {
+	if os.Getenv("TF_EXP") == "" {
+		t.Skip("set TF_EXP=1")
+	}
+	const H = 60_000
+	cfg := Config{Capacity: 512, Horizon: time.Minute, Resolution: time.Millisecond}
+	a, _ := New(cfg)
+	b, _ := New(cfg)
+	s, _ := New(cfg)
+	hs := make([]uint64, 2000)
+	for k := range hs {
+		hs[k] = mix64(uint64(k) + 1<<50)
+	}
+	r := rand.New(rand.NewPCG(13, 13))
+	times := make([][]uint64, len(hs))
+	var errM, errS, ex [5]float64
+	seenDiff, seenCmp, cmp, lowM, lowMflag, lowS, checkpoints, mergeErr := 0, 0, 0, 0, 0, 0, 0, 0
+	var mEv, mPromo, mFolded uint64
+	velWorkload(func(k int, tk uint64) {
+		if r.IntN(2) == 0 {
+			a.TouchAt(hs[k], 0, tk)
+		} else {
+			b.TouchAt(hs[k], 0, tk)
+		}
+		s.TouchAt(hs[k], 0, tk)
+		times[k] = append(times[k], tk)
+	}, func(_ int, _ []uint64, _ int, now uint64) {
+		if now < H || now%5000 != 0 {
+			return
+		}
+		checkpoints++
+		m, _ := New(cfg)
+		if err := m.Merge(a); err != nil {
+			mergeErr++
+			t.Logf("merge A at %d: %v", now, err)
+		}
+		if err := m.Merge(b); err != nil {
+			mergeErr++
+			t.Logf("merge B at %d: %v", now, err)
+		}
+		mEv, mPromo, mFolded = m.Evictions(), m.Promoted(), m.Folded()
+		noEvict := m.Evictions() == 0 && s.Evictions() == 0
+		for k, h := range hs {
+			ts := times[k]
+			for wi, w := range velWins {
+				exact := len(ts) - sort.Search(len(ts), func(j int) bool { return ts[j]+w >= now })
+				rm, rs := m.CountAt(h, w, now), s.CountAt(h, w, now)
+				cmp++
+				if noEvict {
+					seenCmp++
+					if rm.Seen != rs.Seen {
+						seenDiff++
+					}
+				}
+				errM[wi] += math.Abs(float64(rm.Count - exact))
+				errS[wi] += math.Abs(float64(rs.Count - exact))
+				ex[wi] += float64(exact)
+				if rm.Upper < exact {
+					if rm.Saturated {
+						lowMflag++
+					} else {
+						lowM++
+						if lowM <= 3 {
+							t.Logf("low: key %d W=%d now=%d exact %d merged %+v single %+v", k, w, now, exact, rm, rs)
+						}
+					}
+				}
+				if rs.Upper < exact && !rs.Saturated {
+					lowS++
+				}
+			}
+		}
+	})
+	for _, x := range []struct {
+		n string
+		f *Filter
+	}{{"A", a}, {"B", b}, {"S", s}} {
+		t.Logf("%s: evictions %d, restored %d, folded to overflow %d, floored %d, promoted %d, stash %v, overflow %v",
+			x.n, x.f.Evictions(), x.f.restored.Load(), x.f.Folded(), x.f.Floored(), x.f.Promoted(), x.f.stash.Load() != nil, x.f.gh.Load() != nil)
+	}
+	t.Logf("checkpoints %d, comparisons %d, merge errors %d; last M: evictions %d, promoted %d, folded %d", checkpoints, cmp, mergeErr, mEv, mPromo, mFolded)
+	line := ""
+	for wi := range 5 {
+		line += " " + pad7(errM[wi]/ex[wi]) + "/" + pad7(errS[wi]/ex[wi]) + " (" + pad7(errM[wi]/errS[wi]) + ")"
+	}
+	t.Logf("count MAE merged/single (ratio) 1s 5s 15s 30s 60s:%s", line)
+	t.Logf("Seen compared %d (neither evicted), differs %d; Upper < exact: merged unflagged %d (flagged %d), single unflagged %d", seenCmp, seenDiff, lowM, lowMflag, lowS)
+}
