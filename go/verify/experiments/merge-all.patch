+// mergeKey adds the history of the key with identity id (g's words w0, w1:
+// a table slot or a stash entry) to f.
+func (f *Filter) mergeKey(g *Filter, id, w0, w1, now uint64) error {
+	last := w0 & tsMask
+	line, fp, tg := id>>28, w0>>48, w1>>tagShift
+	lo, _ := bits.Div64(line>>28, line<<36, f.lines) // ceil(line * 2^36 / lines): f.primary(h) == line
+	if lo*f.lines < line<<36 {
+		lo++
+	}
+	h := fp<<48 | tg<<36 | lo
+	if f.primary(h) != line || fingerprint(h) != fp || tag(h) != tg {
+		return errors.New("temporalfilter: Merge: identity does not round-trip")
+	}
+	vg, ok := g.viewOf(id, w1, last)
+	if !ok {
+		return nil // a hot entry that is no longer the key's
+	}
+	mu := &f.claimMu[h>>(64-claimStripeBits)]
+	mu.Lock()
+	defer mu.Unlock()
+	j, fw0, fw1 := f.lookupStable(h, fp, tg, false)
+	if j >= 0 {
+		v := vg
+		if vf, ok := f.viewOf(id, fw1, fw0&tsMask); ok {
+			v = sumViews(vf, vg)
+		}
+		nw1, over := f.viewWord(id, tg, &v, fw1, now)
+		sat := (fw0 | w0) & satBit
+		if over {
+			sat = satBit
+		}
+		atomic.StoreUint64(&f.words[j+1], nw1)
+		atomic.StoreUint64(&f.words[j], fw0&^(tsMask|satBit)|sat|max(last, fw0&tsMask))
+		return nil
+	}
+	nw1, over := f.viewWord(id, tg, &vg, 0, now)
+	sat := w0 & satBit
+	if over {
+		sat = satBit
+	}
+	for range 8 {
+		if f.claim(h, fp, nw1, now, last, sat, claimFull) >= 0 {
+			return nil
+		}
+	}
+	return errors.New("temporalfilter: Merge: a key found no slot in 8 tries (both filters must be quiescent)")
+}
+
+// sumViews is a's and b's counts at the newer epoch.
+func sumViews(a, b view) view {
+	e := max(a.e, b.e)
+	advanceWide(&a.c, a.e, e)
+	advanceWide(&b.c, b.e, e)
+	for j := range a.c {
+		a.c[j] += b.c[j]
+	}
+	a.e, a.sat, a.hot = e, max(a.sat, b.sat), a.hot || b.hot
+	return a
+}
+
+// viewWord is f's word1 for key id's history v: a register if v fits one,
+// else a hot entry of f, else a register with the excess spilled into older
+// buckets (over). A hot entry old pointed to is closed first.
+func (f *Filter) viewWord(id, tg uint64, v *view, old, now uint64) (w1 uint64, over bool) {
+	if isHot(old) {
+		f.hotClose(hotIdx(old), id)
+	}
+	var r register
+	fits := v.sat == satNone
+	for j := range r {
+		if v.c[j] > 1<<bucketBits[j]-1 {
+			fits = false
+		}
+	}
+	if fits {
+		for j := range r {
+			r[j] = v.c[j]
+		}
+		return tg<<tagShift | uint64(v.e)&epochMask<<48 | r.pack(), false
+	}
+	if f.hotN > 0 {
+		v.hot = true
+		if idx := f.hotAlloc(id, v, now); idx != 0 {
+			return tg<<tagShift | idx<<hotIdxShift, false
+		}
+	}
+	for j := range r {
+		over = r.add(j, v.c[j]) || over
+	}
+	return tg<<tagShift | uint64(v.e)&epochMask<<48 | r.pack(), true
+}
