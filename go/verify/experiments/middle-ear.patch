diff --git a/lab_ear.go b/lab_ear.go
new file mode 100644
index 0000000..f916e1e
--- /dev/null
+++ b/lab_ear.go
@@ -0,0 +1,24 @@
+package temporalfilter
+
+import (
+	"os"
+	"strconv"
+	"sync/atomic"
+)
+
+// lab/bio4-2026-11's switches for arm B13, the middle ear (BIO4-RESULTS.md).
+// Unset, the filter is the committed one. They are read once; the lab's
+// tests set them between filters.
+var (
+	// labEar (TF_EAR). 1: a touch that starts a new unit moves the slot's
+	// two words together, as realign does for a jump of 8 units or more, so
+	// a register is never read at a unit other than its last touch's and
+	// its 4 epoch bits say nothing. 2: also, those bits hold the onset of
+	// the newest bucket's first event, in sixteenths of its unit, and Count
+	// spreads that bucket from its onset.
+	labEar, _ = strconv.Atoi(os.Getenv("TF_EAR"))
+	// labProbe (TF_EARPROBE): regEpoch counts its decodes, and those whose
+	// stored epoch is not its reference's (the register read at a lag).
+	labProbe            = os.Getenv("TF_EARPROBE") != ""
+	labDecodes, labLags atomic.Uint64
+)
diff --git a/lab_ear_test.go b/lab_ear_test.go
new file mode 100755
index 0000000..3134556
--- /dev/null
+++ b/lab_ear_test.go
@@ -0,0 +1,185 @@
+package temporalfilter
+
+import (
+	"fmt"
+	"hash/fnv"
+	"math"
+	"os"
+	"sort"
+	"testing"
+	"time"
+
+	"github.com/scooter-sensei/clepsydra/go/internal/cpu"
+	"github.com/scooter-sensei/clepsydra/go/internal/workload"
+)
+
+// lab/bio4-2026-11, arm B13: the middle ear (TF_EAR), read on the filter
+// itself. Each reading makes a fresh filter per mode.
+func TestLabEar(t *testing.T) {
+	if os.Getenv("TF_LAB") == "" {
+		t.Skip("set TF_LAB=1")
+	}
+	defer func(e int, p bool) { labEar, labProbe = e, p }(labEar, labProbe)
+	newF := func(capN int) *Filter {
+		f, err := New(Config{Capacity: capN, Horizon: time.Minute, Resolution: time.Millisecond})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return f
+	}
+	hs := make([]uint64, 2000)
+	for k := range hs {
+		hs[k] = mix64(uint64(k) + 1<<50)
+	}
+
+	// The lag: register decodes whose stored epoch is not the unit of the
+	// last touch they are read against. One goroutine.
+	labProbe = true
+	for _, mode := range []int{0, 1} {
+		labEar = mode
+		labDecodes.Store(0)
+		labLags.Store(0)
+		f := newF(200_000)
+		ops := 0
+		workload.Churn(1.15, 4, 200_000, 60_000, mix64, func(h, w, now uint64) {
+			f.TouchAt(h, w, now)
+			ops++
+		})
+		t.Logf("lag TF_EAR=%d churn load 1.15: %d touches, %d decodes, %d at a lag (evictions %d, relocations %d)",
+			mode, ops, labDecodes.Load(), labLags.Load(), f.Evictions(), f.Relocations())
+		labDecodes.Store(0)
+		labLags.Store(0)
+		f = newF(200_000)
+		ops = 0
+		velWorkload(func(k int, tk uint64) { f.CheckAndTouchAt(hs[k], 0, tk); ops++ },
+			func(k int, ts []uint64, wi int, now uint64) { f.VelocityCountAt(hs[k], velWins[wi], now) })
+		t.Logf("lag TF_EAR=%d velocity workload: %d touches, %d decodes, %d at a lag (promoted %d, demoted %d)",
+			mode, ops, labDecodes.Load(), labLags.Load(), f.Promoted(), f.Demoted())
+	}
+	labProbe = false
+
+	// The velocity error by window and by shape, and what Upper says, per
+	// mode.
+	shapes := []string{"steady", "bursts", "ramp", "sparse", "on/off", "all"}
+	var errBy [3][6][5]float64
+	var exact [6][5]float64
+	var upDig [3]uint64
+	for mode := range 3 {
+		labEar = mode
+		f := newF(200_000)
+		dig := fnv.New64a()
+		velWorkload(func(k int, tk uint64) { f.CheckAndTouchAt(hs[k], 0, tk) },
+			func(k int, ts []uint64, wi int, now uint64) {
+				w := velWins[wi]
+				ex := float64(len(ts) - sort.Search(len(ts), func(j int) bool { return ts[j]+w >= now }))
+				r := f.CountAt(hs[k], w, now)
+				fmt.Fprintf(dig, "%v %d %v;", r.Seen, r.Upper, r.Saturated)
+				for _, sh := range []int{k % 5, 5} {
+					errBy[mode][sh][wi] += math.Abs(float64(r.Count) - ex)
+					if mode == 0 {
+						exact[sh][wi] += ex
+					}
+				}
+			})
+		upDig[mode] = dig.Sum64()
+		t.Logf("TF_EAR=%d: promoted %d, demoted %d, hot refused %d; digest of every answer's Seen, Upper and Saturated %016x",
+			mode, f.Promoted(), f.Demoted(), f.HotRefused(), upDig[mode])
+	}
+	for sh, name := range shapes {
+		for mode := range 3 {
+			line, mean := "", 0.0
+			for wi := range 5 {
+				e := errBy[mode][sh][wi] / exact[sh][wi]
+				mean += e / 5
+				line += fmt.Sprintf(" %.4f", e)
+			}
+			t.Logf("velocity %-7s TF_EAR=%d by window 1,5,15,30,60 s:%s  mean %.4f", name, mode, line, mean)
+		}
+	}
+	if upDig[1] != upDig[0] || upDig[2] != upDig[0] {
+		t.Errorf("Seen, Upper or Saturated differ between modes: %x %x %x", upDig[0], upDig[1], upDig[2])
+	}
+
+	// The strict limiter's decisions on the same requests, per mode.
+	for _, c := range []struct{ w, limit uint64 }{{1_000, 5}, {5_000, 20}} {
+		var digs [3]uint64
+		var adm [3]int
+		for mode := range 3 {
+			labEar = mode
+			f := newF(200_000)
+			dig := fnv.New64a()
+			velWorkload(func(k int, tk uint64) {
+				_, ok := f.TouchIfUnderAt(hs[k], c.w, c.limit, tk)
+				if ok {
+					adm[mode]++
+					dig.Write([]byte{1})
+				} else {
+					dig.Write([]byte{0})
+				}
+			}, func(int, []uint64, int, uint64) {})
+			digs[mode] = dig.Sum64()
+		}
+		t.Logf("strict limiter %gs/%d: admitted %d %d %d, digests %016x %016x %016x", float64(c.w)/1000, c.limit,
+			adm[0], adm[1], adm[2], digs[0], digs[1], digs[2])
+		if digs[1] != digs[0] || digs[2] != digs[0] {
+			t.Errorf("strict limiter %gs/%d: decisions differ between modes", float64(c.w)/1000, c.limit)
+		}
+	}
+
+	// Indicative timing: every key touched once a round. sparse: the clock
+	// moves one unit a round, so every touch starts a new unit; dense: one
+	// tick a round. 3 interleaved rounds per arm.
+	if os.Getenv("TF_EAR_NOTIME") != "" {
+		return
+	}
+	const nk = 200_000
+	keys := make([]uint64, nk)
+	for k := range keys {
+		keys[k] = mix64(uint64(k) + 1<<52)
+	}
+	type arm struct {
+		name string
+		mode int
+		cas2 bool
+	}
+	arms := []arm{{"base", 0, true}, {"TF_EAR=1", 1, true}, {"TF_EAR=2", 2, true}, {"base, no CAS2", 0, false}, {"TF_EAR=1, no CAS2", 1, false}}
+	had := cpu.HasCAS2
+	defer func() { cpu.HasCAS2 = had }()
+	for _, step := range []struct {
+		name string
+		d    uint64
+	}{{"sparse", 2500}, {"dense", 1}} {
+		res := make([][]float64, len(arms))
+		for range 3 {
+			for ai, a := range arms {
+				if !had && a.cas2 {
+					continue
+				}
+				labEar, cpu.HasCAS2 = a.mode, a.cas2
+				f := newF(2 * nk)
+				now := uint64(1)
+				for _, h := range keys {
+					f.CheckAndTouchAt(h, 0, now)
+				}
+				t0 := time.Now()
+				const rounds = 8
+				for range rounds {
+					now += step.d
+					for _, h := range keys {
+						f.CheckAndTouchAt(h, 0, now)
+					}
+				}
+				res[ai] = append(res[ai], float64(time.Since(t0).Nanoseconds())/(rounds*nk))
+			}
+		}
+		cpu.HasCAS2 = had
+		for ai, a := range arms {
+			if len(res[ai]) == 0 {
+				continue
+			}
+			sort.Float64s(res[ai])
+			t.Logf("timing %-6s %-18s ns/touch %5.1f %5.1f %5.1f (median %.2f of the base's)", step.name, a.name,
+				res[ai][0], res[ai][1], res[ai][2], res[ai][1]/func() float64 { x := append([]float64(nil), res[0]...); sort.Float64s(x); return x[1] }())
+		}
+	}
+}
