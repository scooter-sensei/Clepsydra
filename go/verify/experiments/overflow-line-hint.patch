+// real3 decodes a line stamp against epoch ep: live stamps are of slices
+// cur-2..cur.
+func (g *ghost) real3(e, ep uint64) uint64 {
+	cur := ep - 1
+	return cur - (cur%3+3-(e-1))%3
+}
+
+// markLine raises line's stamp to slice sl (the epoch already covers it).
+func (g *ghost) markLine(line, sl uint64) {
+	if g.hint == nil {
+		return
+	}
+	w, sh := &g.hint[line/32], uint(line%32)*2
+	for {
+		ep := g.epoch.Load()
+		old := atomic.LoadUint64(w)
+		s := sl
+		if e := old >> sh & 3; e != 0 {
+			s = max(s, g.real3(e, ep))
+		}
+		ne := s%3 + 1
+		if ne == old>>sh&3 || g.epoch.Load() == ep && atomic.CompareAndSwapUint64(w, old, old&^(3<<sh)|ne<<sh) {
+			return
+		}
+	}
+}
+
+// mayHold: a history homed at line may be live here at now. False only
+// when no history homed there was written, or every one is dead.
+func (g *ghost) mayHold(line, now uint64) bool {
+	if g.hint == nil {
+		return true
+	}
+	w, sh := &g.hint[line/32], uint(line%32)*2
+	for {
+		ep := g.epoch.Load()
+		if ep == 0 {
+			return false
+		}
+		e := atomic.LoadUint64(w) >> sh & 3
+		if g.epoch.Load() != ep {
+			continue
+		}
+		return e != 0 && g.live(g.real3(e, ep), g.horizon, now)
+	}
+}
+
 func ghEntry(fp, cnt, sl uint64) uint64 { return fp<<(ghCntBits+ghSlBits) | cnt<<ghSlBits | sl&3 }
 func ghFP(e uint64) uint64              { return e >> (ghCntBits + ghSlBits) }
 func ghCnt(e uint64) uint64             { return e >> ghSlBits & ghCntMax }
