+// prefetch starts the loads of id's buckets (one line each) without
+// waiting for them: a count that reads them next finds them on their way.
+func (g *ghost) prefetch(id uint64) {
+	base, nb, _ := g.slot(id)
+	lines := [2]uint64{uint64(base[0] / ghWords), uint64(base[1] / ghWords)}
+	cpu.PrefetchLines(unsafe.Pointer(&g.words[0]), &lines[0], nb)
