+// prefetchOverflow prefetches h's buckets of the ghost overflow table if
+// it is live at now, for a caller that will read them (addSketch).
+func (f *Filter) prefetchOverflow(h, now uint64) {
+	if f.cms {
+		return
+	}
+	if g := f.gh.Load(); g != nil && (f.ct || now <= g.until.Load()) {
+		g.prefetch(f.stashID(h, fingerprint(h), tag(h)))
