+// SWAR match of a word's three entries against a fingerprint. ghLanes has
+// bit 0 of each lane; ghFPMask is the three fingerprint fields (bits 7-20,
+// 28-41, 49-62); ghFPLow is 0x3FFF in each field; ghCarry is the bit above
+// each field (21, 42, 63), which the mask clears.
+const (
+	ghLanes  = 1 | 1<<ghEntryBits | 1<<(2*ghEntryBits)
+	ghFPLow  = (1<<ghFPBits - 1) << (ghCntBits + ghSlBits) * ghLanes
+	ghFPMask = ghFPLow
+	ghCarry  = 1 << ghEntryBits * ghLanes
+)
+
+// ghMatch returns one bit per lane of w (bit 21k+21 for lane k) whose
+// fingerprint field equals the one replicated in fpRep. x keeps each lane's
+// fingerprint XOR the key's, 0 where they match; 0x3FFF added to a 14-bit
+// field carries into the masked bit above it iff the field is not 0, and
+// with 0x3FFF + 0x3FFF < 2^15 no carry reaches the next lane: exact. An
+// empty entry never matches (fingerprints are never 0).
+func ghMatch(w, fpRep uint64) uint64 {
+	x := (w ^ fpRep) & ghFPMask
+	return ^(x + ghFPLow) & ghCarry
+}
+
+// addMatches adds to r the live entries of word w in lanes m (ghMatch's
+// bits), against epoch ep.
+func (g *ghost) addMatches(r *Result, w, m, ep, window, now uint64) {
+	for ; m != 0; m &= m - 1 {
+		sh := uint(bits.TrailingZeros64(m)) - ghEntryBits // the lane's first bit
+		if e := w >> sh & ghEntryMask; g.live(g.real(e, ep), window, now) {
+			c := int(ghCnt(e))
+			r.Upper += c
+			r.Count += c
+			r.Saturated = r.Saturated || c == ghCntMax
+		}
+	}
+}
+
 // real decodes an entry's slice against epoch ep (newest slice + 1).
 func (g *ghost) real(e, ep uint64) uint64 {
 	cur := ep - 1
@@ -412,3 +448,73 @@ func (g *ghost) estimate(id, window, now uint64) (r Result, ok bool) {
 	r.Seen = r.Count > 0
 	return r, true
 }
+
+// estimateSWAR is estimate with each word's three entries matched at once
+// (ghMatch, addMatches): the same answer (TestGhostScansAgree), kept apart
+// so estimate's code for the touch paths stays as it was (speed-s2d).
+func (g *ghost) estimateSWAR(id, window, now uint64) (r Result, ok bool) {
+	bases, nb, fp := g.slot(id)
+	var line [2][ghWords]uint64
+	var ep uint64
+	for {
+		ep = g.epoch.Load()
+		if ep == 0 || now > g.until.Load() {
+			return Result{}, false
+		}
+		empty := true
+		for bi, base := range bases[:nb] {
+			for i := range line[bi] {
+				w := atomic.LoadUint64(&g.words[base+i])
+				line[bi][i] = w
+				if w != 0 {
+					empty = false
+				}
+			}
+		}
+		// Both buckets empty: nothing to decode against the wrong epoch, so
+		// no re-check. Only advance's sweep clears an entry, and only a dead one.
+		if empty {
+			return Result{}, false
+		}
+		if testHookGhostRead != nil {
+			testHookGhostRead()
+		}
+		if g.epoch.Load() == ep {
+			break
+		}
+	}
+	// raiseFloor counts a floor before it writes it, and floored is loaded
+	// after the words: a load that holds a floor sees floored > 0.
+	// Entries 1 and 2 share word 0 with the floors; words 1-7 hold three
+	// each (TestGhostScanLayout).
+	hasFloor := g.floored.Load() > 0
+	fpRep := fp * ghLanes << (ghCntBits + ghSlBits) // fp in each lane's fingerprint field
+	for bi := range nb {
+		if hasFloor {
+			if e := line[bi][0] >> g.floorShift(fp) & ghSubMask; e != 0 && g.live(g.real(e, ep), window, now) {
+				c := int(ghCnt(e))
+				r.Upper += c
+				r.Saturated = r.Saturated || c == ghCntMax
+			}
+		}
+		// Entries match by SWAR (ghMatch): word 0's lanes 1 and 2, then
+		// lanes 0-2 of words 1-7; only matching lanes are decoded.
+		if m := ghMatch(line[bi][0], fpRep) &^ (1 << ghEntryBits); m != 0 {
+			g.addMatches(&r, line[bi][0], m, ep, window, now)
+		}
+		for w := 1; w < ghWords; w++ {
+			lw := line[bi][w]
+			if lw == 0 {
+				continue
+			}
+			if m := ghMatch(lw, fpRep); m != 0 {
+				g.addMatches(&r, lw, m, ep, window, now)
+			}
+		}
+	}
+	if r.Upper == 0 {
+		return Result{}, false
+	}
+	r.Seen = r.Count > 0
+	return r, true
+}
diff --git a/ghost_swar_test.go b/ghost_swar_test.go
new file mode 100644
index 0000000..db2d9f1
--- /dev/null
+++ b/ghost_swar_test.go
@@ -0,0 +1,74 @@
+package temporalfilter
+
+import "testing"
+
+// TestGhostMatchExact: ghMatch flags exactly the lanes whose entry is
+// non-empty with fingerprint fp, as the per-entry scan did, on random
+// words and on words built from fp's neighbours, all-ones and empty fields.
+func TestGhostMatchExact(t *testing.T) {
+	check := func(w, fp uint64) {
+		m := ghMatch(w, fp*ghLanes<<(ghCntBits+ghSlBits))
+		for k := range uint64(ghPerWord) {
+			e := w >> (k * ghEntryBits) & ghEntryMask
+			want := e != 0 && ghFP(e) == fp
+			if got := m>>((k+1)*ghEntryBits)&1 == 1; got != want {
+				t.Fatalf("w %#x fp %#x lane %d: match %v, want %v", w, fp, k, got, want)
+			}
+		}
+		if m&^ghCarry != 0 {
+			t.Fatalf("w %#x fp %#x: bits outside the lanes' %#x", w, fp, m)
+		}
+	}
+	x := uint64(1)
+	for range 4_000_000 {
+		x = mix64(x)
+		fp := x>>50 | 1 // 14 bits, never 0
+		w := mix64(x) &^ (1 << 63)
+		check(w, fp)
+		// Lanes holding fp, its neighbours and extremes, with random counts and slices.
+		var v uint64
+		for k := range uint64(ghPerWord) {
+			y := mix64(x + k)
+			f := [...]uint64{fp, fp ^ 1, fp ^ 1<<13, fp + 1, fp - 1, 0, 1<<ghFPBits - 1, y >> 50}[y%8] & (1<<ghFPBits - 1)
+			v |= (f<<(ghCntBits+ghSlBits) | y>>20&(1<<(ghCntBits+ghSlBits)-1)) << (k * ghEntryBits)
+		}
+		check(v, fp)
+		check(v, 1<<ghFPBits-1)
+		check(v, 1)
+	}
+}
+
+// TestGhostScansAgree: estimateSWAR and estimate (per entry) give the
+// same answer for keys in, near and out of tables filled past their
+// capacity (floors raised), across windows and clocks over several slices.
+func TestGhostScansAgree(t *testing.T) {
+	const horizon = 60_000
+	for _, shape := range [][2]int{{2, 3}, {1, 1}, {2, 1}} {
+		g := newGhost(64*ghWords*8, horizon, shape[0], shape[1])
+		now := uint64(100_000)
+		for i := range uint64(40_000) {
+			if i%1000 == 0 {
+				now += 7_000
+			}
+			g.add(mix64(i%3000+1<<40), 1+i%5, now-i%9_000, i%97 == 0, now)
+			if i%50 != 0 {
+				continue
+			}
+			for q := range uint64(40) {
+				id := mix64((i+q*131)%3500 + 1<<40)
+				for _, w := range []uint64{1, horizon / 4, horizon / 2, horizon} {
+					for _, at := range []uint64{now, now + 5_000, now + horizon} {
+						a, aok := g.estimateSWAR(id, w, at)
+						b, bok := g.estimate(id, w, at)
+						if a != b || aok != bok {
+							t.Fatalf("shape %v, id %#x, window %d, at %d: swar %+v %v, per entry %+v %v", shape, id, w, at, a, aok, b, bok)
+						}
+					}
+				}
+			}
+		}
+		if g.floored.Load() == 0 {
+			t.Fatalf("shape %v: no floor raised; the test misses the floors' path", shape)
+		}
+	}
+}
