+// TestTimingModes compares ways to pad ConstantTime calls (TF_TIMING=1):
+// leak (KS D on Touch and Count), median latency and CPU per call.
+func TestTimingModes(t *testing.T) {
+	if os.Getenv("TF_TIMING") == "" {
+		t.Skip("set TF_TIMING=1")
+	}
+	const capacity, probes = 1 << 21, 20_000
+	modes := []struct {
+		name string
+		mode int
+		pad  time.Duration
+	}{
+		{"spin 3us", padSpin, 3 * time.Microsecond},
+		{"spin 10us", padSpin, 10 * time.Microsecond},
+		{"adaptive from 1us", padAdaptive, time.Microsecond},
+		{"sleep 50us", padSleep, 50 * time.Microsecond},
+		{"sleep 200us", padSleep, 200 * time.Microsecond},
+	}
+	for _, m := range modes {
+		line := ""
+		for _, op := range []string{"Touch", "Count"} {
+			now := uint64(1)
+			f, err := New(Config{Capacity: capacity, Horizon: time.Minute, Resolution: time.Millisecond,
+				Clock: func() uint64 { return now }})
+			if err != nil {
+				t.Fatal(err)
+			}
+			rng := rand.New(rand.NewPCG(3, 4))
+			seen := make([]uint64, capacity)
+			for i := range seen {
+				seen[i] = f.HashUint64(rng.Uint64())
+				f.TouchAt(seen[i], 0, now)
+			}
+			f.ct, f.pad, f.padMode = true, m.pad, m.mode // after the fill: padding it would take minutes
+			now += 1000
+			kind := make([]int, probes)
+			hs := make([]uint64, probes)
+			for i := range hs {
+				kind[i] = rng.IntN(2)
+				hs[i] = f.HashUint64(rng.Uint64())
+				if kind[i] == 1 {
+					hs[i] = seen[rng.IntN(len(seen))]
+				}
+			}
+			var ts [2][]float64
+			cpu0 := cpuTime()
+			w0 := time.Now()
+			for i, h := range hs {
+				t0 := time.Now()
+				if op == "Count" {
+					f.CountAt(h, 60_000, now)
+				} else {
+					f.TouchAt(h, 60_000, now)
+				}
+				ts[kind[i]] = append(ts[kind[i]], float64(time.Since(t0).Nanoseconds()))
+			}
+			wall := time.Since(w0)
+			cpu := cpuTime() - cpu0
+			slices.Sort(ts[0])
+			slices.Sort(ts[1])
+			all := append(append([]float64{}, ts[0]...), ts[1]...)
+			slices.Sort(all)
+			line += fmt.Sprintf(" | %s D %.3f (%.1f%%) p50 %6.1f us cpu %5.2f us/op", op, ks(ts[0], ts[1]), 50+50*ks(ts[0], ts[1]),
+				all[len(all)/2]/1000, float64(cpu.Nanoseconds())/probes/1000)
+			_ = wall
+		}
+		t.Logf("%-18s%s", m.name, line)
+	}
+}
+
+func cpuTime() time.Duration {
+	var ru syscall.Rusage
+	syscall.Getrusage(syscall.RUSAGE_SELF, &ru)
+	return time.Duration(ru.Utime.Nano() + ru.Stime.Nano())
+}
+
+// TestTimingThroughput: 16 goroutines of ConstantTime touches on 4 cores,
+// spinning or yielding while padded, plus one goroutine timing seen and
+// unseen probes (TF_TIMING=1).
+func TestTimingThroughput(t *testing.T) {
+	if os.Getenv("TF_TIMING") == "" {
+		t.Skip("set TF_TIMING=1")
+	}
+	const capacity, workers, per, probes = 1 << 21, 16, 20_000, 10_000
+	for _, m := range []struct {
+		name string
+		mode int
+		pad  time.Duration
+	}{{"none", padSpin, 0}, {"spin 3us", padSpin, 3 * time.Microsecond}, {"yield 3us", padYield, 3 * time.Microsecond}, {"yield 10us", padYield, 10 * time.Microsecond}} {
+		now := uint64(1)
+		f, _ := New(Config{Capacity: capacity, Horizon: time.Minute, Resolution: time.Millisecond, Clock: func() uint64 { return now }})
+		rng := rand.New(rand.NewPCG(3, 4))
+		seen := make([]uint64, capacity)
+		for i := range seen {
+			seen[i] = f.HashUint64(rng.Uint64())
+			f.TouchAt(seen[i], 0, now)
+		}
+		now += 1000
+		f.ct, f.pad, f.padMode = m.pad > 0, m.pad, m.mode
+		var wg sync.WaitGroup
+		t0 := time.Now()
+		for w := range workers {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				r := rand.New(rand.NewPCG(uint64(w), 5))
+				for range per {
+					f.TouchAt(seen[r.IntN(len(seen))], 60_000, now)
+				}
+			}()
+		}
+		var ts [2][]float64
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r := rand.New(rand.NewPCG(9, 9))
+			for range probes {
+				k := r.IntN(2)
+				h := f.HashUint64(r.Uint64())
+				if k == 1 {
+					h = seen[r.IntN(len(seen))]
+				}
+				s := time.Now()
+				f.TouchAt(h, 60_000, now)
+				ts[k] = append(ts[k], float64(time.Since(s).Nanoseconds()))
+			}
+		}()
+		wg.Wait()
+		el := time.Since(t0)
+		slices.Sort(ts[0])
+		slices.Sort(ts[1])
+		t.Logf("%-10s %5.2f M ops/s; probe p50 unseen %6.1f us seen %6.1f us; KS D %.3f (%.1f%%)", m.name,
+			float64(workers*per+probes)/el.Seconds()/1e6, ts[0][len(ts[0])/2]/1000, ts[1][len(ts[1])/2]/1000, ks(ts[0], ts[1]), 50+50*ks(ts[0], ts[1]))
+	}
+}
