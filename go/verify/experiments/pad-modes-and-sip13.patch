+// Pad modes (experiments): spin to a fixed pad, sleep to it, or spin to an
+// adaptive quantum that doubles whenever a call overruns it (Askarov, Zhang
+// and Myers 2010) and halves after a long run of calls under half of it.
+const (
+	padSpin = iota
+	padSleep
+	padAdaptive
+	padYield // spin, but let other goroutines run meanwhile
+)
+
+func (f *Filter) adaptPad(d time.Duration) time.Duration {
+	q := time.Duration(f.quantum.Load())
+	if q == 0 {
+		q = f.pad
+	}
+	if d > q {
+		for q < d {
+			q *= 2
+		}
+		f.quantum.Store(int64(q))
+		f.quiet.Store(0)
+		return q
+	}
+	if d < q/2 && f.quiet.Add(1) >= 1<<14 && q/2 >= f.pad {
+		f.quantum.CompareAndSwap(int64(q), int64(q/2))
+		f.quiet.Store(0)
 	}
+	return q
 }
 
