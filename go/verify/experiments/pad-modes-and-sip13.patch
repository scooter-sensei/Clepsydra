@@ -0,0 +1,43 @@
+package temporalfilter
+
+import (
+	"os"
+	"testing"
+)
+
+// sip13 is SipHash-1-3 on 8 bytes (as Rust's std HashMap uses): one
+// compression and three finalization rounds instead of two and four.
+func (k sipKey) sip13(x uint64) uint64 {
+	v0, v1, v2, v3 := k.init()
+	v3 ^= x
+	v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+	v0 ^= x
+	last := uint64(8 << 56)
+	v3 ^= last
+	v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+	v0 ^= last
+	v2 ^= 0xff
+	for range 3 {
+		v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+	}
+	return v0 ^ v1 ^ v2 ^ v3
+}
+
+var sinkH uint64
+
+func BenchmarkSipVariants(b *testing.B) {
+	if os.Getenv("TF_EXP") == "" {
+		b.Skip("set TF_EXP=1")
+	}
+	k := sipKey{1, 2}
+	b.Run("2-4", func(b *testing.B) {
+		for i := range b.N {
+			sinkH += k.uint64(uint64(i))
+		}
+	})
+	b.Run("1-3", func(b *testing.B) {
+		for i := range b.N {
+			sinkH += k.sip13(uint64(i))
+		}
+	})
+}
