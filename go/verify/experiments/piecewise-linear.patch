+// partial estimates how many of bucket j's events fall in [from, hi[j]).
+// Instead of assuming they are uniform, it lets the density inside the
+// bucket slope toward its neighbours' densities (piecewise-linear
+// histogram), clamped so the density stays non-negative and the bucket's
+// total is unchanged.
+func (f *Filter) partial(r register, lo, hi [nBuckets]float64, j int, from float64) float64 {
+	c, w := float64(r[j]), hi[j]-lo[j]
+	if w <= 0 {
+		return c
+	}
+	a := c / w
+	density := func(k int) (float64, float64, bool) {
+		if k < 0 || k >= nBuckets || hi[k] <= lo[k] {
+			return 0, 0, false
+		}
+		return float64(r[k]) / (hi[k] - lo[k]), (lo[k] + hi[k]) / 2, true
+	}
+	dNew, xNew, okNew := density(j - 1)
+	dOld, xOld, okOld := density(j + 1)
+	mid := (lo[j] + hi[j]) / 2
+	var b float64
+	switch {
+	case okNew && okOld:
+		b = (dNew - dOld) / (xNew - xOld)
+	case okNew:
+		b = (dNew - a) / (xNew - mid)
+	case okOld:
+		b = (a - dOld) / (mid - xOld)
+	}
+	limit := 2 * a / w // keeps a + b*(x-mid) >= 0 across the bucket
+	b = max(-limit, min(limit, b))
+	return a*(hi[j]-from) + b/2*((hi[j]-mid)*(hi[j]-mid)-(from-mid)*(from-mid))
+}
