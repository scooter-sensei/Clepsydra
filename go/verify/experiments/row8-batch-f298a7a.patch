--- /dev/null
+++ b/prefetch_amd64.s
@@ -0,0 +1,7 @@
+#include "textflag.h"
+
+// func prefetch(p unsafe.Pointer)
+TEXT ·prefetch(SB),NOSPLIT,$0-8
+	MOVQ p+0(FP), AX
+	PREFETCHT0 (AX)
+	RET
diff --git a/r8_test.go b/r8_test.go
new file mode 100644
index 0000000..8ec6a52
--- /dev/null
+++ b/r8_test.go
@@ -0,0 +1,81 @@
+package temporalfilter
+
+import (
+	"bufio"
+	"math/rand/v2"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func init() {
+	expWarm2 = os.Getenv("TF_WARM2") == "1"
+	expTHP = os.Getenv("TF_THP") == "1"
+	if v := os.Getenv("TF_PF"); v != "" {
+		expPF = int(v[0] - '0')
+	}
+}
+
+// TestRow8 (TF_EXP=1): TestThroughput's batched line, repeated: a 2M-key
+// table at 90% of its slots, CheckAndTouchBatch (64 keys) over a 4M-key
+// uniform stream of present keys, TF_REPS times (default 5).
+func TestRow8(t *testing.T) {
+	if os.Getenv("TF_EXP") == "" {
+		t.Skip("set TF_EXP=1")
+	}
+	reps := 5
+	if s := os.Getenv("TF_REPS"); s != "" {
+		reps = 0
+		for _, c := range s {
+			reps = reps*10 + int(c-'0')
+		}
+	}
+	const capacity = 1 << 21
+	f, err := New(Config{Capacity: capacity, Horizon: time.Minute, Resolution: time.Millisecond, Clock: func() uint64 { return 1000 }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	keys := make([]uint64, f.Slots()*90/100)
+	for i := range keys {
+		keys[i] = mix64(uint64(i) + 1<<44)
+		f.TouchAt(keys[i], 0, 1000)
+	}
+	disp := 0
+	for _, h := range keys {
+		if f.find(f.primary(h), fingerprint(h)<<1, tag(h)) < 0 {
+			disp++
+		}
+	}
+	stream := make([]uint64, 1<<22)
+	rng := rand.New(rand.NewPCG(1, 2))
+	for i := range stream {
+		stream[i] = keys[rng.IntN(len(keys))]
+	}
+	out := make([]bool, 64)
+	var rates []float64
+	for range reps {
+		start := time.Now()
+		for i := 0; i+64 <= len(stream); i += 64 {
+			f.CheckAndTouchBatch(stream[i:i+64], 60_000, 1000, out)
+		}
+		rates = append(rates, float64(len(stream))/time.Since(start).Seconds()/1e6)
+	}
+	t.Logf("pf %d warm2 %v thp %v: %d MB, %.1f%% of keys displaced, AnonHugePages %s; batched M keys/s: %.2f",
+		expPF, expWarm2, expTHP, f.Bytes()>>20, 100*float64(disp)/float64(len(keys)), anonHuge(), rates)
+}
+
+func anonHuge() string {
+	fh, err := os.Open("/proc/self/smaps_rollup")
+	if err != nil {
+		return "?"
+	}
+	defer fh.Close()
+	s := bufio.NewScanner(fh)
+	for s.Scan() {
+		if strings.HasPrefix(s.Text(), "AnonHugePages:") {
+			return strings.Join(strings.Fields(s.Text())[1:], " ")
+		}
+	}
+	return "?"
+}
