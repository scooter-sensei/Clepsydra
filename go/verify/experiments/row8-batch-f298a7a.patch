@@ -0,0 +1,10 @@
+package temporalfilter
+
+import "unsafe"
+
+// prefetch issues PREFETCHT0 for p's cache line (experiment, row 8). Unlike a
+// load, a prefetch doesn't hold up retirement, and locked instructions (the
+// touches' CASes) don't wait for it.
+//
+//go:noescape
+func prefetch(p unsafe.Pointer)
