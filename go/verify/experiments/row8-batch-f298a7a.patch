 func (f *Filter) warm(hs []uint64) {
+	switch expPF {
+	case 1, 3: // experiment: prefetch instructions instead of loads
+		for _, h := range hs {
+			prefetch(unsafe.Pointer(&f.words[f.primary(h)*wordsPerLine]))
+		}
+		return
+	case 2: // experiment: prefetch both lines of every key
+		for _, h := range hs {
+			p := f.primary(h)
+			prefetch(unsafe.Pointer(&f.words[p*wordsPerLine]))
+			prefetch(unsafe.Pointer(&f.words[f.alt(p, fingerprint(h))*wordsPerLine]))
+		}
+		return
+	}
 	var sink uint64
 	for _, h := range hs {
 		sink += atomic.LoadUint64(&f.words[f.primary(h)*wordsPerLine])
 	}
+	if expWarm2 { // experiment: then the alternate line of each key its primary doesn't hold
+		for _, h := range hs {
