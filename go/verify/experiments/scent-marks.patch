diff --git a/marks.go b/marks.go
new file mode 100755
index 0000000..1814d61
--- /dev/null
+++ b/marks.go
@@ -0,0 +1,157 @@
+package temporalfilter
+
+import (
+	"os"
+	"sort"
+	"sync/atomic"
+)
+
+// Scent marks (lab arm B1): one byte per line saying "these four slots are
+// live until unit U", written by whoever scans the line and finds it full,
+// read by cuckoo searches only, which skip loading a leaf line while its mark
+// holds. A touch only extends a slot's life, so a mark is a lower bound; an
+// install lowers it when the entry going in expires earlier, abandon and the
+// sweep clear it. A mark is a hint: a stale one (a scan racing an abandon)
+// costs a usable line skipped, never an answer.
+//
+// A byte holds U mod markMod, plus 1 (0: no mark). A mark is at most
+// markSpan units ahead of the clock that reads it, and marks are bulk-cleared
+// every markLife units, so no byte aliases.
+const (
+	markMod  = 255
+	markSpan = unitsPerHorizon + 1
+	markLife = 200
+)
+
+// labNoMarks leaves the marks out of every filter (TF_MARKS=0: the base arm).
+// labEager (TF_MARKS=2, arm B1b) also marks a full primary line when the
+// insert lands in its alternate line. labFree (TF_MARKS=3, arm B1c) is
+// labEager with marked leaves spending no search budget, which changes
+// placements.
+var (
+	labNoMarks = os.Getenv("TF_MARKS") == "0"
+	labEager   = os.Getenv("TF_MARKS") == "2" || os.Getenv("TF_MARKS") == "3"
+	labFree    = os.Getenv("TF_MARKS") == "3"
+)
+
+func markOf(u int64) uint32 { return uint32(u%markMod) + 1 }
+
+// markAhead is how many units the mark byte m lies ahead of unit u, in
+// (-markMod/2, markMod/2].
+func markAhead(m uint32, u int64) int64 {
+	d := (int64(m) - 1 - u%markMod + markMod) % markMod
+	if d > markMod/2 {
+		d -= markMod
+	}
+	return d
+}
+
+func (f *Filter) markByte(line uint64) uint32 {
+	return atomic.LoadUint32(&f.marks[line>>2]) >> (line & 3 * 8) & 0xff
+}
+
+// markSet stores m as line's mark if the mark still reads old.
+func (f *Filter) markSet(line uint64, old, m uint32) {
+	p, sh := &f.marks[line>>2], line&3*8
+	w := atomic.LoadUint32(p)
+	if w>>sh&0xff != old {
+		return
+	}
+	atomic.CompareAndSwapUint32(p, w, w&^(0xff<<sh)|m<<sh)
+}
+
+// markedFull reports that line is known to hold four live entries at unit nowU.
+func (f *Filter) markedFull(line uint64, nowU int64) bool {
+	if f.marks == nil {
+		return false
+	}
+	m := f.markByte(line)
+	if m == 0 {
+		return false
+	}
+	d := markAhead(m, nowU)
+	return d >= 1 && d <= markSpan
+}
+
+// markFull records that line's four slots were seen live, the oldest last
+// touched at minTs: full through every unit before that of minTs+horizon.
+func (f *Filter) markFull(line, minTs uint64, nowU int64) {
+	if f.marks == nil {
+		return
+	}
+	u := min(f.unitOf(minTs+f.horizon), nowU+markSpan)
+	if u <= nowU {
+		return
+	}
+	if old := f.markByte(line); old != markOf(u) {
+		f.markSet(line, old, markOf(u))
+	}
+}
+
+// markLower lowers line's mark to the expiry of an entry going in, last
+// touched at ts, if that is earlier.
+func (f *Filter) markLower(line, ts uint64) {
+	if f.marks == nil {
+		return
+	}
+	m := f.markByte(line)
+	if m == 0 {
+		return
+	}
+	if u := f.unitOf(ts + f.horizon); markAhead(m, u) > 0 {
+		f.markSet(line, m, markOf(u))
+	}
+}
+
+// markClear removes line's mark (a slot of it was freed).
+func (f *Filter) markClear(line uint64) {
+	if f.marks == nil {
+		return
+	}
+	if m := f.markByte(line); m != 0 {
+		f.markSet(line, m, 0)
+	}
+}
+
+// marksAge clears every mark once the oldest may be markLife units old.
+func (f *Filter) marksAge(nowU int64) {
+	born := f.marksBorn.Load()
+	if nowU-born < markLife || !f.marksBorn.CompareAndSwap(born, nowU) {
+		return
+	}
+	for i := range f.marks {
+		atomic.StoreUint32(&f.marks[i], 0)
+	}
+}
+
+// Work counts for the lab's reading (single-threaded tests only): the
+// distinct alternate lines each search touches.
+var (
+	labWork     bool
+	labSeen     []uint64
+	labSearches uint64
+	labLines    uint64
+	labDeep     uint64 // searches that went past the first level
+)
+
+func labTouch(line uint64) {
+	if labWork {
+		labSeen = append(labSeen, line)
+	}
+}
+
+func labSearchEnd() {
+	if !labWork {
+		return
+	}
+	sort.Slice(labSeen, func(i, j int) bool { return labSeen[i] < labSeen[j] })
+	n := 0
+	for i, l := range labSeen {
+		if i == 0 || l != labSeen[i-1] {
+			n++
+		}
+	}
+	labSearches++
+	labLines += uint64(n)
+	labSeen = labSeen[:0]
+}
