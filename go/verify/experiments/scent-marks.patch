@@ -0,0 +1,87 @@
+package temporalfilter
+
+import (
+	"os"
+	"testing"
+	"time"
+
+	"github.com/scooter-sensei/clepsydra/go/internal/workload"
+)
+
+// TestLabMarksWork (TF_LAB=1) replays tfbench's churn stream with and without
+// scent marks and reports the distinct alternate lines a search touches.
+func TestLabMarksWork(t *testing.T) {
+	if os.Getenv("TF_LAB") == "" {
+		t.Skip("TF_LAB=1")
+	}
+	const capacity, hTicks = 200_000, 60_000
+	defer func(v, e, fr bool) { labNoMarks, labEager, labFree, labWork = v, e, fr, false }(labNoMarks, labEager, labFree)
+	for _, c := range []struct {
+		load float64
+		seed uint64
+	}{{1.0, 2}, {1.1, 3}, {1.15, 4}} {
+		var lines [4]float64
+		for arm := range 4 {
+			off := arm == 0
+			labNoMarks, labEager, labFree = off, arm >= 2, arm == 3
+			f, _ := New(Config{Capacity: capacity, Horizon: time.Minute, Resolution: time.Millisecond})
+			labWork, labSearches, labLines, labDeep, labSeen = true, 0, 0, 0, labSeen[:0]
+			inserts, seen, missed, falseSeen := 0, 0, 0, 0
+			last := map[uint64]uint64{}
+			workload.Churn(c.load, c.seed, capacity, hTicks, mix64, func(h, w, now uint64) {
+				got := f.CheckAndTouchAt(h, w, now)
+				lt, ok := last[h]
+				want := ok && now-lt <= w
+				last[h] = now
+				if got {
+					seen++
+				} else {
+					inserts++
+				}
+				if want && !got {
+					missed++
+				}
+				if !want && got {
+					falseSeen++
+				}
+			})
+			labWork = false
+			marked := 0
+			if f.marks != nil {
+				nowU := f.unitOf(4 * hTicks)
+				for l := uint64(0); l < f.lines; l++ {
+					if f.markedFull(l, nowU) {
+						marked++
+					}
+				}
+			}
+			lines[arm] = float64(labLines) / float64(labSearches)
+			t.Logf("load %.2f arm %d marks=%v: unseen touches %d, searches %d (%.1f%%), lines/search %.2f, past the first level %d (%.2f%%), evictions %d, relocations %d, seen %d, missed %d, false seen %d, lines marked at the end %.1f%%",
+				c.load, arm, !off, inserts, labSearches, 100*float64(labSearches)/float64(inserts), lines[arm],
+				labDeep, 100*float64(labDeep)/float64(labSearches), f.Evictions(), f.Relocations(), seen, missed, falseSeen, 100*float64(marked)/float64(f.lines))
+		}
+		t.Logf("load %.2f: lines per search, fewer than the base: B1 %.2fx, B1b %.2fx, B1c %.2fx", c.load, lines[0]/lines[1], lines[0]/lines[2], lines[0]/lines[3])
+	}
+}
+
+// BenchmarkLabInsertSteadyBig is BenchmarkInsertSteady on a table past the
+// cache (Capacity 4M, ~75 MiB).
+func BenchmarkLabInsertSteadyBig(b *testing.B) {
+	const n = 4 << 20
+	f, _ := New(Config{Capacity: n, Horizon: time.Minute})
+	for i := range uint64(n) {
+		f.CheckAndTouchAt(mix64(i), 0, 1000)
+	}
+	w := f.Ticks(30 * time.Second)
+	perKey := f.Ticks(time.Minute) / n
+	ctr := uint64(0)
+	for range 2 * n {
+		ctr++
+		f.CheckAndTouchAt(mix64(n+ctr), w, 1000+ctr*perKey)
+	}
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		ctr++
+		f.CheckAndTouchAt(mix64(n+ctr), w, 1000+ctr*perKey)
+	}
+}
