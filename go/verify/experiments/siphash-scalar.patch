diff --git a/internal/siphash/siphash_old_test.go b/internal/siphash/siphash_old_test.go
new file mode 100644
index 0000000..d7bb1a5
--- /dev/null
+++ b/internal/siphash/siphash_old_test.go
@@ -0,0 +1,75 @@
+package siphash
+
+import (
+	"encoding/binary"
+	"testing"
+	"unsafe"
+)
+
+// The SipHash code before speed-s6, kept to compare against.
+
+func oldSipFinish(v0, v1, v2, v3, last uint64) uint64 {
+	v3 ^= last
+	v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+	v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+	v0 ^= last
+	v2 ^= 0xff
+	for range 4 {
+		v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+	}
+	return v0 ^ v1 ^ v2 ^ v3
+}
+
+func (k Key) oldHashString(s string) uint64 {
+	b := unsafe.Slice(unsafe.StringData(s), len(s))
+	v0, v1, v2, v3 := k.init()
+	n := len(b)
+	for ; len(b) >= 8; b = b[8:] {
+		m := binary.LittleEndian.Uint64(b)
+		v3 ^= m
+		v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+		v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+		v0 ^= m
+	}
+	last := uint64(n) << 56
+	for i, c := range b {
+		last |= uint64(c) << (8 * i)
+	}
+	return oldSipFinish(v0, v1, v2, v3, last)
+}
+
+func (k Key) oldHashUint64(x uint64) uint64 {
+	v0, v1, v2, v3 := k.init()
+	v3 ^= x
+	v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+	v0, v1, v2, v3 = sipRound(v0, v1, v2, v3)
+	v0 ^= x
+	return oldSipFinish(v0, v1, v2, v3, 8<<56)
+}
+
+// TestSipHashMatchesOld: HashUint64 and HashString give the old code's
+// outputs on 1M random inputs each (strings of every length 0-64), under
+// random keys.
+func TestSipHashMatchesOld(t *testing.T) {
+	x := uint64(0x243f6a8885a308d3)
+	next := func() uint64 { x ^= x << 13; x ^= x >> 7; x ^= x << 17; return x }
+	buf := make([]byte, 64)
+	for i := range 1_000_000 {
+		var kb [16]byte
+		binary.LittleEndian.PutUint64(kb[:8], next())
+		binary.LittleEndian.PutUint64(kb[8:], next())
+		k := NewKey(&kb)
+		v := next()
+		if got, want := k.HashUint64(v), k.oldHashUint64(v); got != want {
+			t.Fatalf("case %d: HashUint64(%#x) = %#x, old %#x", i, v, got, want)
+		}
+		for j := range buf {
+			buf[j] = byte(next())
+		}
+		n := i % 65
+		s := string(buf[:n])
+		if got, want := k.HashString(s), k.oldHashString(s); got != want {
+			t.Fatalf("case %d: HashString(%d bytes) = %#x, old %#x", i, n, got, want)
+		}
+	}
+}
