diff --git a/lab_snapshot_test.go b/lab_snapshot_test.go
new file mode 100644
index 0000000..645d2ed
--- /dev/null
+++ b/lab_snapshot_test.go
@@ -0,0 +1,71 @@
+package temporalfilter
+
+import (
+	"bytes"
+	"os"
+	"testing"
+	"time"
+)
+
+// TestLabSnapshot (lab E14; TF_LAB=1): tfbench's velocity workload run
+// once uninterrupted and once snapshotted at 150 s and restored into a new
+// filter; every answer compared.
+func TestLabSnapshot(t *testing.T) {
+	if os.Getenv("TF_LAB") == "" {
+		t.Skip("TF_LAB=1")
+	}
+	cfg := Config{Capacity: 512, Horizon: time.Minute, Resolution: time.Millisecond}
+	key := func(k int) uint64 { return mix64(uint64(k) + 1) }
+	wins := []uint64{1_000, 5_000, 15_000, 30_000, 60_000}
+	run := func(snapAt uint64) (ans []Result, f *Filter, size, bytesAt int) {
+		f, _ = New(cfg)
+		velWorkload(func(k int, at uint64) {
+			ans = append(ans, f.TouchAt(key(k), 60_000, at))
+		}, func(k int, _ []uint64, wi int, now uint64) {
+			if now == snapAt {
+				var buf bytes.Buffer
+				if _, err := f.WriteTo(&buf); err != nil {
+					t.Fatal(err)
+				}
+				size, bytesAt = buf.Len(), f.Bytes()
+				g, _ := New(cfg)
+				if _, err := g.ReadFrom(&buf); err != nil {
+					t.Fatal(err)
+				}
+				f = g
+			}
+			ans = append(ans, f.CountAt(key(k), wins[wi], now))
+		})
+		return ans, f, size, bytesAt
+	}
+	u, fu, _, _ := run(0)
+	r, fr, size, bytesAt := run(150_000)
+	diff, first := 0, -1
+	for i := range min(len(u), len(r)) {
+		if u[i] != r[i] {
+			diff++
+			if first < 0 {
+				first = i
+			}
+		}
+	}
+	t.Logf("answers %d / %d, differing %d (first at %d); end: evictions %d / %d, folded %d / %d, promoted %d / %d, floored %d / %d",
+		len(u), len(r), diff, first, fu.Evictions(), fr.Evictions(), fu.folded.Load(), fr.folded.Load(), fu.promoted.Load(), fr.promoted.Load(), fu.Floored(), fr.Floored())
+	t.Logf("snapshot %d bytes, Bytes() %d at the snapshot (%.3f%%)", size, bytesAt, 100*float64(size-bytesAt)/float64(bytesAt))
+	// The clock: the built-in one continues the old timeline.
+	c, _ := New(Config{Capacity: 512, Horizon: time.Minute})
+	c.TouchAt(1, 0, c.clock())
+	var buf bytes.Buffer
+	c.WriteTo(&buf)
+	old := c.clock()
+	time.Sleep(20 * time.Millisecond)
+	d, _ := New(Config{Capacity: 512, Horizon: time.Minute})
+	if _, err := d.ReadFrom(&buf); err != nil {
+		t.Fatal(err)
+	}
+	now := d.clock()
+	t.Logf("clock: old %d, restored %d (+%d ticks, want >= %d)", old, now, now-old, c.Ticks(20*time.Millisecond))
+	if diff != 0 || len(u) != len(r) || now < old+c.Ticks(20*time.Millisecond) {
+		t.Errorf("snapshot changed answers or the clock")
+	}
+}
