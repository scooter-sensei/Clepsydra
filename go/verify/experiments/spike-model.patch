+package temporalfilter
+
+import (
+	"math"
+	"math/rand/v2"
+	"os"
+	"sort"
+	"testing"
+	"time"
+)
+
+// lab/bio2-2026-11, arm B4: spike timing for sparse keys (a model).
+//
+// spikeKey is one key's register in the model: in timing mode the exact
+// last touch and the q-steps of up to spikeCap older events; in counting
+// mode the real filter's register (the shadow filter is fed every touch, so
+// the conversion needs no code here: a q-step lies whole in one unit).
+type spikeKey struct {
+	dense bool
+	has   bool
+	last  uint64
+	ev    []uint64 // floor(t/q) of older events, oldest first
+}
+
+const spikeCap = 5 // older events held beside the last touch
+
+// expire resets a key idle for more than a horizon (its slot has expired)
+// and drops events certainly past the horizon.
+func (s *spikeKey) expire(now, hT, q uint64) {
+	if s.has && now-s.last > hT {
+		*s = spikeKey{}
+	}
+	if s.dense {
+		return
+	}
+	k := 0
+	for k < len(s.ev) && (s.ev[k]+1)*q-1+hT < now {
+		k++
+	}
+	s.ev = s.ev[k:]
+}
+
+// count is the timing-mode answer for (now-w, now]: Upper counts an event
+// unless its q-step ends before the window, Count takes the step's middle.
+func (s *spikeKey) count(now, w, q uint64) (count, upper int) {
+	if !s.has || now-s.last > w {
+		return 0, 0
+	}
+	count, upper = 1, 1
+	for _, e := range s.ev {
+		if (e+1)*q-1+w >= now {
+			upper++
+		}
+		if e*q+q/2+w >= now {
+			count++
+		}
+	}
+	return count, upper
+}
+
+// touch records an event at now; it reports false once the key must leave
+// timing mode (a seventh event inside the horizon).
+func (s *spikeKey) touch(now uint64, q uint64) {
+	if s.dense {
+		s.last = now
+		return
+	}
+	if s.has {
+		s.ev = append(s.ev, s.last/q)
+	}
+	s.last, s.has = now, true
+	if len(s.ev) > spikeCap {
+		s.dense, s.ev = true, nil
+	}
+}
+
+func within(ts []uint64, w, now uint64) int {
+	return len(ts) - sort.Search(len(ts), func(j int) bool { return ts[j]+w >= now })
+}
+
+func TestLabSpike(t *testing.T) {
+	if os.Getenv("TF_LAB") == "" {
+		t.Skip("set TF_LAB=1")
+	}
+	const hT = 60_000
+	const nkeys, horizons = 400, 20
+	newF := func(h time.Duration) *Filter {
+		f, err := New(Config{Capacity: 4 * nkeys, Horizon: h, Resolution: time.Millisecond})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return f
+	}
+	type rule struct {
+		hz       time.Duration
+		w, limit uint64
+	}
+	rules := []rule{
+		{time.Minute, 60_000, 3}, {time.Minute, 60_000, 5}, {time.Minute, 60_000, 6},
+		{time.Minute, 30_000, 3}, {time.Minute, 10_000, 3}, {time.Minute, 10_000, 5},
+		{10 * time.Second, 10_000, 5}, // the same rule on a filter whose horizon is its window
+	}
+	t.Logf("%-8s %-6s %-5s %-7s | admitted/exact: base  spike | false denies: base  spike | timing-mode share", "horizon", "window", "limit", "offered")
+	for _, ru := range rules {
+		for _, mult := range []float64{0.8, 1.2, 2} {
+			fb, fs := newF(ru.hz), newF(ru.hz)
+			hz := uint64(ru.hz / time.Millisecond)
+			q := fb.unit / 10 // 250 ms at a 60 s horizon; 41 ms at 10 s (the model needs no exact division)
+			r := rand.New(rand.NewPCG(4, uint64(ru.w)+ru.limit))
+			type ev struct {
+				t uint64
+				k int
+			}
+			var evs []ev
+			rate := mult * float64(ru.limit) / float64(ru.w)
+			end := float64(horizons * hT)
+			for k := range nkeys {
+				for x := r.ExpFloat64() / rate; x < end; x += r.ExpFloat64() / rate {
+					evs = append(evs, ev{uint64(x) + 1, k})
+				}
+			}
+			sort.Slice(evs, func(i, j int) bool { return evs[i].t < evs[j].t })
+			var adm [3][][]uint64 // exact, base, spike: admitted times per key
+			for a := range adm {
+				adm[a] = make([][]uint64, nkeys)
+			}
+			sp := make([]spikeKey, nkeys)
+			var admitted, falseDeny [3]int
+			sparseReq := 0
+			for _, e := range evs {
+				h := mix64(uint64(e.k) + 1<<50)
+				now := e.t
+				// exact log
+				if within(adm[0][e.k], ru.w, now) < int(ru.limit) {
+					adm[0][e.k] = append(adm[0][e.k], now)
+					admitted[0]++
+				}
+				// base: the filter's TouchIfUnder
+				own := within(adm[1][e.k], ru.w, now)
+				if _, ok := fb.TouchIfUnderAt(h, ru.w, ru.limit, now); ok {
+					if own >= int(ru.limit) {
+						t.Fatalf("base admitted past the limit: %d in window", own)
+					}
+					adm[1][e.k] = append(adm[1][e.k], now)
+					admitted[1]++
+				} else if own < int(ru.limit) {
+					falseDeny[1]++
+				}
+				// spike
+				s := &sp[e.k]
+				s.expire(now, hz, q)
+				own = within(adm[2][e.k], ru.w, now)
+				ok := false
+				if s.dense {
+					_, ok = fs.TouchIfUnderAt(h, ru.w, ru.limit, now)
+				} else {
+					sparseReq++
+					_, up := s.count(now, ru.w, q)
+					if ok = up < int(ru.limit); ok {
+						fs.TouchAt(h, ru.w, now)
+					}
+				}
+				if ok {
+					if own >= int(ru.limit) {
+						t.Fatalf("spike admitted past the limit: %d in window (dense %v)", own, s.dense)
+					}
+					s.touch(now, q)
+					adm[2][e.k] = append(adm[2][e.k], now)
+					admitted[2]++
+				} else if own < int(ru.limit) {
+					falseDeny[2]++
+				}
+			}
+			n := float64(len(evs))
+			t.Logf("%-8s %-6d %-5d %-7.1f | %.3f %.3f | %.3f %.3f | %.3f",
+				ru.hz, ru.w/1000, ru.limit, mult,
+				float64(admitted[1])/float64(admitted[0]), float64(admitted[2])/float64(admitted[0]),
+				float64(falseDeny[1])/n, float64(falseDeny[2])/n, float64(sparseReq)/n)
+		}
+	}
+
+	// tfbench's velocity workload: Count, the filter's against the model's.
+	f := newFBig(t)
+	q := f.unit / 10
+	sp := make([]spikeKey, 2000)
+	hs := make([]uint64, 2000)
+	for k := range hs {
+		hs[k] = mix64(uint64(k) + 1<<50)
+	}
+	var errB, errS, exact [5][6]float64 // window x (shape 0..4, all)
+	var sparseQ, queries [6]float64
+	velWorkload(func(k int, tt uint64) {
+		f.CheckAndTouchAt(hs[k], 0, tt)
+		sp[k].expire(tt, 60_000, q)
+		sp[k].touch(tt, q)
+	}, func(k int, ts []uint64, wi int, now uint64) {
+		w := velWins[wi]
+		ex := float64(within(ts, w, now))
+		got := float64(f.VelocityCountAt(hs[k], w, now))
+		gs := got
+		s := sp[k]
+		if !s.dense || s.has && now-s.last > 60_000 {
+			c, _ := s.count(now, w, q)
+			gs = float64(c)
+			sparseQ[k%5]++
+			sparseQ[5]++
+		}
+		queries[k%5]++
+		queries[5]++
+		for _, sh := range []int{k % 5, 5} {
+			errB[wi][sh] += math.Abs(got - ex)
+			errS[wi][sh] += math.Abs(gs - ex)
+			exact[wi][sh] += ex
+		}
+	})
+	names := []string{"steady", "bursts", "ramp", "sparse", "on/off", "all"}
+	for sh, name := range names {
+		var mb, ms float64
+		line := ""
+		for wi := range velWins {
+			b, s := errB[wi][sh]/exact[wi][sh], errS[wi][sh]/exact[wi][sh]
+			mb += b / 5
+			ms += s / 5
+			line += " " + ffmt(b) + "/" + ffmt(s)
+		}
+		t.Logf("velocity %-7s base/spike by window 1,5,15,30,60 s:%s  mean %s/%s  queries in timing mode %.3f",
+			name, line, ffmt(mb), ffmt(ms), sparseQ[sh]/queries[sh])
+	}
+}
+
+func ffmt(x float64) string {
+	return string([]byte{byte('0' + int(x)%10), '.'}) + func() string {
+		v := int(math.Round((x - math.Floor(x)) * 10000))
+		if v >= 10000 {
+			v = 9999
+		}
+		d := []byte{'0', '0', '0', '0'}
+		for i := 3; i >= 0; i-- {
+			d[i] = byte('0' + v%10)
+			v /= 10
+		}
+		return string(d)
+	}()
+}
+
+func newFBig(t *testing.T) *Filter {
+	f, err := New(Config{Capacity: 200_000, Horizon: time.Minute, Resolution: time.Millisecond})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return f
+}
