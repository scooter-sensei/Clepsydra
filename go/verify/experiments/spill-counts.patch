diff --git a/spill_test.go b/spill_test.go
new file mode 100644
index 0000000..3065d4f
--- /dev/null
+++ b/spill_test.go
@@ -0,0 +1,76 @@
+package temporalfilter
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// spillAudit compares each line's spill count with the displaced entries
+// actually homed there. A count below the truth would let locate skip a
+// line that holds the key (a false negative).
+func spillAudit(t *testing.T, f *Filter) (exact, over int) {
+	t.Helper()
+	want := make([]int, f.lines)
+	for l := range f.lines {
+		for s := 0; s < wordsPerLine; s += 2 {
+			w0 := atomic.LoadUint64(&f.words[int(l*wordsPerLine)+s])
+			if w0 != 0 && w0&dispBit != 0 {
+				want[f.alt(l, w0>>48)]++
+			}
+		}
+	}
+	for l := range f.lines {
+		got := int(f.spill[l>>2] >> (l & 3 * 8) & 0xff)
+		switch {
+		case got < want[l]:
+			t.Fatalf("line %d: spill count %d < %d displaced entries", l, got, want[l])
+		case got == want[l]:
+			exact++
+		default:
+			over++
+		}
+	}
+	return exact, over
+}
+
+func TestSpillCountsNeverUnderCount(t *testing.T) {
+	const capN, workers = 20_000, 8
+	f := newTest(t, capN, time.Second)
+	horizon := f.Ticks(time.Second)
+	var clock atomic.Uint64
+	clock.Store(1000)
+	var wg sync.WaitGroup
+	for w := range workers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range 300_000 {
+				now := clock.Add(1) * horizon / 100_000 // ~24 horizons overall
+				k := uint64(w*7919+i) % (capN * 6 / 5)  // 1.2x capacity live
+				f.CheckAndTouchAt(HashUint64(k+now/horizon*capN), horizon, now)
+				if i%97 == 0 {
+					f.decayStep(now, 4)
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	exact, over := spillAudit(t, f)
+	t.Logf("lines exact %d, over-counted %d; relocations %d, evictions %d", exact, over, f.Relocations(), f.Evictions())
+	// Every live key is found by locate exactly when it is in either line.
+	now := clock.Load() * horizon / 100_000
+	for k := range uint64(capN * 6 / 5) {
+		h := HashUint64(k + now/horizon*capN)
+		fp, tg := fingerprint(h), tag(h)
+		p := f.primary(h)
+		both := f.findAny(p, fp, tg)
+		if both < 0 {
+			both = f.findAny(f.alt(p, fp), fp, tg)
+		}
+		if (f.locate(h, fp, tg) < 0) != (both < 0) {
+			t.Fatalf("key %d: locate disagrees with a two-line search", k)
+		}
+	}
+}
