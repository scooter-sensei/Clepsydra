diff --git a/stashprobe.go b/stashprobe.go
new file mode 100644
index 0000000..d2747ee
--- /dev/null
+++ b/stashprobe.go
@@ -0,0 +1,49 @@
+package temporalfilter
+
+import (
+	"fmt"
+	"sync/atomic"
+	"unsafe"
+)
+
+var probeWrites, probeDup, probeDupLive, probeDupOlder, probeDupRoom, probeGetOlder atomic.Int64
+
+// probeCheck (scratch): after entry e of table p was written, the other entries of its set with its identity.
+func probeCheck(f *Filter, p *stashTable, e *stashEntry) {
+	if e.id == 0 {
+		return
+	}
+	probeWrites.Add(1)
+	base := (uintptr(unsafe.Pointer(e)) - uintptr(unsafe.Pointer(&p.e[0]))) / unsafe.Sizeof(stashEntry{}) / stashWays * stashWays
+	for k := base; k < base+stashWays; k++ {
+		o := &p.e[k]
+		if o == e || o.id != e.id {
+			continue
+		}
+		probeDup.Add(1)
+		a, b := o.w0&tsMask, e.w0&tsMask
+		if max(a, b)-min(a, b) <= f.horizon {
+			probeDupLive.Add(1)
+		}
+		if a > b {
+			probeDupOlder.Add(1)
+		}
+		if p == f.room.Load() {
+			probeDupRoom.Add(1)
+		}
+	}
+}
+
+// probeGet (scratch): a get returns set[i]; is a newer entry of its identity later in the set?
+func probeGet(set []stashEntry, i int) {
+	for j := i + 1; j < len(set); j++ {
+		if set[j].id == set[i].id && set[j].w0&tsMask > set[i].w0&tsMask {
+			probeGetOlder.Add(1)
+		}
+	}
+}
+
+func probeLine() string {
+	return fmt.Sprintf("probe: %d stash/room writes, %d with another entry of the identity in the set (%d within a horizon, %d the written one older, %d in the wait room); %d gets returned an older entry",
+		probeWrites.Load(), probeDup.Load(), probeDupLive.Load(), probeDupOlder.Load(), probeDupRoom.Load(), probeGetOlder.Load())
+}
