+package temporalfilter
+
+import (
+	"os"
+	"slices"
+	"testing"
+	"time"
+)
+
+// TestLabSweepLatency (lab E11; TF_LAB=1) floods a filter of 256K keys'
+// capacity with 4-event keys across 7 slices of the overflow table and
+// times every TouchAt.
+func TestLabSweepLatency(t *testing.T) {
+	if os.Getenv("TF_LAB") == "" {
+		t.Skip("TF_LAB=1")
+	}
+	f, err := New(Config{Capacity: 1 << 18, Horizon: time.Minute})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := f.Ticks(time.Minute)
+	const keys = 2 << 20
+	span := h * 7 / 2
+	lat := make([]uint32, 0, 4*keys)
+	for k := range uint64(keys) {
+		x := mix64(k + 1<<50)
+		now := 1 + span*k/keys
+		for range 4 {
+			t0 := time.Now()
+			f.TouchAt(x, h, now)
+			lat = append(lat, uint32(min(time.Since(t0), 1<<31)))
+		}
+	}
+	slices.Sort(lat)
+	q := func(p float64) uint32 { return lat[int(p*float64(len(lat)-1))] }
+	t.Logf("calls %d max %d p99.99 %d p99.9 %d p50 %d ns; folded %d floored %d bytes %d",
+		len(lat), lat[len(lat)-1], q(0.9999), q(0.999), q(0.5), f.folded.Load(), f.Floored(), f.Bytes())
+}
