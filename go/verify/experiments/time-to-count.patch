diff --git a/lab_ttc_test.go b/lab_ttc_test.go
new file mode 100644
index 0000000..649140f
--- /dev/null
+++ b/lab_ttc_test.go
@@ -0,0 +1,60 @@
+package temporalfilter
+
+import (
+	"math"
+	"os"
+	"slices"
+	"testing"
+	"time"
+)
+
+// TestLabTimeToCount (lab E12; TF_LAB=1) scores TimeToCountAt against exact
+// event times on tfbench's velocity workload.
+func TestLabTimeToCount(t *testing.T) {
+	if os.Getenv("TF_LAB") == "" {
+		t.Skip("TF_LAB=1")
+	}
+	f, err := New(Config{Capacity: 4096, Horizon: time.Minute, Resolution: time.Millisecond})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := f.Ticks(time.Minute)
+	key := func(k int) uint64 { return mix64(uint64(k) + 1) }
+	ns := []int{2, 5, 10, 50}
+	errs := make([][]float64, len(ns))
+	miss := make([]int, len(ns))
+	velWorkload(func(k int, at uint64) { f.CheckAndTouchAt(key(k), 0, at) }, func(k int, ts []uint64, _ int, now uint64) {
+		for i, n := range ns {
+			if len(ts) < n || now-ts[len(ts)-n] > h {
+				continue
+			}
+			exact := ts[len(ts)-1] - ts[len(ts)-n]
+			if exact == 0 {
+				continue
+			}
+			est, ok := f.TimeToCountAt(key(k), n, now)
+			if !ok {
+				miss[i]++
+				continue
+			}
+			errs[i] = append(errs[i], math.Abs(float64(est)-float64(exact))/float64(exact))
+		}
+	})
+	for i, n := range ns {
+		e := errs[i]
+		slices.Sort(e)
+		if len(e) == 0 {
+			t.Logf("n=%d: no queries", n)
+			continue
+		}
+		t.Logf("n=%-3d queries %7d  median rel err %.4f  p90 %.4f  mean %.4f  not ok %d", n, len(e), e[len(e)/2], e[len(e)*9/10], mean(e), miss[i])
+	}
+}
+
+func mean(x []float64) float64 {
+	s := 0.0
+	for _, v := range x {
+		s += v
+	}
+	return s / float64(len(x))
+}
