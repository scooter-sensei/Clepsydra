+
+// TestWeightedRate (TF_EXP=1; NEXT-RESULTS.md N10) is TestSustainedRate
+// (claims A15) with weighted touches: n events per TouchNAt, at event
+// rates 10-5,000/s, with hot entries available and exhausted.
+func TestWeightedRate(t *testing.T) {
+	if os.Getenv("TF_EXP") == "" {
+		t.Skip("set TF_EXP=1")
+	}
+	const hTicks = 60_000
+	windows := []uint64{1_000, 5_000, 15_000, 30_000, 60_000}
+	bad5, badLow := 0, 0
+	for _, hot := range []int{0, -1} {
+		for _, n := range []uint64{1, 7, 100, 1000} {
+			for _, rate := range []uint64{10, 50, 200, 1000, 5000} {
+				every := max(1, 1000*n/rate) // ticks between sends
+				per := max(1, rate/(1000*n)) // sends per tick
+				f, err := New(Config{Capacity: 1000, Horizon: time.Minute, Resolution: time.Millisecond, Hot: hot})
+				if err != nil {
+					t.Fatal(err)
+				}
+				h := mix64(rate*7919 + n)
+				type acc struct {
+					lo, hi      float64
+					sat, k, bad int
+				}
+				st := make([]acc, len(windows))
+				for i := range st {
+					st[i].lo = math.Inf(1)
+				}
+				var sends []uint64 // tick of each send
+				for now := uint64(1); now < 3*hTicks; now += every {
+					for range per {
+						f.TouchNAt(h, n, 0, now)
+						sends = append(sends, now)
+					}
+					if now < 2*hTicks {
+						continue
+					}
+					for wi, w := range windows {
+						exact := 0
+						for j := len(sends) - 1; j >= 0 && sends[j]+w >= now; j-- {
+							exact += int(n)
+						}
+						r := f.CountAt(h, w, now)
+						a := &st[wi]
+						a.k++
+						if r.Saturated {
+							a.sat++
+						} else if r.Upper < exact {
+							a.bad++
+						}
+						q := float64(r.Count) / float64(exact)
+						a.lo, a.hi = min(a.lo, q), max(a.hi, q)
+					}
+				}
+				name := "hot entries"
+				if hot < 0 {
+					name = "register only"
+				}
+				actual := float64(per*n) * 1000 / float64(every)
+				for wi, w := range windows {
+					a := st[wi]
+					badLow += a.bad
+					if hot == 0 && w >= 5_000 && (a.lo != 1 || a.hi != 1) {
+						bad5++
+					}
+					t.Logf("%-13s n=%-4d rate=%d/s (actual %.0f) W=%2ds count/exact min=%.3f max=%.3f saturated=%.1f%% unflagged_upper_low=%d",
+						name, n, rate, actual, w/1000, a.lo, a.hi, 100*float64(a.sat)/float64(a.k), a.bad)
+				}
+			}
+		}
+	}
+	t.Logf("rule (1) cells with Count != exact (hot entries, W >= 5 s): %d; rule (2) unflagged Upper < exact: %d", bad5, badLow)
+}
