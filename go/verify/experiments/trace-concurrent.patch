diff --git a/trace.go b/trace.go
new file mode 100755
index 0000000..5ca32d3
--- /dev/null
+++ b/trace.go
@@ -0,0 +1,83 @@
+package temporalfilter
+
+import (
+	"fmt"
+	"math/bits"
+)
+
+// Event kinds of the debugging trace (trace_on.go, build tag tftrace).
+const (
+	trTouch = iota + 1
+	trHit
+	trMissIn
+	trMissOut
+	trWait
+	trWaitFull
+	trRoomTake
+	trRoomExpired
+	trPlace
+	trPlaceGone
+	trPutBack
+	trEvict
+	trStashPut
+	trStashKeep
+	trStashSpillSelf
+	trStashTake
+	trMoved
+	trSweep
+	trSpill
+	trBitClear
+	trRecall
+	trRoomGot
+	trHotAlloc
+	trHotAdd
+	trHotAddMiss
+	trDemote
+	trHotReclaim
+	trHotClose
+	trHotReset
+)
+
+// regSum is the events a register holds (1<<32 for a hot entry's pointer).
+func regSum(w1 uint64) uint64 {
+	if isHot(w1) {
+		return 1 << 32
+	}
+	n := uint64(0)
+	for _, c := range unpack(w1 & regMask) {
+		n += c
+	}
+	return n
+}
+
+func trBool(b bool) uint64 {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// traceOf dumps h's records (its identity and its wait-room set).
+func (f *Filter) traceOf(h uint64) string {
+	if !traceOn {
+		return ""
+	}
+	id := f.stashID(h, fingerprint(h), tag(h))
+	set := uint64(1 << 62)
+	ways := ""
+	if p := f.room.Load(); p != nil {
+		set, _ = bits.Mul64(mix64(id), p.n)
+		for _, e := range p.e[set*stashWays : (set+1)*stashWays] {
+			ways += fmt.Sprintf(" [%x last %d defer %v busy %v]", e.id, e.w0&tsMask, e.w0&deferMark != 0, e.w1>>tagShift == tagBusy)
+		}
+		ways = fmt.Sprintf("\nroom set %d of %d (wait bit %v):%s", set, p.n, p.waiting(id), ways)
+	}
+	return ways + traceDump(id, 1<<63|set)
+}
+
+func hsum(c *[nBuckets]uint64) (n uint64) {
+	for _, x := range c {
+		n += x
+	}
+	return n
+}
