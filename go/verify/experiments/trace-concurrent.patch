@@ -0,0 +1,89 @@
+//go:build tftrace
+
+package temporalfilter
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"sync/atomic"
+)
+
+const traceOn = true
+
+type traceRec struct{ seq, run, kind, id, a, b, c, d uint64 }
+
+const traceBits = 24
+
+var (
+	traceRing [1 << traceBits]traceRec
+	traceSeq  atomic.Uint64
+	traceStop atomic.Bool
+	traceRun  atomic.Uint64
+)
+
+func tr(kind, id, a, b, c, d uint64) {
+	if traceStop.Load() {
+		return
+	}
+	n := traceSeq.Add(1)
+	traceRing[n&(1<<traceBits-1)] = traceRec{n, traceRun.Load(), kind, id, a, b, c, d}
+}
+
+var traceNames = map[uint64]string{
+	trTouch:          "touch      slot=%d last=%d events-after=%d now=%d",
+	trHit:            "hit        slot=%d last=%d events-after=%d now=%d",
+	trMissIn:         "miss-in    src=%d events=%d last=%d now=%d",
+	trMissOut:        "miss-out   ci=%d events=%d stamp=%d src=%d",
+	trWait:           "wait       events=%d last=%d over=%x now=%d",
+	trWaitFull:       "wait-full  events=%d last=%d now=%d %d",
+	trRoomTake:       "room-take  events=%d last=%d now=%d %d",
+	trRoomExpired:    "room-exp   events=%d last=%d now=%d %d",
+	trPlace:          "place      slot=%d events=%d last=%d ok=%d",
+	trPlaceGone:      "place-gone slot=%d %d %d %d",
+	trPutBack:        "put-back   events=%d last=%d defer=%x now=%d",
+	trEvict:          "evict      slot=%d events=%d last=%d now=%d",
+	trStashPut:       "stash-put  events=%d last=%d out=%x now=%d",
+	trStashKeep:      "stash-keep events=%d last=%d other-events=%d now=%d",
+	trStashSpillSelf: "stash-spill-self events=%d last=%d least=%d now=%d",
+	trStashTake:      "stash-take events=%d last=%d now=%d %d",
+	trMoved:          "moved      from=%d to=%d events=%d now=%d",
+	trSweep:          "sweep      slot=%d events=%d last=%d now=%d",
+	trSpill:          "spill      events=%d last=%d now=%d %d",
+	trBitClear:       "bit-clear  %d %d %d %d",
+	trRecall:         "recall     wait-bit=%d take=%d now=%d %d",
+	trRoomGot:        "room-got   ok=%d retry=%d last=%d events=%d",
+	trHotAlloc:       "hot-alloc  idx=%d events=%d unit=%d %d",
+	trHotAdd:         "hot-add    idx=%d n=%d unit=%d path=%d",
+	trHotAddMiss:     "hot-add-miss idx=%d n=%d unit=%d owner=%x",
+	trDemote:         "demote     idx=%d events=%d unit=%d %d",
+	trHotReclaim:     "hot-reclaim idx=%d epoch=%d unit=%d %d",
+	trHotClose:       "hot-close  idx=%d events=%d %d %d",
+	trHotReset:       "hot-reset  slot=%d %d now=%d %d",
+}
+
+// traceDump stops the trace and lists the records naming id (or its
+// wait-room set), oldest first.
+func traceDump(id, set uint64) string {
+	traceStop.Store(true)
+	var recs []traceRec
+	for i := range traceRing {
+		if r := &traceRing[i]; r.seq != 0 && r.run == traceRun.Load() && (r.id == id || r.id == set || r.a == id || r.b == id || r.c == id || r.d == id) {
+			recs = append(recs, *r)
+		}
+	}
+	slices.SortFunc(recs, func(a, b traceRec) int { return int(a.seq) - int(b.seq) })
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "\ntrace of %x (%d records, ring seq %d):\n", id, len(recs), traceSeq.Load())
+	for _, r := range recs {
+		who := "self"
+		if r.id != id {
+			who = fmt.Sprintf("%x", r.id)
+		}
+		fmt.Fprintf(&sb, "  %9d %-6s "+traceNames[r.kind]+"\n", r.seq, who, r.a, r.b, r.c, r.d)
+	}
+	return sb.String()
+}
+
+// traceReset starts a new run: dumps list only its records.
+func traceReset() { traceRun.Add(1) }
