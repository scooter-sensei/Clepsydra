diff --git a/trace_on.go b/trace_on.go
new file mode 100644
index 0000000..7496359
--- /dev/null
+++ b/trace_on.go
@@ -0,0 +1,71 @@
+//go:build tftrace
+
+package temporalfilter
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"sync/atomic"
+)
+
+// Event trace for debugging (go test -tags tftrace): every operation that
+// moves a key's history between the table, the stash and the overflow
+// table is recorded in a ring, and traceDump lists one identity's records.
+// Records are written without synchronization: a torn record can show up
+// garbled, which is fine for a debugging aid; never build this with -race.
+
+const traceOn = true
+
+type traceRec struct{ seq, kind, id, a, b, c, d uint64 }
+
+const traceBits = 23
+
+var (
+	traceRing [1 << traceBits]traceRec
+	traceSeq  atomic.Uint64
+	traceStop atomic.Bool
+)
+
+func tr(kind, id, a, b, c, d uint64) {
+	if traceStop.Load() {
+		return
+	}
+	n := traceSeq.Add(1)
+	traceRing[n&(1<<traceBits-1)] = traceRec{n, kind, id, a, b, c, d}
+}
+
+var traceNames = map[uint64]string{
+	trInstall:    "install   slot=%d old-events=%d new-id=%x old-last=%d",
+	trSweep:      "sweep     slot=%d events=%d last=%d now=%d",
+	trStashPut:   "stash-put events=%d outcome=%d other=%x now=%d",
+	trStashTake:  "stash-take events=%d last=%d now=%d %d",
+	trSpill:      "spill     n=%d last=%d outcome=%d now=%d",
+	trAbandon:    "abandon   extra=%d folded=%d src=%d copy=%d",
+	trReset:      "reset     slot=%d events=%d last=%d now=%d",
+	trGhost:      "ghost-add n=%d outcome=%d bucket=%d now=%d",
+	trRelocated:  "moved     from=%d to=%d events=%d now=%d",
+	trEvictStart: "evict     slot=%d events=%d by=%x now=%d",
+}
+
+// traceDump stops the trace and lists the records naming id, oldest first.
+func traceDump(id uint64) string {
+	traceStop.Store(true)
+	var recs []traceRec
+	for _, r := range traceRing {
+		if r.seq != 0 && (r.id == id || r.kind == trInstall && r.c == id || r.kind == trStashPut && r.c == id) {
+			recs = append(recs, r)
+		}
+	}
+	slices.SortFunc(recs, func(a, b traceRec) int { return int(a.seq) - int(b.seq) })
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "\ntrace of %x (%d records, ring seq %d):\n", id, len(recs), traceSeq.Load())
+	for _, r := range recs {
+		who := "self"
+		if r.id != id {
+			who = fmt.Sprintf("by %x", r.id)
+		}
+		fmt.Fprintf(&sb, "  #%d %s "+traceNames[r.kind]+"\n", r.seq, who, r.a, r.b, r.c, r.d)
+	}
+	return sb.String()
+}
