@@ -0,0 +1,12 @@
+//go:build tfwork
+
+package temporalfilter
+
+// Work counters (NEXT-RESULTS.md N7), with the tfwork build tag: what each
+// call does, counted where it does it. Plain counters: single-goroutine
+// measurements only.
+const workOn = true
+
+var work [nWork]uint64
+
+func workAdd(kind, n int) { work[kind] += uint64(n) }
