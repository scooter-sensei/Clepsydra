@@ -0,0 +1,137 @@
+//go:build tfwork
+
+package temporalfilter
+
+import (
+	"encoding/binary"
+	"fmt"
+	"os"
+	"slices"
+	"testing"
+	"time"
+
+	"github.com/scooter-sensei/clepsydra/go/internal/workload"
+)
+
+// workCalls collects each call's work (NEXT-RESULTS.md N7).
+type workCalls struct {
+	tot        []uint32
+	kmax, ksum [nWork]uint64
+}
+
+func workTotal(d [nWork]uint64) uint64 {
+	return d[workLines] + d[workStash] + d[workGhost] + d[workHot] + (d[workSweep]+7)/8 + d[workDecay]
+}
+
+func (c *workCalls) do(keep bool, fn func()) {
+	before := work
+	fn()
+	if !keep {
+		return
+	}
+	var d [nWork]uint64
+	for k := range d {
+		d[k] = work[k] - before[k]
+		c.kmax[k] = max(c.kmax[k], d[k])
+		c.ksum[k] += d[k]
+	}
+	c.tot = append(c.tot, uint32(min(workTotal(d), 1<<32-1)))
+}
+
+var workKinds = []string{"lines", "stash", "ghost", "hot", "sweep", "decay"}
+
+func (c *workCalls) report(t *testing.T, name string) {
+	s := slices.Clone(c.tot)
+	slices.Sort(s)
+	q := func(p float64) uint32 { return s[int(p*float64(len(s)-1))] }
+	t.Logf("%-22s calls %9d  work p50 %d p99 %d p99.9 %d max %d", name, len(s), q(0.5), q(0.99), q(0.999), s[len(s)-1])
+	line := ""
+	for k, n := range workKinds {
+		line += fmt.Sprintf(" %s %d/%.3f", n, c.kmax[k], float64(c.ksum[k])/float64(len(s)))
+	}
+	t.Logf("%-22s max/mean per kind:%s", "", line)
+}
+
+// TestWork (TF_EXP=1, -tags tfwork) reads every workload of N7's design;
+// -run 'TestWork/<name>' picks one.
+func TestWork(t *testing.T) {
+	if os.Getenv("TF_EXP") == "" {
+		t.Skip("set TF_EXP=1")
+	}
+	for _, c := range []struct {
+		load float64
+		seed uint64
+	}{{1.0, 2}, {1.1, 3}, {1.15, 4}} {
+		t.Run(fmt.Sprintf("churn%.2f", c.load), func(t *testing.T) {
+			f, _ := New(Config{Capacity: 200_000, Horizon: time.Minute, Resolution: time.Millisecond})
+			var wc workCalls
+			workload.Churn(c.load, c.seed, 200_000, 60_000, mix64, func(h, w, now uint64) {
+				wc.do(true, func() { f.CheckAndTouchAt(h, w, now) })
+			})
+			wc.report(t, fmt.Sprintf("churn %.2f", c.load))
+		})
+	}
+	t.Run("heavy16x", func(t *testing.T) {
+		path := os.Getenv("TF_TRACE")
+		if path == "" {
+			t.Skip("TF_TRACE=<heavy16x.trace>")
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		u := func(i int) uint64 { return binary.LittleEndian.Uint64(data[8+8*i:]) }
+		capacity, horizonMs, windowMs, records := u(0), u(2), u(3), u(7)
+		f, _ := New(Config{Capacity: int(capacity), Horizon: time.Duration(horizonMs) * time.Millisecond, Resolution: time.Millisecond})
+		var wc workCalls
+		for r := range records {
+			b := data[128+16*r:]
+			key, tick, n := binary.LittleEndian.Uint64(b), uint64(binary.LittleEndian.Uint32(b[8:])), binary.LittleEndian.Uint32(b[12:])
+			for range n {
+				wc.do(true, func() { f.TouchAt(f.HashUint64(key), windowMs, tick) })
+			}
+		}
+		wc.report(t, "heavy16x (1/4 scale)")
+	})
+	t.Run("sweep", func(t *testing.T) {
+		f, _ := New(Config{Capacity: 1 << 18, Horizon: time.Minute})
+		h := f.Ticks(time.Minute)
+		const keys = 2 << 20
+		span, sl := h*7/2, (h+1)/2
+		var wc workCalls
+		for k := range uint64(keys) {
+			x := mix64(k + 1<<50)
+			now := 1 + span*k/keys
+			for range 4 {
+				wc.do(now >= sl, func() { f.TouchAt(x, h, now) })
+			}
+		}
+		wc.report(t, "sweep (E11)")
+	})
+	for _, bg := range []bool{false, true} {
+		t.Run(fmt.Sprintf("insert-bg=%v", bg), func(t *testing.T) {
+			const capacity = 200_000
+			f, _ := New(Config{Capacity: capacity, Horizon: time.Minute, Background: bg})
+			f.bgManual = bg
+			w := f.Ticks(30 * time.Second)
+			perKey := f.Ticks(time.Minute) / capacity
+			var wc, placer workCalls
+			ctr := uint64(0)
+			for i := range 3 * capacity {
+				ctr++
+				keep := i >= 2*capacity
+				wc.do(keep, func() { f.CheckAndTouchAt(mix64(1<<40+ctr), w, 1000+ctr*perKey) })
+				if bg {
+					placer.do(keep, func() {
+						for f.room.Load() != nil && f.placeNext(f.room.Load(), 0) {
+						}
+					})
+				}
+			}
+			wc.report(t, fmt.Sprintf("insert 85%% bg=%v", bg))
+			if bg {
+				placer.report(t, "  placer, per call")
+			}
+		})
+	}
+}
