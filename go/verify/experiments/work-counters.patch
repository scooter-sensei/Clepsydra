+package temporalfilter
+
+// Kinds of work (work_on.go counts them under the tfwork build tag).
+const (
+	workLines = iota // table lines read
+	workStash        // stash and wait-room sets read
+	workGhost        // overflow-table buckets read or written
+	workHot          // hot entries read or written
+	workSweep        // words the overflow table's advance visits
+	workDecay        // lines decay's sweep visits
+	nWork
+)
