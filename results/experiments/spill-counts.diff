+// locate returns the word index of h's slot, or -1. The alternate line is
+// read only when some entry whose primary line this is lives there, which
+// saves a second cache miss on most absent keys.
+func (f *Filter) locate(h, fp, tg uint64) int {
+	p := f.primary(h)
+	if i := f.find(p, fp, tg); i >= 0 || !f.spilled(p) {
+		return i
+	}
+	return f.find(f.alt(p, fp), fp, tg)
+}
+
+const noLine = ^uint64(0)
+
+// spilled reports whether any entry with primary line l is displaced. Its
+// count is raised before such an entry can be missing from l and lowered
+// only after it is gone, so a miss in l followed by a zero here (both atomic
+// loads, in that order) proves the key absent.
+func (f *Filter) spilled(l uint64) bool {
+	return atomic.LoadUint32(&f.spill[l>>2])>>(l&3*8)&0xff != 0
+}
+
+// addSpill adjusts line l's displaced count by d (+1 or -1); noLine is a
+// no-op. It saturates: a count that reaches 255 stays there (conservative,
+// never wrong).
+func (f *Filter) addSpill(l uint64, d int) {
+	if l == noLine {
+		return
+	}
+	p, sh := &f.spill[l>>2], l&3*8
+	for {
+		old := atomic.LoadUint32(p)
+		c := old >> sh & 0xff
+		if c == 0xff || (d < 0 && c == 0) {
+			return
+		}
+		if atomic.CompareAndSwapUint32(p, old, old+uint32(d)<<sh) {
+			return
+		}
+	}
+}
+
+// removed accounts for an entry w0 that was just taken out of line.
+func (f *Filter) removed(line, w0 uint64) {
+	if w0&dispBit != 0 {
+		f.addSpill(f.alt(line, w0>>48), -1)
+	}
+}
