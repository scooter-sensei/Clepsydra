+package temporalfilter
+
+// hasCAS2 reports CMPXCHG16B support (every x86-64 CPU since ~2006).
+var hasCAS2 = cpuHasCX16()
+
+// cas2 atomically replaces the 16-byte pair at p (16-byte aligned) with
+// new0, new1 if it still holds old0, old1.
+//
+//go:noescape
+func cas2(p *uint64, old0, old1, new0, new1 uint64) bool
+
+func cpuHasCX16() bool
