new file mode 100644
index 0000000..1511e4e
--- /dev/null
+++ b/cas2_amd64.s
@@ -0,0 +1,23 @@
+#include "textflag.h"
+
+// func cas2(p *uint64, old0, old1, new0, new1 uint64) bool
+TEXT ·cas2(SB), NOSPLIT, $0-41
+	MOVQ p+0(FP), DI
+	MOVQ old0+8(FP), AX
+	MOVQ old1+16(FP), DX
+	MOVQ new0+24(FP), BX
+	MOVQ new1+32(FP), CX
+	LOCK
+	CMPXCHG16B (DI)
+	SETEQ ret+40(FP)
+	RET
+
+// func cpuHasCX16() bool
+TEXT ·cpuHasCX16(SB), NOSPLIT, $0-1
+	MOVL $1, AX
+	XORL CX, CX
+	CPUID
+	SHRL $13, CX
+	ANDL $1, CX
+	MOVB CX, ret+0(FP)
+	RET
diff --git a/cas2_bench_amd64_test.go b/cas2_bench_amd64_test.go
new file mode 100644
index 0000000..6c2a10c
--- /dev/null
+++ b/cas2_bench_amd64_test.go
@@ -0,0 +1,28 @@
+package temporalfilter
+
+import (
+	"sync/atomic"
+	"testing"
+)
+
+// Microbenchmark from the experiment: two 8-byte CASes (one per slot word)
+// versus one CMPXCHG16B over both, on one uncontended cache-resident slot.
+
+func BenchmarkZZTwoCAS(b *testing.B) {
+	p := alignedWords(8)
+	for i := 0; i < b.N; i++ {
+		w0 := atomic.LoadUint64(&p[0])
+		atomic.CompareAndSwapUint64(&p[0], w0, w0+1)
+		w1 := atomic.LoadUint64(&p[1])
+		atomic.CompareAndSwapUint64(&p[1], w1, w1+1)
+	}
+}
+
+func BenchmarkZZCAS2(b *testing.B) {
+	p := alignedWords(8)
+	for i := 0; i < b.N; i++ {
+		w0 := atomic.LoadUint64(&p[0])
+		w1 := atomic.LoadUint64(&p[1])
+		cas2(&p[0], w0, w1, w0+1, w1+1)
+	}
+}
