+// TestCTProfile times ConstantTime-mode operations for each pad, with and
+// without shadow work (each path also runs the other path's work,
+// read-only), on a 2M-key table at 85%: seen and unseen probes in random
+// order, each timed alone (TF_CTEXP=1). "Right" is the best single-timing
+// guess, (1+D)/2; cpu is the mean wall time per call (single goroutine).
+func TestCTProfile(t *testing.T) {
+	if os.Getenv("TF_CTEXP") == "" {
+		t.Skip("set TF_CTEXP=1")
+	}
+	const capacity, probes = 1 << 21, 40_000
+	now := uint64(1)
+	f, err := New(Config{Capacity: capacity, Horizon: time.Minute, Resolution: time.Millisecond,
+		Clock: func() uint64 { return now }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rng := rand.New(rand.NewPCG(3, 4))
+	seen := make([]uint64, capacity)
+	for i := range seen {
+		seen[i] = f.HashUint64(rng.Uint64())
+		f.TouchAt(seen[i], 0, now)
+	}
+	now += 1000
+	pads := []time.Duration{time.Nanosecond, 500 * time.Nanosecond, time.Microsecond, 1500 * time.Nanosecond, 3 * time.Microsecond}
+	for _, sh := range []bool{false, true} {
+		for _, pad := range pads {
+			line := ""
+			for _, op := range []string{"Count", "Touch"} {
+				f.ct, f.pad, f.shadow = true, pad, sh
+				kind := make([]int, probes)
+				hs := make([]uint64, probes)
+				for i := range hs {
+					kind[i] = rng.IntN(2)
+					hs[i] = f.HashUint64(rng.Uint64())
+					if kind[i] == 1 {
+						hs[i] = seen[rng.IntN(len(seen))]
+					}
+				}
+				var ts [2][]float64
+				start := time.Now()
+				for i, h := range hs {
+					t0 := time.Now()
+					if op == "Count" {
+						f.CountAt(h, 60_000, now)
+					} else {
+						f.TouchAt(h, 60_000, now)
+					}
+					ts[kind[i]] = append(ts[kind[i]], float64(time.Since(t0).Nanoseconds()))
+				}
+				cpu := float64(time.Since(start).Nanoseconds()) / probes
+				slices.Sort(ts[0])
+				slices.Sort(ts[1])
+				q := func(x []float64, p float64) float64 { return x[int(p*float64(len(x)-1))] }
+				d := ks(ts[0], ts[1])
+				line += fmt.Sprintf(" | %s D %.3f (%4.1f%%) p50 %5.0f/%5.0f p99 %5.0f/%5.0f ns, %5.0f ns/op", op, d, 50+50*d, q(ts[0], .5), q(ts[1], .5), q(ts[0], .99), q(ts[1], .99), cpu)
+				f.ct = false
+			}
+			t.Logf("shadow %-5v pad %-6v%s", sh, pad, line)
+		}
+	}
+	t.Logf("p50 and p99 are unseen/seen")
+}
