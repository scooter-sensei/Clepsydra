+// shadowSink keeps shadow work from being optimized away.
+var shadowSink atomic.Uint64
+
+// shadowEstimate does the work of reading a live key's count, on a live
+// neighbour in h's primary line, and discards it: an unseen key's Count
+// then costs what a seen key's does.
+func (f *Filter) shadowEstimate(h, window, now uint64) {
+	base := int(f.primary(h) * wordsPerLine)
+	for s := 0; s < wordsPerLine; s += 2 {
+		w0 := atomic.LoadUint64(&f.words[base+s])
+		if w0 != 0 && age(now, w0&tsMask) <= f.horizon {
+			r := f.estimate(atomic.LoadUint64(&f.words[base+s+1]), w0&tsMask, now, window, w0&satBit != 0)
+			if r.Count == -1 {
+				shadowSink.Add(1)
+			}
+			return
+		}
+	}
+}
+
+// claimProbe walks the search claim would make to insert h, reading the
+// same lines and writing nothing: a seen key's Touch then does an unseen
+// one's work.
+func (f *Filter) claimProbe(h, fp, now uint64) bool {
+	lines := [2]uint64{f.primary(h), f.alt(f.primary(h), fp)}
+	for _, line := range lines {
+		base := int(line * wordsPerLine)
+		for s := 0; s < wordsPerLine; s += 2 {
+			w0 := atomic.LoadUint64(&f.words[base+s])
+			if w0 == 0 || age(now, w0&tsMask) > f.horizon {
+				return true
+			}
+		}
+	}
+	p := f.pressure.Load()
+	budget := 8 + int(uint64(relocBudget-8)*(pressureOne-uint64(p))>>pressureShift)
+	for depth := 0; depth <= relocDepth; depth++ {
+		for _, line := range lines {
+			base := int(line * wordsPerLine)
+			for s := 0; s < wordsPerLine; s += 2 {
+				if f.relocProbe(base+s, line, now, depth, &budget) {
+					return true
+				}
+			}
+		}
+	}
+	var m uint64
+	for _, line := range lines {
+		base := int(line * wordsPerLine)
+		for s := 0; s < wordsPerLine; s += 2 {
+			w0 := atomic.LoadUint64(&f.words[base+s])
+			m += f.mass(atomic.LoadUint64(&f.words[base+s+1]), w0&tsMask, now)
+		}
+	}
+	if m == 1<<63 {
+		shadowSink.Add(1)
+	}
+	return false
+}
+
+// relocProbe is relocate's search without the moves.
+func (f *Filter) relocProbe(i int, line, now uint64, depth int, budget *int) bool {
+	w0 := atomic.LoadUint64(&f.words[i])
+	if w0 == 0 || *budget <= 0 {
+		return false
+	}
+	*budget--
+	a := f.alt(line, w0>>48)
+	base := int(a * wordsPerLine)
+	for s := 0; s < wordsPerLine; s += 2 {
+		d0 := atomic.LoadUint64(&f.words[base+s])
+		if d0 == 0 || age(now, d0&tsMask) > f.horizon {
+			return true
+		}
+	}
+	if depth > 0 {
+		for s := 0; s < wordsPerLine; s += 2 {
+			if f.relocProbe(base+s, a, now, depth-1, budget) {
+				return true
+			}
+		}
+	}
+	return false
+}
