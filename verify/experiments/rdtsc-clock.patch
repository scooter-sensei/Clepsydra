+// Package clockbench holds the clock microbenchmarks behind the backlog's
+// "raw RDTSC clock" entry: time.Since and runtime.nanotime versus a bare
+// RDTSC, alone and next to a dependent cache miss. Benchmarks only; nothing
+// here is used by the filter.
+//
+//	go test -run '^$' -bench . -count 2 ./internal/clockbench
+package clockbench
