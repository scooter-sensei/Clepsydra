diff --git a/internal/clockbench/clk_test.go b/internal/clockbench/clk_test.go
new file mode 100644
index 0000000..c512baa
--- /dev/null
+++ b/internal/clockbench/clk_test.go
@@ -0,0 +1,65 @@
+package clockbench
+
+import (
+	"hash/maphash"
+	"sync"
+	"testing"
+	"time"
+	_ "unsafe"
+)
+
+//go:linkname nanotime runtime.nanotime
+func nanotime() int64
+
+var sink int64
+
+func BenchmarkTimeSince(b *testing.B) {
+	base := time.Now()
+	for i := 0; i < b.N; i++ {
+		sink += int64(time.Since(base))
+	}
+}
+
+func BenchmarkNanotime(b *testing.B) {
+	for i := 0; i < b.N; i++ {
+		sink += nanotime()
+	}
+}
+
+func BenchmarkMaphashString(b *testing.B) {
+	seed := maphash.MakeSeed()
+	for i := 0; i < b.N; i++ {
+		sink += int64(maphash.String(seed, "user-12345678"))
+	}
+}
+
+// table is 256 MB, allocated on first use so plain test runs don't pay for it.
+var (
+	tableOnce sync.Once
+	table     []uint64
+)
+
+func missTable() []uint64 {
+	tableOnce.Do(func() { table = make([]uint64, 1<<25) })
+	return table
+}
+
+func BenchmarkMissNanotime(b *testing.B) {
+	table := missTable()
+	x := uint64(1)
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		x = x*6364136223846793005 + 1442695040888963407
+		sink += int64(table[x>>39]) + nanotime()
+	}
+}
+
+func BenchmarkMissNoClock(b *testing.B) {
+	table := missTable()
+	x := uint64(1)
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		x = x*6364136223846793005 + 1442695040888963407
+		sink += int64(table[x>>39])
+	}
+}
