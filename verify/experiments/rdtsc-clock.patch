+package clockbench
+
+// rdtsc returns the raw time-stamp counter (unserialized RDTSC).
+func rdtsc() uint64
diff --git a/internal/clockbench/tsc_amd64.s b/internal/clockbench/tsc_amd64.s
new file mode 100644
index 0000000..3f3d0f0
--- /dev/null
+++ b/internal/clockbench/tsc_amd64.s
@@ -0,0 +1,9 @@
+#include "textflag.h"
+
+// func rdtsc() uint64
+TEXT ·rdtsc(SB), NOSPLIT, $0-8
+	RDTSC
+	SHLQ $32, DX
+	ORQ DX, AX
+	MOVQ AX, ret+0(FP)
+	RET
