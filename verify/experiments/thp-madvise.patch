+	align := wordsPerLine * 8 // bytes per bucket
+	if n*8 >= hugeMin {
+		align = hugePage // so the table starts on a huge page
+	}
+	buf := make([]uint64, n+align/8)
+	off := int((uintptr(align)-uintptr(unsafe.Pointer(&buf[0]))%uintptr(align))%uintptr(align)) / 8
+	w := buf[off : off+n : off+n]
+	if n*8 >= hugeMin {
+		adviseHuge(w)
+	}
+	return w
