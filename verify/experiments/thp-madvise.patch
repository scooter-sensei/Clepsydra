@@ -0,0 +1,28 @@
+package temporalfilter
+
+import (
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+// Was the madvise honoured? Builds a ~300 MB table, fills 4M keys, and logs
+// the process's Rss and AnonHugePages (they should roughly match the table).
+// Depends on the host's THP setting (/sys/kernel/mm/transparent_hugepage).
+func TestZZTHP(t *testing.T) {
+	if testing.Short() {
+		t.Skip("allocates a ~300 MB table")
+	}
+	f, _ := New(Config{Capacity: 1 << 24, Horizon: time.Minute})
+	for i := range uint64(1 << 22) {
+		f.CheckAndTouchAt(HashUint64(i), 0, 1000)
+	}
+	b, _ := os.ReadFile("/proc/self/smaps_rollup")
+	for _, l := range strings.Split(string(b), "\n") {
+		if strings.Contains(l, "AnonHuge") || strings.HasPrefix(l, "Rss") {
+			t.Log(l)
+		}
+	}
+	t.Logf("table %d MB", len(f.words)*8>>20)
+}
