diff --git a/huge_linux.go b/huge_linux.go
new file mode 100644
index 0000000..4e9c328
--- /dev/null
+++ b/huge_linux.go
@@ -0,0 +1,13 @@
+package temporalfilter
+
+import (
+	"syscall"
+	"unsafe"
+)
+
+// adviseHuge asks for transparent huge pages behind w. Best effort: with THP
+// off, or a kernel that refuses, the table just uses normal pages.
+func adviseHuge(w []uint64) {
+	b := unsafe.Slice((*byte)(unsafe.Pointer(&w[0])), len(w)*8)
+	_ = syscall.Madvise(b[:len(b)/hugePage*hugePage], 14) // MADV_HUGEPAGE
+}
